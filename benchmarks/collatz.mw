@import("std/mem.mw")
@import("std/io.mw")

@export fn main(argc: i32, argv: rawptr) -> i32 {
    var best: i64 = 0;
    var best_len: i64 = 0;
    for var start: i64 = 1; start < 1000000; start += 1 {
        var x: i64 = start;
        var len: i64 = 1;
        while x != 1 {
            if x % 2 == 0 { x = x / 2; } else { x = 3 * x + 1; }
            len += 1;
        }
        if len > best_len {
            best_len = len;
            best = start;
        }
    }
    println_i64(best);
    println_i64(best_len);
    ret 0;
}
