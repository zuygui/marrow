@import("std/std.mw")

// The syntax of the memory model. For now every pointer kind is a plain pointer: the
// ownership and borrowing rules come later, so these programs only have to parse and run.

@copy
struct Pair { a: i64; b: i64; }

fn bump(p: &mut i64) { *p += 1; }
fn read(p: &i64) -> i64 { ret *p; }
fn owned(p: ^i64) -> i64 { ret *p + 100; }
fn twice(p: && i64) -> i64 { ret **p * 2; }

@export fn main(argc: i32, argv: rawptr) -> i32 {
    var n: i64 = 1;
    bump(&mut n);
    println_i64(read(&n));
    var r: *i64 = raw n;
    unsafe { *r = 5; }
    println_i64(read(raw n));
    println_i64(owned(raw n));
    var pn: &i64 = &n;
    println_i64(twice(&pn));
    var m: i64 = move n;
    println_i64(m);
    var pair: Pair = Pair { a: 1, b: 2 };
    println_i64(pair.a + pair.b);
    ret 0;
}
