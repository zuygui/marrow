@import("std/std.mw")
struct Pair { a: i64; b: i64; }
// Locals declared inside loops must reuse one stack slot per declaration.
@export fn main(argc: i32, argv: rawptr) -> i32 {
    var i: i64 = 0;
    var sum: i64 = 0;
    while i < 20000000 {
        var p: Pair = Pair { a: i, b: 1 };
        var x: i64 = p.a & 1;
        sum = sum + x + p.b;
        i = i + 1;
    }
    println_i64(sum);
    ret 0;
}
