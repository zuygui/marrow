@import("std/task.mw")
@import("std/io.mw")

var ORDER: i64 = 0;

fn worker(arg: rawptr) -> i64 {
    var id: i64 = cast(i64) arg;
    var i: i64 = 0;
    while i < 3 {
        println_i64(id * 10 + i);
        task_yield();
        i = i + 1;
    }
    ret id * 100;
}

// The sleepers only record when they woke up: printing from them would make the
// output depend on how fast the machine runs the other tasks in the meantime.
var WOKE: i64 = 0;
var WOKE_AT: i64 = 0;

fn sleeper(arg: rawptr) -> i64 {
    task_sleep_ms(cast(i64) arg);
    WOKE = WOKE * 1000 + cast(i64) arg;
    WOKE_AT = WOKE_AT + 1;
    ret 0;
}

var CH: i64 = 0;

fn producer(arg: rawptr) -> i64 {
    var c: *Chan = cast(*Chan) CH;
    var i: i64 = 1;
    while i <= 5 {
        chan_send(c, i);
        i = i + 1;
    }
    chan_close(c);
    ret 0;
}

fn consumer(arg: rawptr) -> i64 {
    var c: *Chan = cast(*Chan) CH;
    var out: i64 = 0;
    var sum: i64 = 0;
    while chan_recv(c, raw out) == 0 {
        sum = sum + out;
    }
    println_i64(sum);
    ret sum;
}

@export fn main(argc: i32, argv: rawptr) -> i32 {
    var a: *Task = task_spawn(worker, cast(rawptr) 1);
    var b: *Task = task_spawn(worker, cast(rawptr) 2);
    var s1: *Task = task_spawn(sleeper, cast(rawptr) 150);
    var s2: *Task = task_spawn(sleeper, cast(rawptr) 10);
    CH = cast(i64) chan_new(2);
    var p: *Task = task_spawn(producer, null);
    var c: *Task = task_spawn(consumer, null);
    task_run();
    println_i64(task_join(a) + task_join(b));
    println_i64(task_join(c));
    println_i64(WOKE_AT);
    println_i64(WOKE);
    ret 0;
}
