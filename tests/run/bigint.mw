@import("std/std.mw")
@import("std/bigint.mw")
@import("std/encoding.mw")
fn pattern(n: i64, seed: i64) -> *u8 {
    var p: *u8 = alloc(n + 1);
    var i: i64 = 0;
    while i < n { p[i] = cast(u8) ((i * 31 + seed * 17 + (i * i * seed) / 5 + 1) & 255); i = i + 1; }
    p[0] = p[0] | 1; // keep the leading byte nonzero
    ret p;
}
@trusted fn big(n: i64, seed: i64) -> *Big { var p: *u8 = pattern(n, seed); var b: *Big = big_from_bytes(p, n); dealloc(p); ret b; }
fn show(b: *Big, width: i64) { var buf: *u8 = alloc(width); var h: *u8 = alloc(width * 2 + 1); if !big_to_bytes(b, buf, width) { println("OVERFLOW"); ret; } var l: i64 = hex_encode(buf, width, h); h[l] = 0; println(h); }
@export fn main(argc: i32, argv: rawptr) -> i32 {
    var sizes: *i64 = alloc(80);
    sizes[0] = 1; sizes[1] = 4; sizes[2] = 7; sizes[3] = 32; sizes[4] = 33; sizes[5] = 64; sizes[6] = 129; sizes[7] = 256;
    var si: i64 = 0;
    while si < 8 {
        var n: i64 = sizes[si];
        var a: *Big = big(n, 1);
        var b: *Big = big(n, 2);
        var m: *Big = big((n + 1) / 2 + 1, 3);
        var s: *Big = big_add(a, b); show(s, n + 1);
        var hi: *Big = a; var lo: *Big = b;
        if big_cmp(a, b) < 0 { hi = b; lo = a; }
        var d: *Big = big_sub(hi, lo); show(d, n);
        var p: *Big = big_mul(a, b); show(p, n * 2);
        var r: *Big = big_mod(p, m); show(r, m.n * 4);
        var e: *Big = big(3, 4);
        var x: *Big = big_modexp(a, e, m); show(x, m.n * 4);
        println_i64(big_cmp(a, b));
        println_i64(big_bits(a));
        si = si + 1;
    }
    // RSA-style public exponent, 1024 bit modulus
    var mod: *Big = big(128, 9);
    mod.d[0] = mod.d[0] | 1;
    var base: *Big = big(100, 8);
    var f4: *Big = big_from_u64(65537);
    var res: *Big = big_modexp(base, f4, mod); show(res, 128);
    // modular inverse with the P-256 prime
    var pr: *u8 = alloc(32);
    hex_decode("ffffffff00000001000000000000000000000000ffffffffffffffffffffffff", 64, pr);
    var P: *Big = big_from_bytes(pr, 32);
    var v: *Big = big(31, 6);
    var inv: *Big = big_modinv_prime(v, P); show(inv, 32);
    var chk: *Big = big_modmul(v, inv, P); show(chk, 32);
    ret 0;
}
