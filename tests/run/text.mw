var FAILS: i64 = 0;
fn pf(s: *u8, want: f64, id: i64) {
    var got: f64 = 0.0;
    if !parse_f64(s, raw got) { FAILS = FAILS + 1; print("parse_f64 rejected "); println(s); ret; }
    var d: f64 = got - want;
    if d < 0.0 { d = 0.0 - d; }
    var sc: f64 = want;
    if sc < 0.0 { sc = 0.0 - sc; }
    if d > sc * 0.000000000000004 { FAILS = FAILS + 1; print("parse_f64 "); print(s); print(" got "); print_f64(got, 17); print(" want "); println_f64(want, 17); }
}
fn pi(s: *u8, want: i64, id: i64) {
    var got: i64 = 0;
    if !parse_i64(s, raw got) || got != want { FAILS = FAILS + 1; print("parse_i64 "); println(s); }
}
fn bad_i(s: *u8, id: i64) {
    var got: i64 = 0;
    if parse_i64(s, raw got) { FAILS = FAILS + 1; print("parse_i64 accepted "); println(s); }
}
fn bad_f(s: *u8, id: i64) {
    var got: f64 = 0.0;
    if parse_f64(s, raw got) { FAILS = FAILS + 1; print("parse_f64 accepted "); println(s); }
}
