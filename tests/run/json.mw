@import("std/std.mw")
@import("std/json.mw")
fn t(text: *u8) {
    var v: *Json = json_parse_str(text);
    if v == null { println("err"); ret; }
    var s: *u8 = json_stringify(v, false);
    print("ok "); println(s);
    // the output must parse back to the same text
    var v2: *Json = json_parse_str(s);
    if v2 == null { println("REPARSE FAILED"); }
    else {
        var s2: *u8 = json_stringify(v2, false);
        if str_cmp(s, s2) != 0 { println("ROUNDTRIP MISMATCH"); }
        dealloc(s2);
        json_free(v2);
    }
    dealloc(s);
    json_free(v);
}
