}
fn pattern(n: i64) -> *u8 {
    var p: *u8 = alloc(n + 1);
    var i: i64 = 0;
    while i < n { p[i] = cast(u8) ((i * 7 + 3) & 255); i = i + 1; }
    ret p;
}
