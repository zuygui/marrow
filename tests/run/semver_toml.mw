@import("std/std.mw")
@import("compiler/semver.mw")
@import("compiler/toml.mw")

var FAILED: i64 = 0;

fn expect(cond: bool, what: *u8) {
    if !cond { eprintln(cat2("FAIL: ", what)); FAILED += 1; }
}

@unsafe fn m(req: *u8, ver: *u8) -> bool {
    var err: *u8 = null;
    var r: *Req = req_parse(req, raw err);
    if r == null { eprintln(cat2("bad requirement ", req)); FAILED += 1; ret false; }
    var v: *Version = ver_parse(ver);
    if v == null { eprintln(cat2("bad version ", ver)); FAILED += 1; ret false; }
    ret req_matches(r, v);
}

@export @unsafe fn main(argc: i32, argv: rawptr) -> i32 {
    // versions
    var a: *Version = ver_parse("1.2.3");
    expect(a != null && a.major == 1 && a.minor == 2 && a.patch == 3, "parse 1.2.3");
    expect(ver_parse("1.2") == null && ver_parse("x") == null && ver_parse("1.2.3.4") == null, "reject bad versions");
    expect(ver_cmp(ver_parse("1.2.3"), ver_parse("1.10.0")) < 0, "1.2.3 < 1.10.0");
    expect(ver_cmp(ver_parse("2.0.0"), ver_parse("1.99.99")) > 0, "2.0.0 > 1.99.99");
    expect(ver_cmp(ver_parse("1.0.0-beta"), ver_parse("1.0.0")) < 0, "pre-release sorts first");
    expect(str_eq(ver_str(ver_parse("0.3.0")), "0.3.0") == 1, "ver_str");

    // requirements
    expect(m("^1.2.3", "1.2.3") && m("^1.2.3", "1.9.0") && !m("^1.2.3", "2.0.0") && !m("^1.2.3", "1.2.2"), "caret");
    expect(m("1.2", "1.4.0") && !m("1.2", "1.1.9") && !m("1.2", "2.0.0"), "bare is caret");
    expect(m("^0.2.3", "0.2.9") && !m("^0.2.3", "0.3.0"), "caret 0.x");
    expect(m("^0.0.3", "0.0.3") && !m("^0.0.3", "0.0.4"), "caret 0.0.x");
    expect(m("~1.2.3", "1.2.9") && !m("~1.2.3", "1.3.0"), "tilde");
    expect(m("~1", "1.9.9") && !m("~1", "2.0.0"), "tilde major");
    expect(m("=1.2.3", "1.2.3") && !m("=1.2.3", "1.2.4"), "exact");
    expect(m(">=1.0.0, <2.0.0", "1.5.0") && !m(">=1.0.0, <2.0.0", "2.0.0"), "range");
    expect(m(">1.2", "1.3.0") && !m(">1.2", "1.2.9"), "greater, partial");
    expect(m("<=1.2", "1.2.9") && !m("<=1.2", "1.3.0"), "at most, partial");
    expect(m("*", "9.9.9") && m("", "0.0.1"), "any");
    expect(!m("^1.0.0", "1.1.0-beta") && m("^1.0.0-beta", "1.1.0-beta"), "pre-releases are opt-in");
    var err: *u8 = null;
    expect(req_parse("^x", raw err) == null && err != null, "bad requirement is an error");

    // toml
    var src: *u8 = "# a manifest\n[package]\nname = \"demo\"  # trailing comment\nversion = \"0.1.0\"\ncount = 42\nflag = true\n\n[dependencies]\njson = \"^1.2\"\nlocal = { path = \"../local\", tag = 'v1' }\nlist = [\"a\", \"b\",\n  \"c\",]\n\n[[version]]\nversion = \"1.0.0\"\n[[version]]\nversion = \"1.1.0\"\ntag = \"v1.1.0\"\n\n[a.b]\nx = \"deep\\n\\\"q\\\"\"\n";
    var terr: *u8 = null;
    var t: *TTable = toml_parse(src, raw terr);
    expect(t != null, "toml parses");
    if t != null {
        var pkg: *TTable = tt_table(t, "package");
        expect(pkg != null && str_eq(tt_str(pkg, "name"), "demo") == 1, "string value");
        expect(tt_get(pkg, "count").n == 42 && tt_get(pkg, "flag").n == 1, "int and bool");
        var deps: *TTable = tt_table(t, "dependencies");
        expect(str_eq(tt_str(deps, "json"), "^1.2") == 1, "dependency string");
        var loc: *TTable = tt_table(deps, "local");
        expect(loc != null && str_eq(tt_str(loc, "path"), "../local") == 1 && str_eq(tt_str(loc, "tag"), "v1") == 1, "inline table");
        expect(vec_ptr_len(tt_array(deps, "list")) == 3, "multi-line array");
        var vers: *VecPtr = tt_array(t, "version");
        expect(vers != null && vec_ptr_len(vers) == 2, "array of tables");
        var second: *TVal = cast(*TVal) vec_ptr_get(vers, 1);
        expect(str_eq(tt_str(second.tbl, "tag"), "v1.1.0") == 1, "second table of the array");
        var ab: *TTable = tt_table(tt_table(t, "a"), "b");
        expect(ab != null && str_eq(tt_str(ab, "x"), "deep\n\"q\"") == 1, "dotted header and escapes");
    }
    expect(toml_parse("a = \n", raw terr) == null && terr != null, "missing value is an error");
    expect(toml_parse("a = 1\na = 2\n", raw terr) == null, "duplicate key is an error");
    expect(toml_parse("[x\n", raw terr) == null, "unclosed header is an error");
    expect(toml_parse("a = \"open\n", raw terr) == null, "unterminated string is an error");

    if FAILED > 0 { ret 1; }
    println("semver and toml ok");
    ret 0;
}
