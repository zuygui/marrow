@import("std/std.mw")

fn sign(x: i64) -> i64 { ret if x < 0 { -1 } else if x == 0 { 0 } else { 1 }; }
fn pick(c: bool, a: u8, b: u8) -> u8 { ret if c { a } else { b }; }
fn name(n: i64) -> *u8 { ret if n == 1 { "one" } else { "many" }; }
fn half(x: f64) -> f64 { ret if x > 1.0 { x / 2.0 } else { x }; }
@trusted fn bump(p: *i64) -> i64 { *p += 1; ret *p; }

@export @trusted fn main(argc: i32, argv: rawptr) -> i32 {
    println_i64(sign(-5)); println_i64(sign(0)); println_i64(sign(9));
    println_i64(cast(i64) pick(true, 7, 9)); println_i64(cast(i64) pick(false, 7, 9));
    println(name(1)); println(name(2));
    println_f64(half(5.0), 1);
    var x: i64 = 10;
    var y: i64 = (if x > 5 { x } else { 0 }) + 1;
    println_i64(y);
    // only the chosen branch runs
    var n: i64 = 0;
    var z: i64 = if true { bump(raw n) } else { bump(raw n) + 100 };
    println_i64(z); println_i64(n);
    var i: i64 = 0;
    var acc: i64 = 0;
    while i < 4 { acc += if i % 2 == 0 { i } else { 0 }; i += 1; }
    println_i64(acc);
    ret 0;
}
