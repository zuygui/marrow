@import("std/std.mw")
@import("std/rsa.mw")
@import("std/encoding.mw")
fn hexbuf(s: *u8, n: i64) -> *u8 { var b: *u8 = alloc(n / 2 + 1); hex_decode(s, n, b); ret b; }
fn strlen_(s: *u8) -> i64 { var n: i64 = 0; while s[n] != 0 { n = n + 1; } ret n; }
fn check(alg: i64, n: *u8, nlen: i64, e: *u8, elen: i64, d: *u8, s: *u8, slen: i64, pss: i64) {
    var nb: *u8 = hexbuf(n, nlen * 2);
    var eb: *u8 = hexbuf(e, elen * 2);
    var db: *u8 = hexbuf(d, strlen_(d));
    var sb: *u8 = hexbuf(s, slen * 2);
    var hs: i64 = hash_size(alg);
    var good: bool = false;
    var tampered: bool = true;
    var wrong: bool = true;
    if pss == 1 { good = rsa_verify_pss(nb, nlen, eb, elen, alg, db, hs, sb, slen); }
    else { good = rsa_verify_pkcs1(nb, nlen, eb, elen, alg, db, sb, slen); }
    sb[slen - 1] = sb[slen - 1] ^ 1;
    if pss == 1 { tampered = rsa_verify_pss(nb, nlen, eb, elen, alg, db, hs, sb, slen); }
    else { tampered = rsa_verify_pkcs1(nb, nlen, eb, elen, alg, db, sb, slen); }
    sb[slen - 1] = sb[slen - 1] ^ 1;
    db[0] = db[0] ^ 1;
    if pss == 1 { wrong = rsa_verify_pss(nb, nlen, eb, elen, alg, db, hs, sb, slen); }
    else { wrong = rsa_verify_pkcs1(nb, nlen, eb, elen, alg, db, sb, slen); }
    print("alg "); print_i64(alg); print(" bits "); print_i64(nlen * 8); print(" pss "); print_i64(pss);
    print(" good "); print_i64(cast(i64) good); print(" tampered "); print_i64(cast(i64) tampered); print(" wrong "); println_i64(cast(i64) wrong);
}
