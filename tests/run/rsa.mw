    check(2, "", 256, "010001", 3, "1822104b0db6185d57af1fbb685bb5189410d60d11e611e15d287214696b8564", "", 256, 0);
    check(2, "", 256, "010001", 3, "1822104b0db6185d57af1fbb685bb5189410d60d11e611e15d287214696b8564", "", 256, 1);
    check(3, "", 256, "010001", 3, "c47bd546c06bd1215b6fceb4bba36004c059837328abdb296a9a041ba0fe0e1826d21d6bcfe59c1074ea12db21febced", "", 256, 0);
    check(3, "", 256, "010001", 3, "c47bd546c06bd1215b6fceb4bba36004c059837328abdb296a9a041ba0fe0e1826d21d6bcfe59c1074ea12db21febced", "", 256, 1);
