@import("std/std.mw")
@import("std/time.mw")
@import("std/rand.mw")

fn check(cond: bool, code: i32) {
    if !cond { print("check failed: "); println_i64(code); exit(code); }
}

@export fn main(argc: i32, argv: rawptr) -> i32 {
    var dt: DateTime = datetime_from_unix(1700000000);
    check(dt.year == 2023 && dt.month == 11 && dt.day == 14, 1);
    check(dt.hour == 22 && dt.minute == 13 && dt.second == 20, 2);
    check(dt.weekday == 2, 3);
    check(datetime_to_unix(dt) == 1700000000, 4);
    var leap: DateTime = datetime_from_unix(951782400);
    check(leap.year == 2000 && leap.month == 2 && leap.day == 29, 5);
    var neg: DateTime = datetime_from_unix(-1);
    check(neg.year == 1969 && neg.month == 12 && neg.day == 31 && neg.second == 59, 6);
    var buf: *u8 = alloc(32);
    var n: i64 = datetime_format_iso(buf, dt);
    buf[n] = 0;
    check(str_eq(buf, "2023-11-14T22:13:20Z") == 1, 7);
    check(days_in_month(2024, 2) == 29 && days_in_month(1900, 2) == 28, 8);

    var t0: i64 = time_mono_ns();
    sleep_ms(30);
    var dt_ns: i64 = time_mono_ns() - t0;
    check(dt_ns >= 25000000 && dt_ns < 2000000000, 9);
    check(time_unix() > 1700000000, 10);

    var a: Rng = rng_seeded(42);
    var b: Rng = rng_seeded(42);
    var same: bool = true;
    var i: i64 = 0;
    while i < 100 {
        if rng_next(&a) != rng_next(&b) { same = false; }
        i = i + 1;
    }
    check(same, 11);
    var r: Rng = rng_new();
    var sum: f64 = 0.0;
    i = 0;
    while i < 20000 {
        var f: f64 = rng_f64(&r);
        check(f >= 0.0 && f < 1.0, 12);
        sum = sum + f;
        var k: i64 = rng_range(&r, -5, 5);
        check(k >= -5 && k <= 5, 13);
        i = i + 1;
    }
    var mean: f64 = sum / 20000.0;
    check(mean > 0.48 && mean < 0.52, 14);
    var z: u64 = rng_next(&r) | rng_next(&r);
    check(random_u64() != random_u64(), 15);
    println("time/rand ok");
    ret 0;
}
