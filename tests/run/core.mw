@import("std/std.mw")

fn check(cond: bool, code: i32) {
    if !cond {
        eprintln("check failed");
        print_i64(code);
        exit(code);
    }
}

@export fn main(argc: i32, argv: rawptr) -> i32 {
    // --- strings
    var s: *String = string_from("hello");
    string_push_str(s, ", world");
    string_push_char(s, 33);
    check(s.len == 13, 1);
    check(str_eq(s.data, "hello, world!") == 1, 2);
    var t: *String = string_from("hello, world!");
    check(string_eq(s, t) == 1, 3);
    check(string_cmp(s, string_from("hello")) > 0, 4);

    // --- vec / map
    var v: *VecI64 = vec_i64_new(2);
    var i: i64 = 0;
    while i < 1000 {
        vec_i64_push(v, i * 3);
        i = i + 1;
    }
    check(vec_i64_get(v, 999) == 2997, 5);

    // --- files
    var path: *u8 = "core_test.tmp";
    var data: *String = string_from("line one\nline two\n");
    check(write_string_to_file(path, data) == 1, 6);
    check(file_exists(path) == 1, 7);
    var back: *String = read_to_string(path);
    check(back != 0, 8);
    check(back.len == 18, 9);
    check(string_eq(back, data) == 1, 10);
    var h: rawptr = file_open_append(path);
    file_write(h, "more\n", 5);
    file_close(h);
    var back2: *String = read_to_string(path);
    check(back2.len == 23, 11);
    check(file_remove(path) == 1, 12);
    check(file_exists(path) == 0, 13);

    // --- big file (exercises buffer growth)
    var big: *String = string_new(16);
    var k: i64 = 0;
    while k < 20000 {
        string_push_str(big, "0123456789");
        k = k + 1;
    }
    check(write_string_to_file("core_big.tmp", big) == 1, 14);
    var bigback: *String = read_to_string("core_big.tmp");
    check(bigback.len == 200000, 15);
    file_remove("core_big.tmp");

    // --- processes
    check(exec("exit 3") == 3, 16);
    check(exec("true") == 0, 17);
    println("core ok");
    ret 0;
}
