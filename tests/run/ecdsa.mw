@import("std/ecdsa.mw")
fn hexbuf(s: *u8, n: i64) -> *u8 { var b: *u8 = alloc(n / 2 + 1); hex_decode(s, n, b); ret b; }
@trusted fn check(cid: i64, pub: *u8, publen: i64, d: *u8, dlen: i64, s: *u8, slen: i64) {
    var pb: *u8 = hexbuf(pub, publen * 2);
    var db: *u8 = hexbuf(d, dlen * 2);
    var sb: *u8 = hexbuf(s, slen * 2);
    var good: bool = ecdsa_verify_der(cid, pb, publen, db, dlen, sb, slen);
    sb[slen - 1] = sb[slen - 1] ^ 1;
    var tampered: bool = ecdsa_verify_der(cid, pb, publen, db, dlen, sb, slen);
    sb[slen - 1] = sb[slen - 1] ^ 1;
    db[0] = db[0] ^ 1;
    var wrong: bool = ecdsa_verify_der(cid, pb, publen, db, dlen, sb, slen);
    db[0] = db[0] ^ 1;
    pb[publen - 1] = pb[publen - 1] ^ 1;
    var badkey: bool = ecdsa_verify_der(cid, pb, publen, db, dlen, sb, slen);
    print("curve "); print_i64(cid); print(" hash "); print_i64(dlen);
    print(" good "); print_i64(cast(i64) good); print(" tampered "); print_i64(cast(i64) tampered);
    print(" wrong "); print_i64(cast(i64) wrong); print(" badkey "); println_i64(cast(i64) badkey);
}
