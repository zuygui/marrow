@import("std/std.mw")
@import("std/math.mw")

var FAILS: i64 = 0;

fn close(got: f64, want: f64, id: i64) {
    var diff: f64 = abs(got - want);
    var scale: f64 = abs(want);
    if scale < 1.0 {
        scale = 1.0;
    }
    if is_nan(got) || diff > scale * 0.000000000001 {
        FAILS = FAILS + 1;
        print("math check "); print_i64(id); print(": got "); print_f64(got, 15);
        print(" want "); println_f64(want, 15);
    }
}

