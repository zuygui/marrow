@import("std/std.mw")

struct Box<T> {
    value: T;
}

impl<T> Box<T> {
    fn get(&self) -> T { ret self.value; }
}

struct Named : Box<i64> {
    id: i64;
}

struct Tagged : Named {
    tag: i64;
}

struct Wrapper<T> : Box<T> {
    extra: i64;
}

fn value_of(b: &Box<i64>) -> i64 { ret b.value; }

@export @trusted fn main(argc: i32, argv: rawptr) -> i32 {
    var n: Named = Named { base: Box::<i64> { value: 40 }, id: 2 };
    println_i64(n.value + n.id);
    println_i64(n.get());
    var t: Tagged = Tagged { base: Named { base: Box::<i64> { value: 7 }, id: 8 }, tag: 9 };
    println_i64(t.value * 100 + t.id * 10 + t.tag);
    println_i64(t.get());
    println_i64(value_of(&t));
    var w: Wrapper<i64> = Wrapper::<i64> { base: Box::<i64> { value: 5 }, extra: 6 };
    println_i64(w.value + w.extra);
    println_i64(w.get());
    ret 0;
}
