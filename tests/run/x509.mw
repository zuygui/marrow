@import("std/std.mw")
@import("std/x509.mw")
var H_ROOT: *u8 = "";
var H_INTER: *u8 = "";
var H_LEAF: *u8 = "";
var H_LEAF2: *u8 = "";
var H_FAKE: *u8 = "";
var H_LEAF3: *u8 = "";
var H_OTHER: *u8 = "";
var NOW: i64 = 1792000000;
@trusted fn load(h: *u8) -> *Cert {
    var n: i64 = 0;
    while h[n] != 0 { n = n + 1; }
    var b: *u8 = alloc(n / 2 + 1);
    hex_decode(h, n, b);
    var c: *Cert = x509_parse(b, n / 2);
    dealloc(b);
    if c == null { println("PARSE FAILED"); }
    ret c;
}
fn chain1(a: *Cert) -> *VecPtr { var v: *VecPtr = cast(*VecPtr) vec_ptr_new(4); vec_ptr_push(v, a); ret v; }
fn chain2(a: *Cert, b: *Cert) -> *VecPtr { var v: *VecPtr = chain1(a); vec_ptr_push(v, b); ret v; }
fn chain3(a: *Cert, b: *Cert, c: *Cert) -> *VecPtr { var v: *VecPtr = chain2(a, b); vec_ptr_push(v, c); ret v; }
fn show(label: *u8, code: i64) { print(label); print(": "); println(x509_strerror(code)); }
@export @trusted fn main(argc: i32, argv: rawptr) -> i32 {
    var root: *Cert = load(H_ROOT);
    var inter: *Cert = load(H_INTER);
    var leaf: *Cert = load(H_LEAF);
    var leaf2: *Cert = load(H_LEAF2);
    var fake: *Cert = load(H_FAKE);
    var leaf3: *Cert = load(H_LEAF3);
    var other: *Cert = load(H_OTHER);
    var anchors: *VecPtr = chain1(root);
    var full: *VecPtr = chain3(leaf, inter, root);
    var short: *VecPtr = chain2(leaf, inter);
    show("full chain", x509_verify_chain(full, anchors, "example.test", NOW));
    show("chain without root", x509_verify_chain(short, anchors, "example.test", NOW));
    show("wildcard", x509_verify_chain(short, anchors, "a.wild.test", NOW));
    show("wildcard two labels", x509_verify_chain(short, anchors, "a.b.wild.test", NOW));
    show("wildcard bare", x509_verify_chain(short, anchors, "wild.test", NOW));
    show("uppercase host", x509_verify_chain(short, anchors, "EXAMPLE.test", NOW));
    show("ip san", x509_verify_chain(short, anchors, "10.1.2.3", NOW));
    show("wrong ip", x509_verify_chain(short, anchors, "10.1.2.4", NOW));
    show("wrong host", x509_verify_chain(short, anchors, "evil.test", NOW));
    show("rsa leaf", x509_verify_chain(chain2(leaf2, inter), anchors, "rsa.test", NOW));
    show("expired", x509_verify_chain(short, anchors, "example.test", 5000000000));
    show("not yet valid", x509_verify_chain(short, anchors, "example.test", 1000000000));
    show("missing intermediate", x509_verify_chain(chain1(leaf), anchors, "example.test", NOW));
    show("other anchor", x509_verify_chain(short, chain1(other), "example.test", NOW));
    show("non-CA issuer", x509_verify_chain(chain3(leaf3, fake, root), anchors, "bad.test", NOW));
    show("order swapped", x509_verify_chain(chain2(inter, leaf), anchors, "example.test", NOW));
    show("no host check", x509_verify_chain(short, anchors, null, NOW));
    // tampered signature inside a copy of the leaf
    var bad: *Cert = load(H_LEAF);
    bad.sig[bad.siglen - 3] = bad.sig[bad.siglen - 3] ^ 1;
    show("tampered signature", x509_verify_chain(chain2(bad, inter), anchors, "example.test", NOW));
    var bad2: *Cert = load(H_LEAF);
    bad2.tbs[bad2.tbslen - 1] = bad2.tbs[bad2.tbslen - 1] ^ 1;
    show("tampered body", x509_verify_chain(chain2(bad2, inter), anchors, "example.test", NOW));
    // system trust store parses
    var sys: *VecPtr = cast(*VecPtr) vec_ptr_new(16);
    var n: i64 = x509_load_system_roots(sys);
    if n > 100 { println("system roots loaded"); } else { print("system roots: "); println_i64(n); }
    ret 0;
}
