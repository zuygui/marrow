@import("std/heap.mw")
@export @trusted fn main(argc: i32, argv: rawptr) -> i32 {
    os_println("hello without libc");
    var p: *u8 = heap_alloc(100);
    p[0] = 7;
    p[99] = 9;
    var q: *u8 = heap_realloc(p, 1000);
    if q[0] != 7 { ret 1; }
    if q[99] != 9 { ret 2; }
    heap_free(q);
    var r: *u8 = heap_alloc(1000);
    if r != q { ret 3; }
    var big: *u8 = heap_alloc(100000);
    big[99999] = 1;
    heap_free(big);
    os_println("heap ok");
    ret 0;
}
