@import("std/std.mw")
@import("std/http.mw")

// A tiny static file server for the package manager tests: `fetchd <port> <root> <log>`.
// Files carry an ETag (and `If-None-Match` gets a 304); `/redirect/<path>` redirects to
// `/<path>`; every request is appended to the log as `<status> <path>`.

var LOG: *String = null;
var LOG_PATH: *u8 = null;

fn note(status: i64, path: *u8) {
    string_push_i64(LOG, status);
    string_push_str(LOG, " ");
    string_push_str(LOG, path);
    string_push_str(LOG, "\n");
    write_string_to_file(LOG_PATH, LOG);
}

@export @unsafe fn main(argc: i32, argv: rawptr) -> i32 {
    env_init(argc, argv);
    if arg_count() < 4 { eprintln("usage: fetchd <port> <root> <log>"); ret 2; }
    var port: i64 = 0;
    parse_i64(arg_get(1), raw port);
    var root: *u8 = arg_get(2);
    LOG_PATH = arg_get(3);
    LOG = cast(*String) string_new(256);
    var srv: i64 = http_listen(port);
    if srv < 0 { eprintln("cannot listen"); ret 1; }
    write_string_to_file(str_concat(LOG_PATH, ".ready"), string_from("ok"));
    while true {
        var c: *HttpConn = http_accept(srv);
        if c == null { continue; }
        var req: *HttpMessage = http_read_request(c);
        if req != null {
            var path: *u8 = http_path(req.target);
            if str_starts_with(path, "/redirect/") {
                note(302, path);
                http_reply_redirect(c, 302, path + 9);
            } else {
                var full: *u8 = str_concat(root, path);
                if str_find(path, "..") >= 0 || file_exists(full) != 1 || path_is_dir(full) {
                    note(404, path);
                    http_reply_text(c, 404, "not found\n");
                } else {
                    var body: *String = cast(*String) read_to_string(full);
                    // the ETag is a hash of the content (no file time: not available everywhere)
                    var h: i64 = 5381;
                    for var k: i64 = 0; k < body.len; k += 1 { h = (h * 33 + cast(i64) body.data[k]) & 4294967295; }
                    var tag: *String = cast(*String) string_from("\"");
                    string_push_i64(tag, body.len);
                    string_push_str(tag, "-");
                    string_push_i64(tag, h);
                    string_push_str(tag, "\"");
                    var inm: *u8 = http_header_get(req, "If-None-Match");
                    var hdr: *String = cast(*String) string_from("ETag: ");
                    string_push_str(hdr, tag.data);
                    string_push_str(hdr, "\r\n");
                    if inm != null && str_eq(inm, tag.data) == 1 {
                        note(304, path);
                        http_reply(c, 304, "application/octet-stream", hdr.data, "", 0);
                    } else {
                        note(200, path);
                        http_reply(c, 200, "application/gzip", hdr.data, body.data, body.len);
                    }
                }
            }
            http_message_free(req);
        }
        http_conn_close(c);
    }
    ret 0;
}
