@import("std/task.mw")
@import("std/net.mw")
@import("std/io.mw")

var LISTENER: i64 = 0;
var PORT: i64 = 0;

fn server(arg: rawptr) -> i64 {
    println("server: accepting");
    var c: i64 = task_accept(LISTENER);
    print("server: accepted "); println_i64(c);
    var buf: *u8 = alloc(64);
    var n: i64 = task_recv(c, buf, 64);
    print("server: recv "); println_i64(n);
    task_write_all(c, buf, n);
    println("server: echoed");
    net_close(c);
    ret 0;
}

fn client(arg: rawptr) -> i64 {
    println("client: connecting");
    var fd: i64 = tcp_connect_ip(ip4(127, 0, 0, 1), PORT);
    print("client: connected "); println_i64(fd);
    task_write_all(fd, "ping", 4);
    println("client: sent");
    var buf: *u8 = alloc(64);
    var n: i64 = task_recv(fd, buf, 64);
    print("client: recv "); println_i64(n);
    net_close(fd);
    ret n;
}

@export fn main(argc: i32, argv: rawptr) -> i32 {
    LISTENER = tcp_listen_on(ip4(127, 0, 0, 1), 0, 8);
    PORT = net_local_port(LISTENER);
    print("listening on "); println_i64(PORT);
    var s: *Task = task_spawn(server, null);
    var a: *Task = task_spawn(client, null);
    task_run();
    println("run done");
    println_i64(task_join(a));
    task_join(s);
    ret 0;
}
