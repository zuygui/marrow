@no_main

@import("os.mw")
@import("heap.mw")

// Random numbers.
//  * `random_bytes` / `random_u64`: cryptographically secure, straight from the OS.
//  * `Rng`: fast xoshiro256** generator for simulations, shuffles, tests.

fn random_bytes(buf: *u8, len: i64) -> i64 {
    var done: i64 = 0;
    while done < len {
        var r: i64 = sys_getrandom(buf + done, cast(u64) (len - done));
        if r <= 0 {
            ret -1;
        }
        done = done + r;
    }
    ret 0;
}

@trusted fn random_u64() -> u64 {
    var v: u64 = 0;
    random_bytes(cast(*u8) raw v, 8);
    ret v;
}

struct Rng {
    s0: u64;
    s1: u64;
    s2: u64;
    s3: u64;
}

fn rotl64(x: u64, k: i64) -> u64 {
    ret (x << k) | (x >> (64 - k));
}

@trusted fn splitmix64(state: *u64) -> u64 {
    *state = *state + 0x9e3779b97f4a7c15;
    var z: u64 = *state;
    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9;
    z = (z ^ (z >> 27)) * 0x94d049bb133111eb;
    ret z ^ (z >> 31);
}

@trusted fn rng_seeded(seed: u64) -> Rng {
    var st: u64 = seed;
    var a: u64 = splitmix64(raw st);
    var b: u64 = splitmix64(raw st);
    var c: u64 = splitmix64(raw st);
    var d: u64 = splitmix64(raw st);
    ret Rng { s0: a, s1: b, s2: c, s3: d };
}

// Seeded from the operating system.
fn rng_new() -> Rng {
    ret rng_seeded(random_u64());
}

fn rng_next(r: *Rng) -> u64 {
    var result: u64 = rotl64(r.s1 * 5, 7) * 9;
    var t: u64 = r.s1 << 17;
    r.s2 = r.s2 ^ r.s0;
    r.s3 = r.s3 ^ r.s1;
    r.s1 = r.s1 ^ r.s2;
    r.s0 = r.s0 ^ r.s3;
    r.s2 = r.s2 ^ t;
    r.s3 = rotl64(r.s3, 45);
    ret result;
}

// Uniform in [0, n) without modulo bias (rejection sampling). `n` must be positive.
fn rng_below(r: *Rng, n: u64) -> u64 {
    var threshold: u64 = (0 - n) % n;
    var x: u64 = rng_next(r);
    while x < threshold {
        x = rng_next(r);
    }
    ret x % n;
}

// Uniform in [lo, hi] (inclusive).
fn rng_range(r: *Rng, lo: i64, hi: i64) -> i64 {
    var span: u64 = cast(u64) (hi - lo) + 1;
    if span == 0 {
        ret cast(i64) rng_next(r);
    }
    ret lo + cast(i64) rng_below(r, span);
}

// Uniform in [0, 1).
fn rng_f64(r: *Rng) -> f64 {
    var bits: u64 = rng_next(r) >> 11;
    ret (cast(f64) bits) * 0.00000000000000011102230246251565;
}

fn rng_bool(r: *Rng) -> bool {
    ret (rng_next(r) >> 63) == 1;
}
