@no_main

@import("raw.mw")
@import("heap.mw")
@import("bigint.mw")
@import("asn1.mw")
@import("encoding.mw")

// ECDSA signature verification over NIST P-256 and P-384 (FIPS 186-4), with
// Jacobian-coordinate arithmetic and Shamir's trick.  Verification only: all
// inputs are public, so the variable-time bigint code is acceptable.

var ECC_P256: i64 = 1;
var ECC_P384: i64 = 2;

struct Curve {
    p: *Big;
    n: *Big;
    b: *Big;
    gx: *Big;
    gy: *Big;
    nbytes: i64;
}

// Jacobian point; the point at infinity has z == 0.
struct JP {
    x: *Big;
    y: *Big;
    z: *Big;
}

// ---- temporaries: every pooled Big is released in one go ----
var EC_POOL: i64 = 0;
var EC_POOL_N: i64 = 0;
var EC_POOL_CAP: i64 = 0;

fn pl(b: *Big) -> *Big {
    if EC_POOL_N == EC_POOL_CAP {
        var ncap: i64 = EC_POOL_CAP * 2;
        if ncap < 64 { ncap = 64; }
        var np: *i64 = cast(*i64) heap_alloc(ncap * 8);
        if EC_POOL_N > 0 { raw_copy(cast(*u8) np, cast(*u8) EC_POOL, EC_POOL_N * 8); heap_free(cast(*u8) EC_POOL); }
        EC_POOL = cast(i64) np;
        EC_POOL_CAP = ncap;
    }
    var arr: *i64 = cast(*i64) EC_POOL;
    arr[EC_POOL_N] = cast(i64) b;
    EC_POOL_N = EC_POOL_N + 1;
    ret b;
}

fn pool_release(mark: i64) {
    var arr: *i64 = cast(*i64) EC_POOL;
    while EC_POOL_N > mark {
        EC_POOL_N = EC_POOL_N - 1;
        big_free(cast(*Big) arr[EC_POOL_N]);
    }
}

fn mm(a: *Big, b: *Big, p: *Big) -> *Big { ret pl(big_modmul(a, b, p)); }
fn ma(a: *Big, b: *Big, p: *Big) -> *Big { ret pl(big_modadd(a, b, p)); }
fn ms(a: *Big, b: *Big, p: *Big) -> *Big { ret pl(big_modsub(a, b, p)); }

fn jp_new() -> *JP {
    var j: *JP = heap_alloc(24);
    j.x = big_alloc(0);
    j.y = big_alloc(0);
    j.z = big_alloc(0);
    ret j;
}

fn jp_free(j: *JP) {
    big_free(j.x); big_free(j.y); big_free(j.z);
    heap_free(j);
}

fn jp_set(r: *JP, x: *Big, y: *Big, z: *Big) {
    big_free(r.x); big_free(r.y); big_free(r.z);
    r.x = big_copy(x);
    r.y = big_copy(y);
    r.z = big_copy(z);
}

fn jp_double(r: *JP, a: *JP, c: *Curve) {
    var p: *Big = c.p;
    if big_is_zero(a.z) || big_is_zero(a.y) {
        var zero: *Big = big_alloc(0);
        var one: *Big = big_from_u64(1);
        jp_set(r, one, one, zero);
        big_free(zero); big_free(one);
        ret;
    }
    var mark: i64 = EC_POOL_N;
    var delta: *Big = mm(a.z, a.z, p);
    var gamma: *Big = mm(a.y, a.y, p);
    var beta: *Big = mm(a.x, gamma, p);
    var t1: *Big = ms(a.x, delta, p);
    var t2: *Big = ma(a.x, delta, p);
    var t3: *Big = mm(t1, t2, p);
    var alpha: *Big = ma(ma(t3, t3, p), t3, p);
    var b2: *Big = ma(beta, beta, p);
    var b4: *Big = ma(b2, b2, p);
    var b8: *Big = ma(b4, b4, p);
    var x3: *Big = ms(mm(alpha, alpha, p), b8, p);
    var yz: *Big = ma(a.y, a.z, p);
    var z3: *Big = ms(ms(mm(yz, yz, p), gamma, p), delta, p);
    var g2: *Big = mm(gamma, gamma, p);
    var g2b: *Big = ma(g2, g2, p);
    var g4: *Big = ma(g2b, g2b, p);
    var g8: *Big = ma(g4, g4, p);
    var y3: *Big = ms(mm(alpha, ms(b4, x3, p), p), g8, p);
    jp_set(r, x3, y3, z3);
    pool_release(mark);
}

fn jp_add(r: *JP, a: *JP, b: *JP, c: *Curve) {
    var p: *Big = c.p;
    if big_is_zero(a.z) { jp_set(r, b.x, b.y, b.z); ret; }
    if big_is_zero(b.z) { jp_set(r, a.x, a.y, a.z); ret; }
    var mark: i64 = EC_POOL_N;
    var z1z1: *Big = mm(a.z, a.z, p);
    var z2z2: *Big = mm(b.z, b.z, p);
    var u1: *Big = mm(a.x, z2z2, p);
    var u2: *Big = mm(b.x, z1z1, p);
    var s1: *Big = mm(mm(a.y, b.z, p), z2z2, p);
    var s2: *Big = mm(mm(b.y, a.z, p), z1z1, p);
    var h: *Big = ms(u2, u1, p);
    var sd: *Big = ms(s2, s1, p);
    if big_is_zero(h) {
        var same: bool = big_is_zero(sd);
        pool_release(mark);
        if same { jp_double(r, a, c); }
        else {
            var zero: *Big = big_alloc(0);
            var one: *Big = big_from_u64(1);
            jp_set(r, one, one, zero);
            big_free(zero); big_free(one);
        }
        ret;
    }
    var h2: *Big = ma(h, h, p);
    var i: *Big = mm(h2, h2, p);
    var j: *Big = mm(h, i, p);
    var rr: *Big = ma(sd, sd, p);
    var v: *Big = mm(u1, i, p);
    var x3: *Big = ms(ms(mm(rr, rr, p), j, p), ma(v, v, p), p);
    var s1j: *Big = mm(s1, j, p);
    var y3: *Big = ms(mm(rr, ms(v, x3, p), p), ma(s1j, s1j, p), p);
    var zs: *Big = ma(a.z, b.z, p);
    var z3: *Big = mm(ms(ms(mm(zs, zs, p), z1z1, p), z2z2, p), h, p);
    jp_set(r, x3, y3, z3);
    pool_release(mark);
}

fn curve_new(id: i64) -> *Curve {
    var c: *Curve = heap_alloc(48);
    var hp: *u8 = "";
    var hn: *u8 = "";
    var hb: *u8 = "";
    var hx: *u8 = "";
    var hy: *u8 = "";
    if id == 1 {
        c.nbytes = 32;
        hp = "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff";
        hn = "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551";
        hb = "5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b";
        hx = "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296";
        hy = "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5";
    } else if id == 2 {
        c.nbytes = 48;
        hp = "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff";
        hn = "ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973";
        hb = "b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef";
        hx = "aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7";
        hy = "3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f";
    } else {
        heap_free(c);
        ret null;
    }
    var buf: *u8 = heap_alloc(48);
    hex_decode(hp, c.nbytes * 2, buf); c.p = big_from_bytes(buf, c.nbytes);
    hex_decode(hn, c.nbytes * 2, buf); c.n = big_from_bytes(buf, c.nbytes);
    hex_decode(hb, c.nbytes * 2, buf); c.b = big_from_bytes(buf, c.nbytes);
    hex_decode(hx, c.nbytes * 2, buf); c.gx = big_from_bytes(buf, c.nbytes);
    hex_decode(hy, c.nbytes * 2, buf); c.gy = big_from_bytes(buf, c.nbytes);
    heap_free(buf);
    ret c;
}

fn curve_free(c: *Curve) {
    big_free(c.p); big_free(c.n); big_free(c.b); big_free(c.gx); big_free(c.gy);
    heap_free(c);
}

fn ec_on_curve(c: *Curve, x: *Big, y: *Big) -> bool {
    var p: *Big = c.p;
    if big_cmp(x, p) >= 0 || big_cmp(y, p) >= 0 { ret false; }
    var mark: i64 = EC_POOL_N;
    var lhs: *Big = mm(y, y, p);
    var x3: *Big = mm(mm(x, x, p), x, p);
    var three_x: *Big = ma(ma(x, x, p), x, p);
    var rhs: *Big = ma(ms(x3, three_x, p), c.b, p);
    var ok: bool = big_cmp(lhs, rhs) == 0;
    pool_release(mark);
    ret ok;
}

fn jp_affine(j: *JP, c: *Curve) -> *Big {
    var zi: *Big = big_modinv_prime(j.z, c.p);
    var zi2: *Big = big_modmul(zi, zi, c.p);
    var x: *Big = big_modmul(j.x, zi2, c.p);
    big_free(zi); big_free(zi2);
    ret x;
}

// Verifies (r, s) over `hash` against the uncompressed public key `pub`
// (04 || X || Y).  r and s are big-endian magnitudes.
fn ecdsa_verify(curve: i64, pub: *u8, publen: i64, hash: *u8, hlen: i64, rb: *u8, rlen: i64, sb: *u8, slen: i64) -> bool {
    var c: *Curve = curve_new(curve);
    if c == null { ret false; }
    var nb: i64 = c.nbytes;
    var ok: bool = false;
    if publen == 1 + 2 * nb && pub[0] == 4 {
        var qx: *Big = big_from_bytes(pub + 1, nb);
        var qy: *Big = big_from_bytes(pub + 1 + nb, nb);
        var r: *Big = big_from_bytes(rb, rlen);
        var s: *Big = big_from_bytes(sb, slen);
        var zero_ok: bool = !big_is_zero(r) && !big_is_zero(s);
        if zero_ok && big_cmp(r, c.n) < 0 && big_cmp(s, c.n) < 0 && ec_on_curve(c, qx, qy) {
            var hl: i64 = hlen;
            if hl > nb { hl = nb; }
            var e0: *Big = big_from_bytes(hash, hl);
            var e: *Big = big_mod(e0, c.n);
            var w: *Big = big_modinv_prime(s, c.n);
            var u1: *Big = big_modmul(e, w, c.n);
            var u2: *Big = big_modmul(r, w, c.n);
            var one: *Big = big_from_u64(1);
            var g: *JP = jp_new(); jp_set(g, c.gx, c.gy, one);
            var q: *JP = jp_new(); jp_set(q, qx, qy, one);
            var gq: *JP = jp_new(); jp_add(gq, g, q, c);
            var acc: *JP = jp_new();
            var zero: *Big = big_alloc(0);
            jp_set(acc, one, one, zero);
            var bits: i64 = nb * 8;
            var i: i64 = bits - 1;
            while i >= 0 {
                jp_double(acc, acc, c);
                var b1: i64 = big_bit(u1, i);
                var b2: i64 = big_bit(u2, i);
                if b1 == 1 && b2 == 1 { jp_add(acc, acc, gq, c); }
                else if b1 == 1 { jp_add(acc, acc, g, c); }
                else if b2 == 1 { jp_add(acc, acc, q, c); }
                i = i - 1;
            }
            if !big_is_zero(acc.z) {
                var xa: *Big = jp_affine(acc, c);
                var xr: *Big = big_mod(xa, c.n);
                ok = big_cmp(xr, r) == 0;
                big_free(xa); big_free(xr);
            }
            jp_free(g); jp_free(q); jp_free(gq); jp_free(acc);
            big_free(e0); big_free(e); big_free(w); big_free(u1); big_free(u2); big_free(one); big_free(zero);
        }
        big_free(qx); big_free(qy); big_free(r); big_free(s);
    }
    curve_free(c);
    ret ok;
}

// Same, with the signature as DER SEQUENCE { INTEGER r, INTEGER s }.
fn ecdsa_verify_der(curve: i64, pub: *u8, publen: i64, hash: *u8, hlen: i64, sig: *u8, siglen: i64) -> bool {
    var outer: Der = Der { p: null, len: 0, pos: 0 };
    var body: rawptr = null;
    var blen: i64 = 0;
    der_init(raw outer, sig, siglen);
    if !der_next(raw outer, 48, raw body, raw blen) || !der_done(raw outer) { ret false; }
    var inner: Der = Der { p: null, len: 0, pos: 0 };
    der_init(raw inner, body, blen);
    var rv: rawptr = null; var rl: i64 = 0;
    var sv: rawptr = null; var sl: i64 = 0;
    if !der_next(raw inner, 2, raw rv, raw rl) || !der_next(raw inner, 2, raw sv, raw sl) || !der_done(raw inner) { ret false; }
    var rp: rawptr = null; var rpl: i64 = 0;
    var sp: rawptr = null; var spl: i64 = 0;
    if !der_uint(rv, rl, raw rp, raw rpl) || !der_uint(sv, sl, raw sp, raw spl) { ret false; }
    ret ecdsa_verify(curve, pub, publen, hash, hlen, rp, rpl, sp, spl);
}
