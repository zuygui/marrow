@no_main

// Windows has no stable system call interface. `syscall(n, ...)` instead
// calls a kernel32 function selected by index (see the table in
// src/runtime.rs), and the wrappers below adapt each one.

@extern("__marrow_syscall")
fn syscall(n: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64;

var K32_EXIT_PROCESS: i64 = 0;
var K32_GET_STD_HANDLE: i64 = 1;
var K32_WRITE_FILE: i64 = 2;
var K32_READ_FILE: i64 = 3;
var K32_CLOSE_HANDLE: i64 = 4;
var K32_VIRTUAL_ALLOC: i64 = 5;
var K32_VIRTUAL_FREE: i64 = 6;

// fds 0, 1 and 2 map to the standard handles; anything else is already a HANDLE.
fn win_handle(fd: i32) -> i64 {
    if fd == 0 {
        ret syscall(K32_GET_STD_HANDLE, -10, 0, 0, 0, 0, 0);
    }
    if fd == 1 {
        ret syscall(K32_GET_STD_HANDLE, -11, 0, 0, 0, 0, 0);
    }
    if fd == 2 {
        ret syscall(K32_GET_STD_HANDLE, -12, 0, 0, 0, 0, 0);
    }
    ret cast(i64) fd;
}

fn sys_read(fd: i32, buf: *u8, len: u64) -> i64 {
    var done: i64 = 0;
    var ok: i64 = syscall(K32_READ_FILE, win_handle(fd), cast(i64) buf, cast(i64) len, cast(i64) &done, 0, 0);
    if (ok % 4294967296) == 0 {
        ret -1;
    }
    ret done;
}

fn sys_write(fd: i32, buf: *u8, len: u64) -> i64 {
    var done: i64 = 0;
    var ok: i64 = syscall(K32_WRITE_FILE, win_handle(fd), cast(i64) buf, cast(i64) len, cast(i64) &done, 0, 0);
    if (ok % 4294967296) == 0 {
        ret -1;
    }
    ret done;
}

fn sys_close(fd: i32) -> i64 {
    ret syscall(K32_CLOSE_HANDLE, cast(i64) fd, 0, 0, 0, 0, 0);
}

// MEM_COMMIT|MEM_RESERVE = 0x3000, PAGE_READWRITE = 4
fn sys_mmap_anon(len: u64) -> rawptr {
    var r: i64 = syscall(K32_VIRTUAL_ALLOC, 0, cast(i64) len, 12288, 4, 0, 0);
    if r == 0 {
        ret null;
    }
    ret cast(rawptr) r;
}

// MEM_RELEASE = 0x8000 (the size must be 0 with this flag)
fn sys_munmap(addr: rawptr, len: u64) -> i64 {
    ret syscall(K32_VIRTUAL_FREE, cast(i64) addr, 0, 32768, 0, 0, 0);
}

fn sys_exit(code: i32) {
    syscall(K32_EXIT_PROCESS, cast(i64) code, 0, 0, 0, 0, 0);
}

// Opening files is not implemented on Windows yet.
fn sys_open(path: *u8, flags: i32, mode: i32) -> i64 { ret -38; }
var O_RDONLY: i32 = 0;
var O_WRONLY: i32 = 1;
var O_RDWR: i32 = 2;
var O_CREAT: i32 = 64;
var O_TRUNC: i32 = 512;
var O_APPEND: i32 = 1024;

// Not available on this platform yet: reports ENOSYS (-38).
fn sys_lseek(fd: i32, offset: i64, whence: i32) -> i64 { ret -38; }
fn sys_unlink(path: *u8) -> i64 { ret -38; }
fn sys_mkdir(path: *u8, mode: i32) -> i64 { ret -38; }
fn sys_getrandom(buf: *u8, len: u64) -> i64 { ret -38; }
fn sys_getpid() -> i64 { ret -38; }
fn sys_clock_ns(clock: i32) -> i64 { ret -38; }
fn sys_sleep_ns(ns: i64) -> i64 { ret -38; }
fn sys_system(command: *u8) -> i32 { ret -1; }

// Sockets need Winsock, which is not wired up yet.
var AF_INET: i32 = 2;
var SOCK_STREAM: i32 = 1;
var SOCK_DGRAM: i32 = 2;
var SOL_SOCKET: i32 = 65535;
var SO_REUSEADDR: i32 = 4;
var SO_RCVTIMEO: i32 = 4102;
var SO_SNDTIMEO: i32 = 4101;
var IPPROTO_TCP: i32 = 6;
var TCP_NODELAY: i32 = 1;
fn sys_socket(domain: i32, kind: i32, proto: i32) -> i64 { ret -38; }
fn sys_connect(fd: i32, addr: *u8, len: i32) -> i64 { ret -38; }
fn sys_bind(fd: i32, addr: *u8, len: i32) -> i64 { ret -38; }
fn sys_listen(fd: i32, backlog: i32) -> i64 { ret -38; }
fn sys_accept(fd: i32, addr: *u8, len: *i32) -> i64 { ret -38; }
fn sys_send(fd: i32, buf: *u8, len: u64) -> i64 { ret -38; }
fn sys_recv(fd: i32, buf: *u8, len: u64) -> i64 { ret -38; }
fn sys_sendto(fd: i32, buf: *u8, len: u64, addr: *u8, addr_len: i32) -> i64 { ret -38; }
fn sys_recvfrom(fd: i32, buf: *u8, len: u64) -> i64 { ret -38; }
fn sys_setsockopt(fd: i32, level: i32, name: i32, val: *u8, len: i32) -> i64 { ret -38; }
fn sys_shutdown(fd: i32, how: i32) -> i64 { ret -38; }
fn sys_sockaddr_in(buf: *u8, a: i64, b: i64, c: i64, d: i64, port: i64) { }
fn sys_getsockname(fd: i32, addr: *u8, len: *i32) -> i64 { ret -38; }

fn sys_getdents(fd: i32, buf: *u8, len: u64) -> i64 { ret -38; }
fn sys_getcwd(buf: *u8, len: u64) -> i64 { ret -38; }
fn sys_chdir(path: *u8) -> i64 { ret -38; }
fn sys_rmdir(path: *u8) -> i64 { ret -38; }
fn sys_rename(from: *u8, to: *u8) -> i64 { ret -38; }
