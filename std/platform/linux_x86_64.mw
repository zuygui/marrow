@no_main

// Linux x86_64 system call numbers (see `man 2 syscall`).
// Selected at compile time through `@import("platform/{target}")`.

@import("linux_common.mw")
var SYS_READ: i64 = 0;
var SYS_WRITE: i64 = 1;
var SYS_CLOSE: i64 = 3;
var SYS_MMAP: i64 = 9;
var SYS_MUNMAP: i64 = 11;
var SYS_EXIT: i64 = 60;
var SYS_SOCKET: i64 = 41;
var SYS_BIND: i64 = 49;
var SYS_LISTEN: i64 = 50;
var SYS_ACCEPT: i64 = 43;
var SYS_CONNECT: i64 = 42;

@extern("__marrow_syscall")
fn syscall(n: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64;

// x86_64 still has the plain `open` call (number 2).
fn sys_open(path: *u8, flags: i32, mode: i32) -> i64 {
    ret syscall(2, cast(i64) path, cast(i64) flags, cast(i64) mode, 0, 0, 0);
}
