@no_main

@import("../raw.mw")

// BSD system calls on macOS. The runtime stub reports errors as -errno,
// like Linux. Apple does not promise these numbers stay stable across
// releases, so treat this layer as experimental.

@unsafe fn sys_read(fd: i32, buf: *u8, len: u64) -> i64 {
    ret syscall(SYS_READ, cast(i64) fd, cast(i64) buf, cast(i64) len, 0, 0, 0);
}

@unsafe fn sys_write(fd: i32, buf: *u8, len: u64) -> i64 {
    ret syscall(SYS_WRITE, cast(i64) fd, cast(i64) buf, cast(i64) len, 0, 0, 0);
}

@unsafe fn sys_close(fd: i32) -> i64 {
    ret syscall(SYS_CLOSE, cast(i64) fd, 0, 0, 0, 0, 0);
}

// PROT_READ|PROT_WRITE = 3, MAP_PRIVATE|MAP_ANONYMOUS = 0x1002
@unsafe fn sys_mmap_anon(len: u64) -> rawptr {
    var r: i64 = syscall(SYS_MMAP, 0, cast(i64) len, 3, 4098, -1, 0);
    if r < 0 {
        ret null;
    }
    ret cast(rawptr) r;
}

@unsafe fn sys_munmap(addr: rawptr, len: u64) -> i64 {
    ret syscall(SYS_MUNMAP, cast(i64) addr, cast(i64) len, 0, 0, 0, 0);
}

@unsafe fn sys_exit(code: i32) {
    syscall(SYS_EXIT, cast(i64) code, 0, 0, 0, 0, 0);
}

@unsafe fn sys_lseek(fd: i32, offset: i64, whence: i32) -> i64 {
    ret syscall(199, cast(i64) fd, offset, cast(i64) whence, 0, 0, 0);
}

@unsafe fn sys_unlink(path: *u8) -> i64 {
    ret syscall(10, cast(i64) path, 0, 0, 0, 0, 0);
}

@unsafe fn sys_mkdir(path: *u8, mode: i32) -> i64 {
    ret syscall(136, cast(i64) path, cast(i64) mode, 0, 0, 0, 0);
}

@unsafe fn sys_getpid() -> i64 {
    ret syscall(20, 0, 0, 0, 0, 0, 0);
}

// getentropy(2) takes at most 256 bytes per call.
@unsafe fn sys_getrandom(buf: *u8, len: u64) -> i64 {
    var done: u64 = 0;
    while done < len {
        var chunk: u64 = len - done;
        if chunk > 256 {
            chunk = 256;
        }
        var r: i64 = syscall(500, cast(i64) (buf + done), cast(i64) chunk, 0, 0, 0, 0);
        if r < 0 {
            ret r;
        }
        done = done + chunk;
    }
    ret cast(i64) len;
}

var SYS_ENVP: i64 = 0;

@unsafe fn sys_root_next(prev: i64, der: *i64, len: *i64) -> i64 { ret 0; }

@unsafe fn sys_env_block(argc: i64, argv: i64) -> *i64 {
    var a: *i64 = cast(*i64) argv;
    ret a + (argc + 1) * 8;
}

struct SpawnArgs {
    w0: i64; w1: i64; w2: i64; w3: i64; w4: i64; w5: i64; w6: i64; w7: i64;
    w8: i64; w9: i64; w10: i64; w11: i64; w12: i64; w13: i64; w14: i64; w15: i64;
    w16: i64; w17: i64; w18: i64; w19: i64; w20: i64; w21: i64; w22: i64; w23: i64;
}

struct Argv4 {
    a0: i64;
    a1: i64;
    a2: i64;
    a3: i64;
}

// fork(2) cannot be used without libc (the child is told apart by a second
// return register), so the shell is started with the posix_spawn system call
// (244); an all-zero descriptor means no attributes and no file actions.
@unsafe fn sys_system(command: *u8) -> i32 {
    var argv: Argv4 = Argv4 { a0: cast(i64) "sh", a1: cast(i64) "-c", a2: cast(i64) command, a3: 0 };
    var desc: SpawnArgs = SpawnArgs { w0: 0, w1: 0, w2: 0, w3: 0, w4: 0, w5: 0, w6: 0, w7: 0, w8: 0, w9: 0, w10: 0, w11: 0, w12: 0, w13: 0, w14: 0, w15: 0, w16: 0, w17: 0, w18: 0, w19: 0, w20: 0, w21: 0, w22: 0, w23: 0 };
    var pid: i64 = 0;
    var r: i64 = syscall(244, cast(i64) raw pid, cast(i64) "/bin/sh", cast(i64) raw desc, cast(i64) raw argv, SYS_ENVP, 0);
    if r < 0 {
        ret -1;
    }
    var status: i32 = 0;
    syscall(7, pid, cast(i64) raw status, 0, 0, 0, 0);
    ret (status >> 8) & 255;
}

// ---- sockets ------------------------------------------------------------------

var AF_INET: i32 = 2;
var SOCK_STREAM: i32 = 1;
var SOCK_DGRAM: i32 = 2;
var SOL_SOCKET: i32 = 65535;
var SO_REUSEADDR: i32 = 4;
var SO_RCVTIMEO: i32 = 4102;
var SO_SNDTIMEO: i32 = 4101;
var IPPROTO_TCP: i32 = 6;
var TCP_NODELAY: i32 = 1;

// SO_NOSIGPIPE (0x1022) replaces Linux's MSG_NOSIGNAL.
@unsafe fn sys_socket(domain: i32, kind: i32, proto: i32) -> i64 {
    var fd: i64 = syscall(97, cast(i64) domain, cast(i64) kind, cast(i64) proto, 0, 0, 0);
    if fd >= 0 {
        var one: i32 = 1;
        syscall(105, fd, 65535, 4130, cast(i64) raw one, 4, 0);
    }
    ret fd;
}

@unsafe fn sys_connect(fd: i32, addr: *u8, len: i32) -> i64 {
    ret syscall(98, cast(i64) fd, cast(i64) addr, cast(i64) len, 0, 0, 0);
}

