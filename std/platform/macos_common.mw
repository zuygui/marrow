@unsafe fn sys_chdir(path: *u8) -> i64 {
    ret syscall(12, cast(i64) path, 0, 0, 0, 0, 0);
}

// getdirentries64 returns records laid out differently from Linux's
// linux_dirent64 (ino, seekoff, reclen, namlen, type, name vs. ino, off,
// reclen, type, name). The records are rewritten in place so that callers see
// the Linux layout: reclen at 16, type at 18, NUL-terminated name at 19.
@unsafe fn sys_getdents(fd: i32, buf: *u8, len: u64) -> i64 {
    var base: i64 = 0;
    var n: i64 = syscall(344, cast(i64) fd, cast(i64) buf, cast(i64) len, cast(i64) raw base, 0, 0);
    if n <= 0 {
        ret n;
    }
    var off: i64 = 0;
    while off < n {
        var rec: *u8 = buf + off;
        var reclen: i64 = (cast(i64) rec[16]) | ((cast(i64) rec[17]) << 8);
        var namlen: i64 = (cast(i64) rec[18]) | ((cast(i64) rec[19]) << 8);
        var kind: u8 = rec[20];
        var i: i64 = 0;
        while i <= namlen {
            rec[19 + i] = rec[21 + i];
            i = i + 1;
        }
        rec[18] = kind;
        if reclen <= 0 {
            ret n;
        }
        off = off + reclen;
    }
    ret n;
}

// macOS has no getcwd system call: open "." and ask for its path with
// fcntl(F_GETPATH). Returns the length including the NUL, like Linux.
@unsafe fn sys_getcwd(buf: *u8, len: u64) -> i64 {
    var fd: i64 = syscall(5, cast(i64) ".", 0, 0, 0, 0, 0);
    if fd < 0 {
        ret fd;
    }
    var page: *u8 = cast(*u8) sys_mmap_anon(4096);
    if page == null {
        syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0);
        ret -12;
    }
    var r: i64 = syscall(92, fd, 50, cast(i64) page, 0, 0, 0);
    syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0);
    if r < 0 {
        sys_munmap(cast(rawptr) page, 4096);
        ret r;
    }
    var n: i64 = 0;
    while page[n] != 0 {
        n = n + 1;
    }
    if n + 1 > cast(i64) len {
        sys_munmap(cast(rawptr) page, 4096);
        ret -34;
    }
    var i: i64 = 0;
    while i <= n {
        buf[i] = page[i];
        i = i + 1;
    }
    sys_munmap(cast(rawptr) page, 4096);
    ret n + 1;
}

// fstat64 (the 64-bit inode variant): st_mode is a u16 at 4, st_mtimespec.tv_sec
// at 48 and st_size at 96.
@unsafe fn sys_fstat_info(fd: i32, mode: *i64, size: *i64, mtime: *i64) -> i64 {
    var page: *u8 = cast(*u8) sys_mmap_anon(4096);
    if page == null {
        ret -12;
    }
    var r: i64 = syscall(339, cast(i64) fd, cast(i64) page, 0, 0, 0, 0);
    if r < 0 {
        sys_munmap(cast(rawptr) page, 4096);
        ret r;
    }
    var words: *i64 = cast(*i64) page;
    *mode = (cast(i64) page[4]) | ((cast(i64) page[5]) << 8);
    *mtime = words[6];
    *size = words[12];
    sys_munmap(cast(rawptr) page, 4096);
    ret 0;
}
