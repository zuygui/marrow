    ret syscall(137, cast(i64) path, 0, 0, 0, 0, 0);
}

@unsafe fn sys_rename(from: *u8, to: *u8) -> i64 {
    ret syscall(128, cast(i64) from, cast(i64) to, 0, 0, 0, 0);
