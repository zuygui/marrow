// BSD sockaddr_in starts with a length byte and a one-byte family.
@unsafe fn sys_sockaddr_in(buf: *u8, a: i64, b: i64, c: i64, d: i64, port: i64) {
    raw_zero(buf, 16);
    buf[0] = 16;
    buf[1] = 2;
    buf[2] = cast(u8) ((port >> 8) & 255);
    buf[3] = cast(u8) (port & 255);
    buf[4] = cast(u8) a;
    buf[5] = cast(u8) b;
    buf[6] = cast(u8) c;
    buf[7] = cast(u8) d;
}

@unsafe fn sys_getsockname(fd: i32, addr: *u8, len: *i32) -> i64 {
    ret syscall(32, cast(i64) fd, cast(i64) addr, cast(i64) len, 0, 0, 0);
}

// Not implemented on macOS yet (the dirent and stat layouts differ).

// ---- readiness and memory protection (used by std/task.mw) ----------------------

@unsafe fn sys_poll(fds: *i64, n: i64, timeout_ns: i64) -> i64 {
    var ms: i64 = -1;
    if timeout_ns >= 0 {
        ms = (timeout_ns + 999999) / 1000000;
    }
    ret syscall(230, cast(i64) fds, n, ms, 0, 0, 0);
}

@unsafe fn sys_mprotect(addr: rawptr, len: u64, prot: i32) -> i64 {
    ret syscall(74, cast(i64) addr, cast(i64) len, cast(i64) prot, 0, 0, 0);
}

// ---- time ---------------------------------------------------------------------

struct MacTimeval {
    sec: i64;
    usec: i64;
}

// There is no clock_gettime system call on macOS (it lives in the commpage),
// so both clocks come from gettimeofday(2). The "monotonic" clock is therefore
// the wall clock and can jump when the system time is adjusted.
@unsafe fn sys_clock_ns(clock: i32) -> i64 {
    var tv: MacTimeval = MacTimeval { sec: 0, usec: 0 };
    var r: i64 = syscall(116, cast(i64) raw tv, 0, 0, 0, 0, 0);
    if r < 0 {
        ret r;
    }
    ret tv.sec * 1000000000 + tv.usec * 1000;
}

// Sleeps with poll(2) and no descriptors; resolution is one millisecond.
@unsafe fn sys_sleep_ns(ns: i64) -> i64 {
    var r: i64 = sys_poll(null, 0, ns);
    if r < 0 {
        ret r;
    }
    ret 0;
}

