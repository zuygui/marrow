@no_main

@import("string.mw")
@import("fmt.mw")
@import("vec.mw")

// Text utilities on NUL-terminated byte strings (`*u8`) and on `String`.

// ---- characters ---------------------------------------------------------------

fn is_upper(c: u8) -> bool {
    ret c >= 65 && c <= 90;
}

fn is_lower(c: u8) -> bool {
    ret c >= 97 && c <= 122;
}

fn is_alnum(c: u8) -> bool {
    ret is_lower(c) || is_upper(c) || (c >= 48 && c <= 57);
}

fn is_hex_digit(c: u8) -> bool {
    ret (c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70);
}

fn to_lower(c: u8) -> u8 {
    if is_upper(c) {
        ret c + 32;
    }
    ret c;
}

fn to_upper(c: u8) -> u8 {
    if is_lower(c) {
        ret c - 32;
    }
    ret c;
}

// Value of a hexadecimal digit, or -1.
fn hex_value(c: u8) -> i64 {
    if c >= 48 && c <= 57 {
        ret cast(i64) (c - 48);
    }
    if c >= 97 && c <= 102 {
        ret cast(i64) (c - 87);
    }
    if c >= 65 && c <= 70 {
        ret cast(i64) (c - 55);
    }
    ret -1;
}

// ---- C-string helpers --------------------------------------------------------------

// Lexicographic comparison on bytes: negative, zero or positive.
fn str_cmp(a: *u8, b: *u8) -> i32 {
    var i: i64 = 0;
    while a[i] != 0 && a[i] == b[i] {
        i = i + 1;
    }
    if a[i] < b[i] {
        ret -1;
    }
    if a[i] > b[i] {
        ret 1;
    }
    ret 0;
}

fn str_starts_with(s: *u8, prefix: *u8) -> bool {
    var i: i64 = 0;
    while prefix[i] != 0 {
        if s[i] != prefix[i] {
            ret false;
        }
        i = i + 1;
    }
    ret true;
}

fn str_ends_with(s: *u8, suffix: *u8) -> bool {
    var ls: i64 = str_len(s);
    var lx: i64 = str_len(suffix);
    if lx > ls {
        ret false;
    }
    ret str_eq(s + (ls - lx), suffix) == 1;
}

// Index of the first occurrence of `c`, or -1.
fn str_find_char(s: *u8, c: u8) -> i64 {
    var i: i64 = 0;
    while s[i] != 0 {
        if s[i] == c {
            ret i;
        }
        i = i + 1;
    }
    ret -1;
}

fn str_rfind_char(s: *u8, c: u8) -> i64 {
    var last: i64 = -1;
    var i: i64 = 0;
    while s[i] != 0 {
        if s[i] == c {
            last = i;
        }
        i = i + 1;
    }
    ret last;
}

// Index of the first occurrence of `needle` in `hay`, or -1.
fn str_find(hay: *u8, needle: *u8) -> i64 {
    var ln: i64 = str_len(needle);
    if ln == 0 {
        ret 0;
    }
    var i: i64 = 0;
    while hay[i] != 0 {
        var j: i64 = 0;
        while j < ln && hay[i + j] == needle[j] {
            j = j + 1;
        }
        if j == ln {
            ret i;
        }
        if hay[i + j] == 0 {
            ret -1;
        }
        i = i + 1;
    }
    ret -1;
}

// Copy into freshly allocated memory (free it with `dealloc`).
fn str_dup(s: *u8) -> *u8 {
    var n: i64 = str_len(s);
    var out: *u8 = alloc(n + 1);
    mem_copy(out, s, n);
    out[n] = 0;
    ret out;
}

fn str_dup_n(s: *u8, n: i64) -> *u8 {
    var out: *u8 = alloc(n + 1);
    mem_copy(out, s, n);
    out[n] = 0;
    ret out;
}

fn str_concat(a: *u8, b: *u8) -> *u8 {
    var la: i64 = str_len(a);
    var lb: i64 = str_len(b);
    var out: *u8 = alloc(la + lb + 1);
    mem_copy(out, a, la);
    mem_copy(out + la, b, lb);
    out[la + lb] = 0;
    ret out;
}

fn str_to_lower_in_place(s: *u8) {
    var i: i64 = 0;
    while s[i] != 0 {
        s[i] = to_lower(s[i]);
        i = i + 1;
    }
}

fn str_to_upper_in_place(s: *u8) {
    var i: i64 = 0;
    while s[i] != 0 {
        s[i] = to_upper(s[i]);
        i = i + 1;
    }
}

// Case-insensitive (ASCII) equality.
fn str_eq_nocase(a: *u8, b: *u8) -> bool {
    var i: i64 = 0;
    while a[i] != 0 && b[i] != 0 {
        if to_lower(a[i]) != to_lower(b[i]) {
            ret false;
        }
        i = i + 1;
    }
    ret a[i] == b[i];
}

// ---- number parsing --------------------------------------------------------------

// Parses an optionally signed decimal integer; the whole string must be used.
@trusted fn parse_i64(s: *u8, out: *i64) -> bool {
    var i: i64 = 0;
    var neg: bool = false;
    if s[0] == 45 {
        neg = true;
        i = 1;
    } else {
        if s[0] == 43 {
            i = 1;
        }
    }
    if s[i] == 0 {
        ret false;
    }
    var acc: u64 = 0;
    var limit: u64 = 9223372036854775807;
    if neg {
        limit = 9223372036854775808;
    }
    while s[i] != 0 {
        if s[i] < 48 || s[i] > 57 {
            ret false;
        }
        var d: u64 = cast(u64) (s[i] - 48);
        if acc > (limit - d) / 10 {
            ret false;
        }
        acc = acc * 10 + d;
        i = i + 1;
    }
    if neg {
        *out = cast(i64) (0 - acc);
    } else {
        *out = cast(i64) acc;
    }
    ret true;
}

@trusted fn parse_u64(s: *u8, base: i64, out: *u64) -> bool {
    if s[0] == 0 {
        ret false;
    }
    var acc: u64 = 0;
    var i: i64 = 0;
    while s[i] != 0 {
        var d: i64 = hex_value(s[i]);
        if d < 0 || d >= base {
            ret false;
        }
        var ud: u64 = cast(u64) d;
        var ub: u64 = cast(u64) base;
        if acc > (18446744073709551615 - ud) / ub {
            ret false;
        }
        acc = acc * ub + ud;
        i = i + 1;
    }
    *out = acc;
    ret true;
}

// 10^n for 0 <= n <= 22, exact in double precision.
fn text_pow10(n: i64) -> f64 {
    var p: f64 = 1.0;
    var i: i64 = 0;
    while i < n {
        p = p * 10.0;
        i = i + 1;
    }
    ret p;
}

// Parses decimal floats such as `-12.5`, `.5`, `3.`, `1e-9`, `2.5E+3`.
// The whole string must be used. Correctly rounded for ordinary inputs (up to
// 19 significant digits and exponents within +-22), a few ulps off beyond that.
@trusted fn parse_f64(s: *u8, out: *f64) -> bool {
    var i: i64 = 0;
    var neg: bool = false;
    if s[0] == 45 {
        neg = true;
        i = 1;
    } else {
        if s[0] == 43 {
            i = 1;
        }
    }
    var mant: u64 = 0;
    var digits: i64 = 0;
    var dropped: i64 = 0;
    var frac_digits: i64 = 0;
    var seen_digit: bool = false;
    while s[i] >= 48 && s[i] <= 57 {
        seen_digit = true;
        if digits < 19 {
            mant = mant * 10 + cast(u64) (s[i] - 48);
            if mant != 0 {
                digits = digits + 1;
            }
        } else {
            dropped = dropped + 1;
        }
        i = i + 1;
    }
    if s[i] == 46 {
        i = i + 1;
        while s[i] >= 48 && s[i] <= 57 {
            seen_digit = true;
            if digits < 19 {
                mant = mant * 10 + cast(u64) (s[i] - 48);
                if mant != 0 {
                    digits = digits + 1;
                }
                frac_digits = frac_digits + 1;
            }
            i = i + 1;
        }
    }
    if !seen_digit {
        ret false;
    }
    var exp10: i64 = dropped - frac_digits;
    if s[i] == 101 || s[i] == 69 {
        i = i + 1;
        var eneg: bool = false;
        if s[i] == 45 {
            eneg = true;
            i = i + 1;
        } else {
            if s[i] == 43 {
                i = i + 1;
            }
        }
        if s[i] < 48 || s[i] > 57 {
            ret false;
        }
        var e: i64 = 0;
        while s[i] >= 48 && s[i] <= 57 {
            if e < 100000 {
                e = e * 10 + cast(i64) (s[i] - 48);
            }
            i = i + 1;
        }
        if eneg {
            e = 0 - e;
        }
        exp10 = exp10 + e;
    }
    if s[i] != 0 {
        ret false;
    }
    var v: f64 = cast(f64) mant;
    // Scale in exact steps of 10^22 (the largest exactly representable power).
    while exp10 > 22 {
        v = v * 10000000000000000000000.0;
        exp10 = exp10 - 22;
    }
    while exp10 < -22 {
        v = v / 10000000000000000000000.0;
        exp10 = exp10 + 22;
    }
    if exp10 > 0 {
        v = v * text_pow10(exp10);
    }
    if exp10 < 0 {
        v = v / text_pow10(0 - exp10);
    }
    if neg {
        v = 0.0 - v;
    }
    *out = v;
    ret true;
}

// ---- splitting ---------------------------------------------------------------------

// Splits on a separator byte. Returns a vector of freshly allocated C strings
// (free each with `dealloc`, then the vector with `vec_ptr_free`).
fn str_split(s: *u8, sep: u8) -> ^VecPtr {
    var parts: ^VecPtr = vec_ptr_new(8);
    var start: i64 = 0;
    var i: i64 = 0;
    while 1 == 1 {
        if s[i] == sep || s[i] == 0 {
            vec_ptr_push(parts, str_dup_n(s + start, i - start));
            if s[i] == 0 {
                ret parts;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    ret parts;
}

// Trims ASCII whitespace from both ends; returns a new C string.
fn str_trim(s: *u8) -> *u8 {
    var start: i64 = 0;
    while s[start] != 0 && is_space(s[start]) == 1 {
        start = start + 1;
    }
    var end: i64 = str_len(s);
    while end > start && is_space(s[end - 1]) == 1 {
        end = end - 1;
    }
    ret str_dup_n(s + start, end - start);
}

// ---- building strings -----------------------------------------------------------------

fn string_push_i64(s: *String, n: i64) {
    var buf: *u8 = alloc(32);
    var len: i64 = fmt_i64(buf, n);
    buf[len] = 0;
    string_push_str(s, buf);
    dealloc(buf);
}

fn string_push_u64(s: *String, n: u64) {
    var buf: *u8 = alloc(32);
    var len: i64 = fmt_u64(buf, n, 10);
    buf[len] = 0;
    string_push_str(s, buf);
    dealloc(buf);
}

fn string_push_hex(s: *String, n: u64) {
    var buf: *u8 = alloc(32);
    var len: i64 = fmt_u64(buf, n, 16);
    buf[len] = 0;
    string_push_str(s, buf);
    dealloc(buf);
}

fn string_push_f64(s: *String, x: f64, decimals: i64) {
    var buf: *u8 = alloc(64);
    var len: i64 = fmt_f64(buf, x, decimals);
    buf[len] = 0;
    string_push_str(s, buf);
    dealloc(buf);
}

// Appends `len` raw bytes (which may contain NULs).
fn string_push_bytes(s: *String, data: *u8, len: i64) {
    if s.len + len + 1 >= s.cap {
        var new_cap: i64 = (s.len + len + 1) * 2;
        s.data = realloc(s.data, new_cap);
        s.cap = new_cap;
    }
    mem_copy(s.data + s.len, data, len);
    s.len = s.len + len;
    s.data[s.len] = 0;
}

fn string_clear(s: *String) {
    s.len = 0;
    s.data[0] = 0;
}

fn string_dup_cstr(s: *String) -> *u8 {
    ret str_dup_n(s.data, s.len);
}
