@no_main

@import("string.mw")
@import("io.mw")

// Files on top of raw system calls. A file handle is a `rawptr` holding the
// file descriptor plus one, so that `null` can mean "could not open".

fn file_handle(fd: i64) -> rawptr {
    if fd < 0 {
        ret null;
    }
    ret cast(rawptr) (fd + 1);
}

fn file_fd(handle: rawptr) -> i32 {
    var h: i64 = cast(i64) handle;
    ret cast(i32) (h - 1);
}

fn file_open_read(path: *u8) -> rawptr {
    ret file_handle(sys_open(path, O_RDONLY, 0));
}

// Creates the file (mode 0644) or truncates it.
fn file_open_write(path: *u8) -> rawptr {
    var flags: i32 = O_WRONLY | O_CREAT | O_TRUNC;
    ret file_handle(sys_open(path, flags, 420));
}

fn file_open_append(path: *u8) -> rawptr {
    var flags: i32 = O_WRONLY | O_CREAT | O_APPEND;
    ret file_handle(sys_open(path, flags, 420));
}

fn file_close(handle: rawptr) {
    if handle != null {
        sys_close(file_fd(handle));
    }
}

// Reads up to `count` bytes. Returns the number read, 0 at end of file, or a
// negative error.
fn file_read(handle: rawptr, buf: *u8, count: i64) -> i64 {
    if handle == null {
        ret -1;
    }
    ret sys_read(file_fd(handle), buf, cast(u64) count);
}

// Writes every byte. Returns 0 on success.
fn file_write(handle: rawptr, buf: *u8, count: i64) -> i64 {
    if handle == null {
        ret -1;
    }
    ret os_write_all(file_fd(handle), buf, count);
}

fn file_get_size(handle: rawptr) -> i64 {
    if handle == null {
        ret 0;
    }
    var fd: i32 = file_fd(handle);
    var here: i64 = sys_lseek(fd, 0, 1);
    var size: i64 = sys_lseek(fd, 0, 2);
    if here >= 0 {
        sys_lseek(fd, here, 0);
    }
    if size < 0 {
        ret 0;
    }
    ret size;
}

fn file_exists(path: *u8) -> i32 {
    var h: rawptr = file_open_read(path);
    if h == null {
        ret 0;
    }
    file_close(h);
    ret 1;
}

fn file_remove(path: *u8) -> i32 {
    if sys_unlink(path) < 0 {
        ret 0;
    }
    ret 1;
}

fn dir_create(path: *u8) -> i32 {
    if sys_mkdir(path, 493) < 0 {
        ret 0;
    }
    ret 1;
}

// Reads the whole file (works for pipes too, where the size is unknown).
fn read_to_string(path: *u8) -> ^String {
    var f: rawptr = file_open_read(path);
    if f == null {
        eprint("fs error: cannot open file: ");
        eprintln(path);
        ret 0;
    }

    var size: i64 = file_get_size(f);
    var start_cap: i64 = size + 1;
    if start_cap < 64 {
        start_cap = 64;
    }
    var content: ^String = string_new(start_cap);
    if content == 0 {
        file_close(f);
        ret 0;
    }

    var done: i64 = 0;
    while 1 == 1 {
        if done + 1 >= content.cap {
            var bigger: i64 = content.cap * 2;
            content.data = realloc(content.data, bigger);
            content.cap = bigger;
        }
        var n: i64 = file_read(f, content.data + done, content.cap - done - 1);
        if n <= 0 {
            ret finish_read(f, content, done);
        }
        done = done + n;
    }
    ret finish_read(f, content, done);
}

@trusted fn finish_read(f: rawptr, content: ^String, done: i64) -> ^String {
    file_close(f);
    content.len = done;
    var end: *u8 = content.data + done;
    *end = 0;
    ret content;
}

fn write_string_to_file(path: *u8, content: *String) -> i32 {
    if content == 0 {
        ret 0;
    }
    var f: rawptr = file_open_write(path);
    if f == null {
        eprint("fs error: cannot create file: ");
        eprintln(path);
        ret 0;
    }
    var ok: i32 = 1;
    if content.data != 0 && content.len > 0 {
        if file_write(f, content.data, content.len) != 0 {
            ok = 0;
        }
    }
    file_close(f);
    ret ok;
}
