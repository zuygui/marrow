@no_main

@import("os.mw")
@import("fmt.mw")

// Console output on top of raw write(2): no libc, no buffering.

fn print(s: *u8) {
    os_print(s);
}

fn println(s: *u8) {
    os_println(s);
}

fn eprint(s: *u8) {
    os_eprint(s);
}

fn eprintln(s: *u8) {
    os_eprint(s);
    os_write_all(2, "\n", 1);
}

@trusted fn print_char(c: u8) {
    var b: u8 = c;
    os_write_all(1, raw b, 1);
}

@trusted fn print_i64(n: i64) {
    var buf: *u8 = heap_alloc(64);
    var len: i64 = fmt_i64(buf, n);
    os_write_all(1, buf, len);
    heap_free(buf);
}

fn println_i64(n: i64) {
    print_i64(n);
    os_write_all(1, "\n", 1);
}

@trusted fn print_u64(n: u64) {
    var buf: *u8 = heap_alloc(64);
    var len: i64 = fmt_u64(buf, n, 10);
    os_write_all(1, buf, len);
    heap_free(buf);
}

fn println_u64(n: u64) {
    print_u64(n);
    os_write_all(1, "\n", 1);
}

@trusted fn print_hex(n: u64) {
    var buf: *u8 = heap_alloc(64);
    var len: i64 = fmt_u64(buf, n, 16);
    os_write_all(1, "0x", 2);
    os_write_all(1, buf, len);
    heap_free(buf);
}

@trusted fn print_f64(x: f64, decimals: i64) {
    var buf: *u8 = heap_alloc(64);
    var len: i64 = fmt_f64(buf, x, decimals);
    os_write_all(1, buf, len);
    heap_free(buf);
}

fn println_f64(x: f64, decimals: i64) {
    print_f64(x, decimals);
    os_write_all(1, "\n", 1);
}
