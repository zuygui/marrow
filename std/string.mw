@no_main

@import("mem.mw")

fn str_len(s: *u8) -> i64 {
    var ptr: *u8 = s;
    var len: i64 = 0;
    while (*ptr != 0) {
        len = len + 1;
        ptr = ptr + 1;
    }
    ret len;
}

fn str_eq(s1: *u8, s2: *u8) -> i8 {
    var p1: *u8 = s1;
    var p2: *u8 = s2;
    while (*p1 != 0) {
        if (*p1 != *p2) {
            ret 0;
        }
        p1 = p1 + 1;
        p2 = p2 + 1;
    }
    if (*p2 == 0) {
        ret 1;
    }
    ret 0;
}

fn is_digit(c: u8) -> i8 {
    if (c >= 48) {
        if (c <= 57) {
            ret 1;
        }
    }
    ret 0;
}

fn is_alpha(c: u8) -> i8 {
    if (c >= 97) {
        if (c <= 122) {
            ret 1;
        }
    }
    if (c >= 65) {
        if (c <= 90) {
            ret 1;
        }
    }
    if (c == 95) {
        ret 1;
    }
    ret 0;
}

fn is_space(c: u8) -> i8 {
    if (c == 32) { ret 1; }
    if (c == 9)  { ret 1; }
    if (c == 10) { ret 1; }
    if (c == 13) { ret 1; }
    ret 0;
}

struct String {
    data: *u8;
    len: i64;
    cap: i64;
}

fn string_new(initial_cap: i64) -> *String {
    var s: *String = alloc(24);

    if (initial_cap < 8) {
        initial_cap = 8;
    }

    s.data = alloc(initial_cap);
    s.len = 0;
    s.cap = initial_cap;
    *(s.data) = 0;
    ret s;
}

fn string_from(raw_str: *u8) -> *String {
    var length: i64 = str_len(raw_str);
    var s: *String = string_new(length + 1);

    mem_copy(s.data, raw_str, length);
    s.len = length;

    var end_ptr: *u8 = s.data + length;
    *end_ptr = 0;

    ret s;
}

fn string_push_char(s: *String, c: u8) {
    if (s.len + 1 >= s.cap) {
        var new_cap: i64 = s.cap * 2;
        s.data = realloc(s.data, new_cap);
        s.cap = new_cap;
    }

    var char_ptr: *u8 = s.data + s.len;
    *char_ptr = c;

    s.len = s.len + 1;

    var null_ptr: *u8 = s.data + s.len;
    *null_ptr = 0;
}

fn string_push_str(s: *String, raw_str: *u8) {
    var extra_len: i64 = str_len(raw_str);

    if (s.len + extra_len >= s.cap) {
        var new_cap: i64 = (s.len + extra_len) * 2;
        s.data = realloc(s.data, new_cap);
        s.cap = new_cap;
    }

    var dest_ptr: *u8 = s.data + s.len;
    mem_copy(dest_ptr, raw_str, extra_len);

    s.len = s.len + extra_len;

    var null_ptr: *u8 = s.data + s.len;
    *null_ptr = 0;
}

fn string_free(s: *String) {
    dealloc(s.data);
    dealloc(s);
}

fn string_eq(a: *String, b: *String) -> i32 {
    if (a == 0 || b == 0) { ret 0; }
    if (a == b) { ret 1; } // Même pointeur
    if (a.len != b.len) { ret 0; }

    ret cast(i32) str_eq(a.data, b.data);
}

fn string_cmp(a: *String, b: *String) -> i32 {
    if (a == 0 || b == 0) { ret 0; }
    if (a.data == 0 || b.data == 0) { ret 0; }

    var min_len: i64 = a.len;
    if (b.len < min_len) {
        min_len = b.len;
    }

    var i: i64 = 0;
    while (i < min_len) {
        var ptr_a: *u8 = a.data + i;
        var ptr_b: *u8 = b.data + i;
        var ca: u8 = *ptr_a;
        var cb: u8 = *ptr_b;

        if (ca < cb) { ret -1; }
        if (ca > cb) { ret 1; }

        i = i + 1;
    }

    if (a.len < b.len) { ret -1; }
    if (a.len > b.len) { ret 1; }

    ret 0;
}