@no_main

@import("mem.mw")
@import("sys.mw")
@import("vec.mw")
@import("string.mw")

struct LinearMapEntry {
    key: *String;
    value: rawptr;
}

struct LinearMap {
    entries: *VecPtr; // Stocke des *LinearMapEntry
}

fn linear_map_new(initial_cap: i64) -> *LinearMap {
    var map: *LinearMap = alloc(24);
    map.entries = vec_ptr_new(initial_cap);
    ret map;
}

fn linear_map_put(map: *LinearMap, key: *String, value: rawptr) {
    if (map == 0 || key == 0) { ret; }

    var entry: *LinearMapEntry = alloc(16);
    entry.key = key;
    entry.value = value;

    vec_ptr_push(map.entries, entry);
}

fn linear_map_get(map: *LinearMap, key: *String) -> rawptr {
    if (map == 0 || key == 0) { ret 0; }

    var len: i64 = map.entries.len;
    var i: i64 = len - 1;

    while (i >= 0) {
        var entry: *LinearMapEntry = cast(*LinearMapEntry) vec_ptr_get(map.entries, i);
        if (entry != 0 && entry.key != 0) {
            if (string_eq(entry.key, key) == 1) {
                ret entry.value;
            }
        }
        i = i - 1;
    }

    ret 0;
}

fn linear_map_free(map: *LinearMap) {
    if (map == 0) { ret; }

    var i: i64 = 0;
    while (i < map.entries.len) {
        var entry: *LinearMapEntry = cast(*LinearMapEntry) vec_ptr_get(map.entries, i);
        if (entry != 0) {
            dealloc(entry);
        }
        i = i + 1;
    }

    vec_ptr_free(map.entries);
    dealloc(map);
}

struct HashNode {
    key: *String;
    value: rawptr;
    hash: i64;
    next: *HashNode;
}

struct HashMap {
    buckets: *VecPtr;
    capacity: i64;
    count: i64;
}

fn hash_djb2(s: *String) -> i64 {
    if (s == 0 || s.data == 0) { ret 0; }

    var hash: i64 = 5381;
    var i: i64 = 0;
    var ptr: *u8 = s.data;

    while (i < s.len) {
        var c: u8 = *ptr;
        hash = (hash * 32 + hash) + cast(i64) c;
        ptr = ptr + 1;
        i = i + 1;
    }

    if (hash < 0) {
        ret -hash;
    }
    ret hash;
}

fn hash_map_new(capacity: i64) -> *HashMap {
    var map: *HashMap = alloc(24);
    map.capacity = capacity;
    map.count = 0;
    map.buckets = vec_ptr_new(capacity);

    var i: i64 = 0;
    while (i < capacity) {
        vec_ptr_push(map.buckets, 0);
        i = i + 1;
    }

    ret map;
}

fn hash_map_put(map: *HashMap, key: *String, value: rawptr) {
    if (map == 0 || key == 0) { ret; }

    var h: i64 = hash_djb2(key);
    var index: i64 = h % map.capacity;

    var head: *HashNode = cast(*HashNode) vec_ptr_get(map.buckets, index);
    var curr: *HashNode = head;

    while (curr != 0) {
        if (string_eq(curr.key, key) == 1) {
            curr.value = value;
            ret;
        }
        curr = curr.next;
    }

    var node: *HashNode = alloc(32);
    node.key = key;
    node.value = value;
    node.hash = h;
    node.next = head;

    vec_ptr_set(map.buckets, index, node);
    map.count = map.count + 1;
}

fn hash_map_get(map: *HashMap, key: *String) -> rawptr {
    if (map == 0 || key == 0) { ret 0; }

    var h: i64 = hash_djb2(key);
    var index: i64 = h % map.capacity;

    var curr: *HashNode = cast(*HashNode) vec_ptr_get(map.buckets, index);

    while (curr != 0) {
        if (string_eq(curr.key, key) == 1) {
            ret curr.value;
        }
        curr = curr.next;
    }

    ret 0;
}