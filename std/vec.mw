@no_main

@import("mem.mw")

@drop(vec_ptr_release)
struct VecPtr {
    data: rawptr;
    len: i64;
    cap: i64;
}

// The vector owns its buffer: dropping the `^VecPtr` frees both.
@trusted fn vec_ptr_new(initial_cap: i64) -> ^VecPtr {
    var v: ^VecPtr = cast(^VecPtr) alloc(24);
    if (initial_cap < 4) {
        initial_cap = 4;
    }
    v.data = alloc(initial_cap * 8);
    v.len = 0;
    v.cap = initial_cap;
    ret v;
}

@trusted fn vec_ptr_push(v: *VecPtr, item: rawptr) {
    if (v.len >= v.cap) {
        var new_cap: i64 = v.cap * 2;
        v.data = realloc(v.data, new_cap * 8);
        v.cap = new_cap;
    }

    var slot: *rawptr = v.data + (v.len * 8);
    *slot = item;

    v.len = v.len + 1;
}

@trusted fn vec_ptr_get(v: *VecPtr, index: i64) -> rawptr {
    if (index < 0) { ret 0; }
    if (index >= v.len) { ret 0; }

    var slot: *rawptr = v.data + (index * 8);
    ret *slot;
}

// Run by the drop: frees the buffer, then the struct itself is freed.
fn vec_ptr_release(v: &mut VecPtr) {
    dealloc(v.data);
}

// Frees a vector: it takes the owner, which is dropped here.
fn vec_ptr_free(v: ^VecPtr) { }

// Frees a vector that is only known by a plain pointer (a field, a global): the caller was its owner.
@trusted fn vec_ptr_destroy(v: *VecPtr) { vec_ptr_free(cast(^VecPtr) v); }

@trusted fn vec_ptr_set(vec: *VecPtr, index: i64, value: rawptr) {
    if (vec == 0) { ret; }
    if (index < 0 || index >= vec.len) { ret; }

    var target: *rawptr = cast(*rawptr) (cast(i64) vec.data + (index * 8));
    *target = value;
}

@drop(vec_i64_release)
struct VecI64 {
    data: rawptr;
    len: i64;
    cap: i64;
}

@trusted fn vec_i64_new(initial_cap: i64) -> ^VecI64 {
    var v: ^VecI64 = cast(^VecI64) alloc(24);
    if (initial_cap < 4) {
        initial_cap = 4;
    }
    v.data = alloc(initial_cap * 8);
    v.len = 0;
    v.cap = initial_cap;
    ret v;
}

@trusted fn vec_i64_push(v: *VecI64, val: i64) {
    if (v.len >= v.cap) {
        var new_cap: i64 = v.cap * 2;
        v.data = realloc(v.data, new_cap * 8);
        v.cap = new_cap;
    }

    var slot: *i64 = v.data + (v.len * 8);
    *slot = val;

    v.len = v.len + 1;
}

@trusted fn vec_i64_get(v: *VecI64, index: i64) -> i64 {
    if (index < 0) { ret 0; }
    if (index >= v.len) { ret 0; }

    var slot: *i64 = v.data + (index * 8);
    ret *slot;
}

fn vec_i64_release(v: &mut VecI64) {
    dealloc(v.data);
}

fn vec_i64_free(v: ^VecI64) { }

@trusted fn vec_i64_destroy(v: *VecI64) { vec_i64_free(cast(^VecI64) v); }

@trusted fn vec_i64_set(v: *VecI64, index: i64, val: i64) {
    if (index < 0 || index >= v.len) { ret; }
    var slot: *i64 = v.data + (index * 8);
    *slot = val;
}

fn vec_ptr_len(v: *VecPtr) -> i64 {
    ret v.len;
}

fn vec_i64_len(v: *VecI64) -> i64 {
    ret v.len;
}

// Removes and returns the last element (0 when empty).
fn vec_ptr_pop(v: *VecPtr) -> rawptr {
    if (v.len == 0) { ret 0; }
    v.len = v.len - 1;
    ret vec_ptr_get(v, v.len);
}

fn vec_i64_pop(v: *VecI64) -> i64 {
    if (v.len == 0) { ret 0; }
    v.len = v.len - 1;
    ret vec_i64_get(v, v.len);
}

// In-place ascending sort (heap sort: no recursion, no extra memory).
fn vec_i64_sort(v: *VecI64) {
    var n: i64 = v.len;
    var start: i64 = n / 2 - 1;
    while start >= 0 {
        vec_i64_sift(v, start, n);
        start = start - 1;
    }
    var end: i64 = n - 1;
    while end > 0 {
        var t: i64 = vec_i64_get(v, 0);
        vec_i64_set(v, 0, vec_i64_get(v, end));
        vec_i64_set(v, end, t);
        vec_i64_sift(v, 0, end);
        end = end - 1;
    }
}

fn vec_i64_sift(v: *VecI64, root: i64, n: i64) {
    while 1 == 1 {
        var child: i64 = root * 2 + 1;
        if child >= n {
            ret;
        }
        if child + 1 < n && vec_i64_get(v, child) < vec_i64_get(v, child + 1) {
            child = child + 1;
        }
        if vec_i64_get(v, root) >= vec_i64_get(v, child) {
            ret;
        }
        var t: i64 = vec_i64_get(v, root);
        vec_i64_set(v, root, vec_i64_get(v, child));
        vec_i64_set(v, child, t);
        root = child;
    }
}
