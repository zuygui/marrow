@no_main

@import("heap.mw")
@import("text.mw")
@import("fs.mw")
@import("rand.mw")

// TCP and UDP over IPv4, plus a small DNS resolver. No libc: every function
// is built on the socket calls of the platform layer.
//
// Addresses are `u32` values in host order (a.b.c.d -> a<<24 | b<<16 | c<<8 | d).
// Functions returning `i64` give a file descriptor or a negative errno.

struct Timeval {
    sec: i64;
    usec: i64;
}

fn ip4(a: i64, b: i64, c: i64, d: i64) -> u32 {
    ret cast(u32) ((a << 24) | (b << 16) | (c << 8) | d);
}

fn ip4_octet(ip: u32, index: i64) -> i64 {
    ret cast(i64) ((ip >> cast(i64) (24 - index * 8)) & 255);
}

// Parses "a.b.c.d" (exactly four decimal parts, each 0..255).
@unsafe fn ip4_parse(s: *u8, out: *u32) -> bool {
    var value: i64 = 0;
    var part: i64 = 0;
    var digits: i64 = 0;
    var parts: i64 = 0;
    var i: i64 = 0;
    while 1 == 1 {
        var c: u8 = s[i];
        if c >= 48 && c <= 57 {
            part = part * 10 + cast(i64) (c - 48);
            digits = digits + 1;
            if part > 255 || digits > 3 {
                ret false;
            }
        } else {
            if (c == 46 || c == 0) && digits > 0 {
                value = (value << 8) | part;
                parts = parts + 1;
                part = 0;
                digits = 0;
                if c == 0 {
                    if parts != 4 {
                        ret false;
                    }
                    *out = cast(u32) value;
                    ret true;
                }
                if parts == 4 {
                    ret false;
                }
            } else {
                ret false;
            }
        }
        i = i + 1;
    }
    ret false;
}

// "a.b.c.d" into `buf` (at most 15 bytes); returns the length.
fn ip4_format(buf: *u8, ip: u32) -> i64 {
    var len: i64 = 0;
    var i: i64 = 0;
    while i < 4 {
        len = len + fmt_u64(buf + len, cast(u64) ip4_octet(ip, i), 10);
        if i < 3 {
            buf[len] = 46;
            len = len + 1;
        }
        i = i + 1;
    }
    ret len;
}

// ---- sockets ------------------------------------------------------------------

fn net_close(fd: i64) {
    if fd >= 0 {
        sys_close(cast(i32) fd);
    }
}

@unsafe fn net_set_timeout_ms(fd: i64, ms: i64) -> i64 {
    var tv: Timeval = Timeval { sec: ms / 1000, usec: (ms % 1000) * 1000 };
    var a: i64 = sys_setsockopt(cast(i32) fd, SOL_SOCKET, SO_RCVTIMEO, cast(*u8) raw tv, 16);
    var b: i64 = sys_setsockopt(cast(i32) fd, SOL_SOCKET, SO_SNDTIMEO, cast(*u8) raw tv, 16);
    if a < 0 {
        ret a;
    }
    ret b;
}

@unsafe fn net_set_nodelay(fd: i64) -> i64 {
    var one: i32 = 1;
    ret sys_setsockopt(cast(i32) fd, IPPROTO_TCP, TCP_NODELAY, cast(*u8) raw one, 4);
}

fn net_sockaddr(buf: *u8, ip: u32, port: i64) {
    sys_sockaddr_in(buf, ip4_octet(ip, 0), ip4_octet(ip, 1), ip4_octet(ip, 2), ip4_octet(ip, 3), port);
}

fn tcp_connect_ip(ip: u32, port: i64) -> i64 {
    var fd: i64 = sys_socket(AF_INET, SOCK_STREAM, 0);
    if fd < 0 {
        ret fd;
    }
    var addr: *u8 = heap_alloc(16);
    net_sockaddr(addr, ip, port);
    var r: i64 = sys_connect(cast(i32) fd, addr, 16);
    heap_free(addr);
    if r < 0 {
        sys_close(cast(i32) fd);
        ret r;
    }
    net_set_nodelay(fd);
    ret fd;
}

// Listens on `ip:port` (port 0 picks a free one; see `net_local_port`).
@unsafe fn tcp_listen_on(ip: u32, port: i64, backlog: i64) -> i64 {
    var fd: i64 = sys_socket(AF_INET, SOCK_STREAM, 0);
    if fd < 0 {
        ret fd;
    }
    var one: i32 = 1;
    sys_setsockopt(cast(i32) fd, SOL_SOCKET, SO_REUSEADDR, cast(*u8) raw one, 4);
    var addr: *u8 = heap_alloc(16);
    net_sockaddr(addr, ip, port);
    var r: i64 = sys_bind(cast(i32) fd, addr, 16);
    heap_free(addr);
    if r < 0 {
        sys_close(cast(i32) fd);
        ret r;
    }
    r = sys_listen(cast(i32) fd, cast(i32) backlog);
    if r < 0 {
        sys_close(cast(i32) fd);
        ret r;
    }
    ret fd;
}

// All interfaces.
fn tcp_listen(port: i64, backlog: i64) -> i64 {
    ret tcp_listen_on(0, port, backlog);
}

// Accepts one connection. `peer` (may be null) receives the client address.
@unsafe fn tcp_accept(fd: i64, peer: *u32) -> i64 {
    var addr: *u8 = heap_alloc(32);
    var len: i32 = 32;
    var c: i64 = sys_accept(cast(i32) fd, addr, raw len);
    while c == -4 {
        len = 32;
        c = sys_accept(cast(i32) fd, addr, raw len);
    }
    if c >= 0 && peer != null {
        var off: i64 = 4;
        *peer = ip4(cast(i64) addr[off], cast(i64) addr[off + 1], cast(i64) addr[off + 2], cast(i64) addr[off + 3]);
    }
    heap_free(addr);
    if c >= 0 {
        net_set_nodelay(c);
    }
    ret c;
}

// Port a socket is bound to (host order), or a negative errno.
@unsafe fn net_local_port(fd: i64) -> i64 {
    var addr: *u8 = heap_alloc(32);
    var len: i32 = 32;
    var r: i64 = sys_getsockname(cast(i32) fd, addr, raw len);
    if r < 0 {
        heap_free(addr);
        ret r;
    }
    var port: i64 = ((cast(i64) addr[2]) << 8) | (cast(i64) addr[3]);
    heap_free(addr);
    ret port;
}

// Reads up to `n` bytes (0 means the peer closed the connection).
fn net_read(fd: i64, buf: *u8, n: i64) -> i64 {
    var r: i64 = sys_recv(cast(i32) fd, buf, cast(u64) n);
    while r == -4 {
        r = sys_recv(cast(i32) fd, buf, cast(u64) n);
    }
    ret r;
}

// Sends every byte. Returns 0 on success or a negative errno.
fn net_write_all(fd: i64, buf: *u8, n: i64) -> i64 {
    var done: i64 = 0;
    while done < n {
        var r: i64 = sys_send(cast(i32) fd, buf + done, cast(u64) (n - done));
        if r == -4 {
            r = 0;
        } else {
            if r < 0 {
                ret r;
            }
        }
        done = done + r;
    }
    ret 0;
}

fn net_write_str(fd: i64, s: *u8) -> i64 {
    ret net_write_all(fd, s, str_len(s));
}

// Stops sending (the peer then reads end-of-file) but keeps reading open.
fn net_shutdown_write(fd: i64) {
    sys_shutdown(cast(i32) fd, 1);
}

// ---- UDP ------------------------------------------------------------------------

fn udp_socket() -> i64 {
    ret sys_socket(AF_INET, SOCK_DGRAM, 0);
}

fn udp_send_to(fd: i64, ip: u32, port: i64, buf: *u8, n: i64) -> i64 {
    var addr: *u8 = heap_alloc(16);
    net_sockaddr(addr, ip, port);
    var r: i64 = sys_sendto(cast(i32) fd, buf, cast(u64) n, addr, 16);
    heap_free(addr);
    ret r;
}

fn udp_recv(fd: i64, buf: *u8, n: i64) -> i64 {
    ret sys_recvfrom(cast(i32) fd, buf, cast(u64) n);
}

// ---- DNS ------------------------------------------------------------------------

fn be16_at(buf: *u8, i: i64) -> i64 {
    ret ((cast(i64) buf[i]) << 8) | (cast(i64) buf[i + 1]);
}

// Skips a (possibly compressed) domain name; returns the index after it.
fn dns_skip_name(buf: *u8, len: i64, i: i64) -> i64 {
    while i < len {
        var c: i64 = cast(i64) buf[i];
        if c == 0 {
            ret i + 1;
        }
        if (c & 192) == 192 {
            ret i + 2;
        }
        i = i + 1 + c;
    }
    ret -1;
}

// Builds an A query for `name` into `buf`; returns its length or -1.
fn dns_build_query(buf: *u8, name: *u8, id: i64) -> i64 {
    buf[0] = cast(u8) (id >> 8);
    buf[1] = cast(u8) (id & 255);
    buf[2] = 1;
    buf[3] = 0;
    buf[4] = 0;
    buf[5] = 1;
    buf[6] = 0;
    buf[7] = 0;
    buf[8] = 0;
    buf[9] = 0;
    buf[10] = 0;
    buf[11] = 0;
    var pos: i64 = 12;
    var i: i64 = 0;
    while 1 == 1 {
        var start: i64 = i;
        while name[i] != 46 && name[i] != 0 {
            i = i + 1;
        }
        var n: i64 = i - start;
        if n == 0 || n > 63 {
            ret -1;
        }
        buf[pos] = cast(u8) n;
        mem_copy(buf + pos + 1, name + start, n);
        pos = pos + 1 + n;
        if name[i] == 0 {
            buf[pos] = 0;
            buf[pos + 1] = 0;
            buf[pos + 2] = 1;
            buf[pos + 3] = 0;
            buf[pos + 4] = 1;
            ret pos + 5;
        }
        i = i + 1;
    }
    ret -1;
}

// Extracts the first IPv4 address of a response to our query.
@unsafe fn dns_parse_response(buf: *u8, len: i64, id: i64, out: *u32) -> bool {
    if len < 12 || be16_at(buf, 0) != id {
        ret false;
    }
    if (cast(i64) buf[3]) & 15 != 0 {
        ret false;
    }
    var qd: i64 = be16_at(buf, 4);
    var an: i64 = be16_at(buf, 6);
    var i: i64 = 12;
    var q: i64 = 0;
    while q < qd {
        i = dns_skip_name(buf, len, i);
        if i < 0 {
            ret false;
        }
        i = i + 4;
        q = q + 1;
    }
    var a: i64 = 0;
    while a < an {
        i = dns_skip_name(buf, len, i);
        if i < 0 || i + 10 > len {
            ret false;
        }
        var kind: i64 = be16_at(buf, i);
        var rdlen: i64 = be16_at(buf, i + 8);
        i = i + 10;
        if i + rdlen > len {
            ret false;
        }
        if kind == 1 && rdlen == 4 {
            *out = ip4(cast(i64) buf[i], cast(i64) buf[i + 1], cast(i64) buf[i + 2], cast(i64) buf[i + 3]);
            ret true;
        }
        i = i + rdlen;
        a = a + 1;
    }
    ret false;
}

// First `nameserver` line of /etc/resolv.conf that is an IPv4 address.
fn dns_nameserver(out: *u32) -> bool {
    var conf: ^String = read_to_string("/etc/resolv.conf");
    if conf == 0 {
        ret false;
    }
    var lines: ^VecPtr = str_split(conf.data, 10);
    var i: i64 = 0;
    var found: bool = false;
    while i < lines.len && !found {
        var line: *u8 = cast(*u8) vec_ptr_get(lines, i);
        if str_starts_with(line, "nameserver") {
            var rest: *u8 = str_trim(line + 10);
            found = ip4_parse(rest, out);
            dealloc(rest);
        }
        i = i + 1;
    }
    string_free(conf);
    ret found;
}

// Looks `name` up in /etc/hosts (IPv4 entries only).
@unsafe fn dns_from_hosts(name: *u8, out: *u32) -> bool {
    var hosts: ^String = read_to_string("/etc/hosts");
    if hosts == 0 {
        ret false;
    }
    var lines: ^VecPtr = str_split(hosts.data, 10);
    var i: i64 = 0;
    var found: bool = false;
    while i < lines.len && !found {
        var line: *u8 = cast(*u8) vec_ptr_get(lines, i);
        var hash: i64 = str_find_char(line, 35);
        var clean: *u8 = line;
        if hash >= 0 {
            clean = str_dup_n(line, hash);
        }
        var fields: ^VecPtr = str_split(clean, 32);
        var ip: u32 = 0;
        var j: i64 = 0;
        var have_ip: bool = false;
        while j < fields.len && !found {
            var f: *u8 = cast(*u8) vec_ptr_get(fields, j);
            var t: *u8 = str_trim(f);
            if t[0] != 0 {
                if !have_ip {
                    have_ip = ip4_parse(t, raw ip);
                    if !have_ip {
                        j = fields.len;
                    }
                } else {
                    if str_eq_nocase(t, name) {
                        *out = ip;
                        found = true;
                    }
                }
            }
            dealloc(t);
            j = j + 1;
        }
        i = i + 1;
    }
    string_free(hosts);
    ret found;
}

// Resolves a host name or dotted address to IPv4. Tries, in order: literal
// address, "localhost", /etc/hosts, then a UDP query to the first IPv4
// nameserver of /etc/resolv.conf.
@unsafe fn dns_resolve(name: *u8, out: *u32) -> bool {
    if ip4_parse(name, out) {
        ret true;
    }
    if str_eq_nocase(name, "localhost") {
        *out = ip4(127, 0, 0, 1);
        ret true;
    }
    if dns_from_hosts(name, out) {
        ret true;
    }
    var server: u32 = 0;
    if !dns_nameserver(raw server) {
        ret false;
    }
    var fd: i64 = udp_socket();
    if fd < 0 {
        ret false;
    }
    net_set_timeout_ms(fd, 2000);
    var query: *u8 = heap_alloc(512);
    var reply: *u8 = heap_alloc(1500);
    var id: i64 = cast(i64) (random_u64() & 65535);
    var qlen: i64 = dns_build_query(query, name, id);
    var ok: bool = false;
    var attempt: i64 = 0;
    while qlen > 0 && attempt < 3 && !ok {
        if udp_send_to(fd, server, 53, query, qlen) >= 0 {
            var n: i64 = udp_recv(fd, reply, 1500);
            if n > 0 {
                ok = dns_parse_response(reply, n, id, out);
                if !ok {
                    attempt = 3;
                }
            }
        }
        attempt = attempt + 1;
    }
    heap_free(query);
    heap_free(reply);
    sys_close(cast(i32) fd);
    ret ok;
}

// Resolves `host` and connects.
@unsafe fn tcp_connect(host: *u8, port: i64) -> i64 {
    var ip: u32 = 0;
    if !dns_resolve(host, raw ip) {
        ret -2;
    }
    ret tcp_connect_ip(ip, port);
}
