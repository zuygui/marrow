@no_main

@import("string.mrw")
@import("io.mrw")

@extern("fopen")  fn c_fopen(path: *u8, mode: *u8) -> rawptr;
@extern("fclose") fn c_fclose(stream: rawptr) -> i32;
@extern("fseek")  fn c_fseek(stream: rawptr, offset: i64, whence: i32) -> i32;
@extern("ftell")  fn c_ftell(stream: rawptr) -> i64;
@extern("fread")  fn c_fread(ptr: rawptr, size: i64, nmemb: i64, stream: rawptr) -> i64;
@extern("fwrite") fn c_fwrite(ptr: rawptr, size: i64, nmemb: i64, stream: rawptr) -> i64;

fn file_open_read(path: *u8) -> rawptr {
    var mode: *u8 = "rb";
    ret c_fopen(path, mode);
}

fn file_open_write(path: *u8) -> rawptr {
    var mode: *u8 = "wb";
    ret c_fopen(path, mode);
}

fn file_close(handle: rawptr) {
    if (handle != 0) {
        c_fclose(handle);
    }
}

fn file_get_size(handle: rawptr) -> i64 {
    if (handle == 0) { ret 0; }

    var offset_end: i64 = 0;
    var offset_start: i64 = 0;
    var SEEK_END: i32 = 2;
    var SEEK_SET: i32 = 0;

    c_fseek(handle, offset_end, SEEK_END);
    var size: i64 = c_ftell(handle);
    c_fseek(handle, offset_start, SEEK_SET);

    ret size;
}

fn read_to_string(path: *u8) -> *String {
    var f: rawptr = file_open_read(path);
    if (f == 0) {
        eprint("[ERREUR FS] Impossible d'ouvrir le fichier : ");
        eprintln(path);
        ret 0;
    }

    var size: i64 = file_get_size(f);

    var alloc_size: i64 = size;
    if (alloc_size <= 0) {
        alloc_size = 16;
    }

    var content: *String = string_new(alloc_size);
    if (content == 0) {
        file_close(f);
        ret 0;
    }

    if (content.data == 0) {
        file_close(f);
        ret 0;
    }

    var read_bytes: i64 = 0;
    if (size > 0) {
        read_bytes = c_fread(content.data, 1, size, f);
    }
    file_close(f);

    content.len = read_bytes;

    var null_slot: *u8 = content.data + read_bytes;
    *null_slot = 0;

    ret content;
}

fn write_string_to_file(path: *u8, content: *String) -> i32 {
    if (content == 0) { ret 0; }

    var f: rawptr = file_open_write(path);
    if (f == 0) {
        eprint("fs err unable to create file : ");
        eprintln(path);
        ret 0;
    }

    if (content.data != 0 && content.len > 0) {
        c_fwrite(content.data, 1, content.len, f);
    }

    file_close(f);
    ret 1;
}