@no_main

@import("heap.mw")

// Thin, stable names over the libc-free allocator (std/heap.mw) and the
// memory primitives (std/raw.mw).

fn alloc(size: i64) -> *u8 {
    ret heap_alloc(size);
}

@unsafe fn realloc(ptr: *u8, new_size: i64) -> *u8 {
    ret heap_realloc(ptr, new_size);
}

@unsafe fn dealloc(ptr: *u8) {
    heap_free(ptr);
}

@unsafe fn mem_copy(dest: *u8, src: *u8, count: i64) {
    raw_copy(dest, src, count);
}

@unsafe fn mem_zero(dest: *u8, count: i64) {
    raw_zero(dest, count);
}

@drop(arena_release)
struct Arena {
    buffer: *u8;
    capacity: i64;
    offset: i64;
}

@trusted fn arena_new(capacity: i64) -> ^Arena {
    var a: ^Arena = cast(^Arena) alloc(24);
    a.buffer = alloc(capacity);
    a.capacity = capacity;
    a.offset = 0;
    ret a;
}

@trusted fn arena_alloc(a: *Arena, size: i64) -> *u8 {
    if (a.offset + size > a.capacity) {
        ret 0;
    }

    var ptr: *u8 = a.buffer + a.offset;
    a.offset = a.offset + size;
    ret ptr;
}

fn arena_reset(a: *Arena) {
    a.offset = 0;
}

// Run by the drop: frees the buffer, then the struct is freed.
@trusted fn arena_release(a: &mut Arena) {
    dealloc(a.buffer);
}

// Frees an arena: it takes the owner, which is dropped here.
fn arena_free(a: ^Arena) { }

// Frees an arena that is only known by a plain pointer: the caller was its owner.
@unsafe fn arena_destroy(a: *Arena) { arena_free(cast(^Arena) a); }
