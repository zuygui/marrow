@no_main

@import("text.mw")
@import("os.mw")

// Command-line arguments and environment variables.  Call env_init from main
// first:
//
//     @export fn main(argc: i32, argv: rawptr) -> i32 {
//         env_init(argc, argv);
//         ... arg_get(1) ... env_get("HOME") ...
//
// The environment block is read from the stack layout every System V style
// entry point provides (envp follows argv), so this works on Linux and macOS
// without libc.  On Windows it is built from GetEnvironmentStringsA.

var ENV_ARGC: i64 = 0;
var ENV_ARGV: i64 = 0;
var ENV_OK: i64 = 0;

fn env_init(argc: i32, argv: rawptr) {
    ENV_ARGC = cast(i64) argc;
    ENV_ARGV = cast(i64) argv;
    ENV_OK = 1;
    SYS_ENVP = cast(i64) env_block();
}

fn arg_count() -> i64 { ret ENV_ARGC; }

// The i-th argument (0 is the program name), or null when out of range.
@trusted fn arg_get(i: i64) -> *u8 {
    if ENV_OK == 0 || i < 0 || i >= ENV_ARGC { ret null; }
    var a: *i64 = cast(*i64) ENV_ARGV;
    ret cast(*u8) a[i];
}

var ENV_BLOCK: i64 = 0;

// The platform layer knows where the environment lives (sys_env_block): right
// after argv on Linux and macOS, a block built from the process environment
// on Windows (the C runtime does not put envp next to argv there).
@trusted fn env_block() -> *i64 {
    if ENV_OK == 0 { ret null; }
    if ENV_BLOCK == 0 { ENV_BLOCK = cast(i64) sys_env_block(ENV_ARGC, ENV_ARGV); }
    ret cast(*i64) ENV_BLOCK;
}

// Number of "NAME=value" entries.
@trusted fn env_count() -> i64 {
    var e: *i64 = env_block();
    if e == null { ret 0; }
    var n: i64 = 0;
    while e[n] != 0 { n = n + 1; }
    ret n;
}

// The i-th "NAME=value" entry, or null.
@trusted fn env_at(i: i64) -> *u8 {
    if i < 0 || i >= env_count() { ret null; }
    var e: *i64 = env_block();
    ret cast(*u8) e[i];
}

// Value of the variable (a pointer into the environment block), or null.
@trusted fn env_get(name: *u8) -> *u8 {
    var nl: i64 = 0;
    while name[nl] != 0 { nl = nl + 1; }
    var e: *i64 = env_block();
    if e == null || nl == 0 { ret null; }
    var i: i64 = 0;
    while e[i] != 0 {
        var entry: *u8 = cast(*u8) e[i];
        var k: i64 = 0;
        while k < nl && entry[k] == name[k] { k = k + 1; }
        if k == nl && entry[nl] == 61 { ret entry + nl + 1; }
        i = i + 1;
    }
    ret null;
}

// Like env_get but returns `fallback` when the variable is not set.
fn env_get_or(name: *u8, fallback: *u8) -> *u8 {
    var v: *u8 = env_get(name);
    if v == null { ret fallback; }
    ret v;
}
