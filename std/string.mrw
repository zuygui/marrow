@no_main

@import("mem.mrw")

str_len :: (*u8 s) -> i64 {
    *u8 ptr = s;
    i64 len = 0;
    while (*ptr != 0) {
        len = len + 1;
        ptr = ptr + 1;
    }
    ret len;
};

str_eq :: (*u8 s1, *u8 s2) -> i8 {
    *u8 p1 = s1;
    *u8 p2 = s2;
    while (*p1 != 0) {
        if (*p1 != *p2) {
            ret 0;
        }
        p1 = p1 + 1;
        p2 = p2 + 1;
    }
    if (*p2 == 0) {
        ret 1;
    }
    ret 0;
};

is_digit :: (u8 c) -> i8 {
    if (c >= 48) { 
        if (c <= 57) {
            ret 1;
        }
    }
    ret 0;
};

is_alpha :: (u8 c) -> i8 {
    if (c >= 97) {
        if (c <= 122) {
            ret 1;
        }
    }
    if (c >= 65) {
        if (c <= 90) {
            ret 1;
        }
    }
    if (c == 95) {
        ret 1;
    }
    ret 0;
};

is_space :: (u8 c) -> i8 {
    if (c == 32) { ret 1; }
    if (c == 9)  { ret 1; }
    if (c == 10) { ret 1; }
    if (c == 13) { ret 1; }
    ret 0;
};

String :: struct {
    *u8 data;  
    i64 len;    
    i64 cap; 
};

*String string_new :: (i64 initial_cap) {
    *String s = alloc(24);

    if (initial_cap < 8) {
        initial_cap = 8;
    }

    s.data = alloc(initial_cap);
    s.len = 0;
    s.cap = initial_cap;
    *(s.data) = 0;
    ret s;
};

string_from :: (*u8 raw_str) -> *String {
    i64 length = str_len(raw_str);
    *String s = string_new(length + 1);
    
    mem_copy(s.data, raw_str, length);
    s.len = length;
    
    *u8 end_ptr = s.data + length;
    *end_ptr = 0;
    
    ret s;
};

string_push_char :: (*String s, u8 c) {
    if (s.len + 1 >= s.cap) {
        i64 new_cap = s.cap * 2;
        s.data = realloc(s.data, new_cap);
        s.cap = new_cap;
    }

    *u8 char_ptr = s.data + s.len;
    *char_ptr = c;
    
    s.len = s.len + 1;
    
    *u8 null_ptr = s.data + s.len;
    *null_ptr = 0;
};

string_push_str :: (*String s, *u8 raw_str) {
    i64 extra_len = str_len(raw_str);
    
    if (s.len + extra_len >= s.cap) {
        i64 new_cap = (s.len + extra_len) * 2;
        s.data = realloc(s.data, new_cap);
        s.cap = new_cap;
    }

    *u8 dest_ptr = s.data + s.len;
    mem_copy(dest_ptr, raw_str, extra_len);
    
    s.len = s.len + extra_len;
    
    *u8 null_ptr = s.data + s.len;
    *null_ptr = 0;
};


string_free :: (*String s) {
    dealloc(s.data);
    dealloc(s);
};

string_eq :: (*String a, *String b) -> i32 {
    if (a == 0 || b == 0) { ret 0; }
    if (a == b) { ret 1; } // Même pointeur
    if (a.len != b.len) { ret 0; } 

    ret str_eq(a.data, b.data);
};

string_cmp :: (*String a, *String b) -> i32 {
    if (a == 0 || b == 0) { ret 0; }
    if (a.data == 0 || b.data == 0) { ret 0; }

    i64 min_len = a.len;
    if (b.len < min_len) {
        min_len = b.len;
    }

    i64 i = 0;
    while (i < min_len) {
        *u8 ptr_a = a.data + i;
        *u8 ptr_b = b.data + i;
        u8 ca = *ptr_a;
        u8 cb = *ptr_b;

        if (ca < cb) { ret -1; }
        if (ca > cb) { ret 1; }

        i = i + 1;
    }

    if (a.len < b.len) { ret -1; }
    if (a.len > b.len) { ret 1; }

    ret 0;
};