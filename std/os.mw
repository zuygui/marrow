@no_main

// Raw Linux system calls, no libc involved. The numbers and the `syscall`
// stub are picked per target (`--target`, default: the host).
// Compile programs that use only this module with `marrow --nostdlib`.

// `sys_read`, `sys_write`, `sys_close`, `sys_mmap_anon`, `sys_munmap`,
// `sys_exit` and `syscall` come from the platform layer (std/platform/).
@import("platform/{target}")

fn os_strlen(s: *u8) -> u64 {
    var n: u64 = 0;
    while s[n] != 0 {
        n = n + 1;
    }
    ret n;
}

fn os_print(s: *u8) {
    sys_write(1, s, os_strlen(s));
}

fn os_println(s: *u8) {
    os_print(s);
    sys_write(1, "\n", 1);
}

fn os_eprint(s: *u8) {
    sys_write(2, s, os_strlen(s));
}
