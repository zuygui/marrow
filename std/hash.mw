@no_main

@import("raw.mw")
@import("heap.mw")

// Cryptographic hashes (SHA-1, SHA-256, SHA-384, SHA-512), HMAC, HKDF and
// PBKDF2.  Everything is one-shot: pass the whole message and an output
// buffer of `hash_size(alg)` bytes.  No libc, no function pointers.

var HASH_SHA1: i64 = 1;
var HASH_SHA256: i64 = 2;
var HASH_SHA384: i64 = 3;
var HASH_SHA512: i64 = 4;

fn hash_size(alg: i64) -> i64 {
    if alg == 1 { ret 20; }
    if alg == 2 { ret 32; }
    if alg == 3 { ret 48; }
    if alg == 4 { ret 64; }
    ret 0;
}

fn hash_block_size(alg: i64) -> i64 {
    if alg == 3 || alg == 4 { ret 128; }
    ret 64;
}

fn rotr32(x: u32, n: u32) -> u32 { ret (x >> n) | (x << (32 - n)); }
fn rotl32(x: u32, n: u32) -> u32 { ret (x << n) | (x >> (32 - n)); }
fn rotr64(x: u64, n: u64) -> u64 { ret (x >> n) | (x << (64 - n)); }

@trusted fn load_be32(p: *u8) -> u32 {
    ret ((cast(u32) p[0]) << 24) | ((cast(u32) p[1]) << 16) | ((cast(u32) p[2]) << 8) | (cast(u32) p[3]);
}
@trusted fn store_be32(p: *u8, v: u32) {
    p[0] = cast(u8) (v >> 24);
    p[1] = cast(u8) (v >> 16);
    p[2] = cast(u8) (v >> 8);
    p[3] = cast(u8) v;
}
@trusted fn load_be64(p: *u8) -> u64 {
    ret ((cast(u64) load_be32(p)) << 32) | (cast(u64) load_be32(p + 4));
}
@trusted fn store_be64(p: *u8, v: u64) {
    store_be32(p, cast(u32) (v >> 32));
    store_be32(p + 4, cast(u32) v);
}

