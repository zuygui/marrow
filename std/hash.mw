// ---------------------------------------------------------------- SHA-256

@trusted fn sha256_block(h: *u32, k: *u32, w: *u32, p: *u8) {
    var i: i64 = 0;
    while i < 16 { w[i] = load_be32(p + i * 4); i = i + 1; }
    while i < 64 {
        var a: u32 = w[i - 15];
        var b: u32 = w[i - 2];
        var s0: u32 = rotr32(a, 7) ^ rotr32(a, 18) ^ (a >> 3);
        var s1: u32 = rotr32(b, 17) ^ rotr32(b, 19) ^ (b >> 10);
        w[i] = w[i - 16] + s0 + w[i - 7] + s1;
        i = i + 1;
    }
    var a: u32 = h[0];
    var b: u32 = h[1];
    var c: u32 = h[2];
    var d: u32 = h[3];
    var e: u32 = h[4];
    var f: u32 = h[5];
    var g: u32 = h[6];
    var hh: u32 = h[7];
    i = 0;
    while i < 64 {
        var s1: u32 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
        var ch: u32 = (e & f) ^ ((~e) & g);
        var t1: u32 = hh + s1 + ch + k[i] + w[i];
        var s0: u32 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
        var mj: u32 = (a & b) ^ (a & c) ^ (b & c);
        var t2: u32 = s0 + mj;
        hh = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
        i = i + 1;
    }
    h[0] = h[0] + a; h[1] = h[1] + b; h[2] = h[2] + c; h[3] = h[3] + d;
    h[4] = h[4] + e; h[5] = h[5] + f; h[6] = h[6] + g; h[7] = h[7] + hh;
}

// Feeds `len` bytes, appends the padding for a `block`-byte block hash with an
// `lenbytes`-byte big-endian bit length, and returns the number of tail bytes
// written to `tail` (a multiple of `block`).
@trusted fn hash_tail(data: *u8, len: i64, block: i64, lenbytes: i64, tail: *u8, big: bool) -> i64 {
    var full: i64 = (len / block) * block;
    var rem: i64 = len - full;
    raw_zero(tail, block * 2);
    raw_copy(tail, data + full, rem);
    tail[rem] = 128;
    var total: i64 = block;
    if rem + 1 + lenbytes > block { total = block * 2; }
    var bits: u64 = (cast(u64) len) << 3;
    var hi: u64 = (cast(u64) len) >> 61;
    if big {
        store_be64(tail + total - 8, bits);
        if lenbytes == 16 { store_be64(tail + total - 16, hi); }
    } else {
        // little endian 64-bit length (unused by SHA-1/2, kept for completeness)
        var j: i64 = 0;
        while j < 8 { tail[total - 8 + j] = cast(u8) (bits >> (cast(u64) (j * 8))); j = j + 1; }
    }
    ret total;
}

@trusted fn sha256(data: *u8, len: i64, out: *u8) {
    var h: *u32 = cast(*u32) heap_alloc(32);
    var k: *u32 = cast(*u32) heap_alloc(256);
    var w: *u32 = cast(*u32) heap_alloc(256);
    var tail: *u8 = heap_alloc(128);
    sha256_h0_init(h);
    sha256_k_init(k);
    var full: i64 = (len / 64) * 64;
    var off: i64 = 0;
    while off < full { sha256_block(h, k, w, data + off); off = off + 64; }
    var total: i64 = hash_tail(data, len, 64, 8, tail, true);
    off = 0;
    while off < total { sha256_block(h, k, w, tail + off); off = off + 64; }
    var i: i64 = 0;
    while i < 8 { store_be32(out + i * 4, h[i]); i = i + 1; }
    heap_free(h); heap_free(k); heap_free(w); heap_free(tail);
}

// ---------------------------------------------------------------- SHA-512 / 384

@trusted fn sha512_block(h: *u64, k: *u64, w: *u64, p: *u8) {
    var i: i64 = 0;
    while i < 16 { w[i] = load_be64(p + i * 8); i = i + 1; }
    while i < 80 {
        var a: u64 = w[i - 15];
        var b: u64 = w[i - 2];
        var s0: u64 = rotr64(a, 1) ^ rotr64(a, 8) ^ (a >> 7);
        var s1: u64 = rotr64(b, 19) ^ rotr64(b, 61) ^ (b >> 6);
        w[i] = w[i - 16] + s0 + w[i - 7] + s1;
        i = i + 1;
    }
    var a: u64 = h[0];
    var b: u64 = h[1];
    var c: u64 = h[2];
    var d: u64 = h[3];
    var e: u64 = h[4];
    var f: u64 = h[5];
    var g: u64 = h[6];
    var hh: u64 = h[7];
    i = 0;
    while i < 80 {
        var s1: u64 = rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41);
        var ch: u64 = (e & f) ^ ((~e) & g);
        var t1: u64 = hh + s1 + ch + k[i] + w[i];
        var s0: u64 = rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39);
        var mj: u64 = (a & b) ^ (a & c) ^ (b & c);
        var t2: u64 = s0 + mj;
        hh = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
        i = i + 1;
    }
    h[0] = h[0] + a; h[1] = h[1] + b; h[2] = h[2] + c; h[3] = h[3] + d;
    h[4] = h[4] + e; h[5] = h[5] + f; h[6] = h[6] + g; h[7] = h[7] + hh;
}

@trusted fn sha512_core(data: *u8, len: i64, out: *u8, outlen: i64, is384: bool) {
    var h: *u64 = cast(*u64) heap_alloc(64);
    var k: *u64 = cast(*u64) heap_alloc(640);
    var w: *u64 = cast(*u64) heap_alloc(640);
    var tail: *u8 = heap_alloc(256);
    if is384 { sha384_h0_init(h); } else { sha512_h0_init(h); }
    sha512_k_init(k);
    var full: i64 = (len / 128) * 128;
    var off: i64 = 0;
    while off < full { sha512_block(h, k, w, data + off); off = off + 128; }
    var total: i64 = hash_tail(data, len, 128, 16, tail, true);
    off = 0;
    while off < total { sha512_block(h, k, w, tail + off); off = off + 128; }
    var full_out: *u8 = heap_alloc(64);
    var i: i64 = 0;
    while i < 8 { store_be64(full_out + i * 8, h[i]); i = i + 1; }
    raw_copy(out, full_out, outlen);
    heap_free(full_out); heap_free(h); heap_free(k); heap_free(w); heap_free(tail);
}

fn sha512(data: *u8, len: i64, out: *u8) { sha512_core(data, len, out, 64, false); }
fn sha384(data: *u8, len: i64, out: *u8) { sha512_core(data, len, out, 48, true); }

// ---------------------------------------------------------------- SHA-1

@trusted fn sha1_block(h: *u32, w: *u32, p: *u8) {
    var i: i64 = 0;
    while i < 16 { w[i] = load_be32(p + i * 4); i = i + 1; }
    while i < 80 { w[i] = rotl32(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1); i = i + 1; }
    var a: u32 = h[0];
    var b: u32 = h[1];
    var c: u32 = h[2];
    var d: u32 = h[3];
    var e: u32 = h[4];
    i = 0;
    while i < 80 {
        var f: u32 = 0;
        var k: u32 = 0;
        if i < 20 { f = (b & c) | ((~b) & d); k = 0x5a827999; }
        else if i < 40 { f = b ^ c ^ d; k = 0x6ed9eba1; }
        else if i < 60 { f = (b & c) | (b & d) | (c & d); k = 0x8f1bbcdc; }
        else { f = b ^ c ^ d; k = 0xca62c1d6; }
        var t: u32 = rotl32(a, 5) + f + e + k + w[i];
        e = d; d = c; c = rotl32(b, 30); b = a; a = t;
        i = i + 1;
    }
    h[0] = h[0] + a; h[1] = h[1] + b; h[2] = h[2] + c; h[3] = h[3] + d; h[4] = h[4] + e;
}

@trusted fn sha1(data: *u8, len: i64, out: *u8) {
    var h: *u32 = cast(*u32) heap_alloc(20);
    var w: *u32 = cast(*u32) heap_alloc(320);
    var tail: *u8 = heap_alloc(128);
    h[0] = 0x67452301; h[1] = 0xefcdab89; h[2] = 0x98badcfe; h[3] = 0x10325476; h[4] = 0xc3d2e1f0;
    var full: i64 = (len / 64) * 64;
    var off: i64 = 0;
    while off < full { sha1_block(h, w, data + off); off = off + 64; }
    var total: i64 = hash_tail(data, len, 64, 8, tail, true);
    off = 0;
    while off < total { sha1_block(h, w, tail + off); off = off + 64; }
    var i: i64 = 0;
    while i < 5 { store_be32(out + i * 4, h[i]); i = i + 1; }
    heap_free(h); heap_free(w); heap_free(tail);
}

// ---------------------------------------------------------------- generic

// Writes hash_size(alg) bytes to `out`; returns that size (0 for unknown alg).
fn hash_digest(alg: i64, data: *u8, len: i64, out: *u8) -> i64 {
    if alg == 1 { sha1(data, len, out); }
    else if alg == 2 { sha256(data, len, out); }
    else if alg == 3 { sha384(data, len, out); }
    else if alg == 4 { sha512(data, len, out); }
    ret hash_size(alg);
}

// ---------------------------------------------------------------- HMAC

@trusted fn hmac(alg: i64, key: *u8, klen: i64, msg: *u8, mlen: i64, out: *u8) -> i64 {
    var bs: i64 = hash_block_size(alg);
    var hs: i64 = hash_size(alg);
    if hs == 0 { ret 0; }
    var kb: *u8 = heap_alloc(bs);
    raw_zero(kb, bs);
    if klen > bs { hash_digest(alg, key, klen, kb); } else { raw_copy(kb, key, klen); }
    var inner: *u8 = heap_alloc(bs + mlen);
    var i: i64 = 0;
    while i < bs { inner[i] = kb[i] ^ 54; i = i + 1; }
    raw_copy(inner + bs, msg, mlen);
    var ih: *u8 = heap_alloc(hs);
    hash_digest(alg, inner, bs + mlen, ih);
    var outer: *u8 = heap_alloc(bs + hs);
    i = 0;
    while i < bs { outer[i] = kb[i] ^ 92; i = i + 1; }
    raw_copy(outer + bs, ih, hs);
    hash_digest(alg, outer, bs + hs, out);
    heap_free(kb); heap_free(inner); heap_free(ih); heap_free(outer);
    ret hs;
}

// HKDF (RFC 5869).  `out` receives `olen` bytes (olen <= 255 * hash_size).
@trusted fn hkdf_extract(alg: i64, salt: *u8, slen: i64, ikm: *u8, ilen: i64, prk: *u8) -> i64 {
    var hs: i64 = hash_size(alg);
    if slen == 0 {
        var zeros: *u8 = heap_alloc(hs);
        raw_zero(zeros, hs);
        hmac(alg, zeros, hs, ikm, ilen, prk);
        heap_free(zeros);
        ret hs;
    }
    ret hmac(alg, salt, slen, ikm, ilen, prk);
}

@trusted fn hkdf_expand(alg: i64, prk: *u8, plen: i64, info: *u8, infolen: i64, out: *u8, olen: i64) -> bool {
    var hs: i64 = hash_size(alg);
    if hs == 0 || olen > 255 * hs { ret false; }
    var buf: *u8 = heap_alloc(hs + infolen + 1);
    var t: *u8 = heap_alloc(hs);
    var tlen: i64 = 0;
    var done: i64 = 0;
    var ctr: i64 = 1;
    while done < olen {
        raw_copy(buf, t, tlen);
        raw_copy(buf + tlen, info, infolen);
        buf[tlen + infolen] = cast(u8) ctr;
        hmac(alg, prk, plen, buf, tlen + infolen + 1, t);
        tlen = hs;
        var n: i64 = olen - done;
        if n > hs { n = hs; }
        raw_copy(out + done, t, n);
        done = done + n;
        ctr = ctr + 1;
    }
    heap_free(buf); heap_free(t);
    ret true;
}

// PBKDF2-HMAC (RFC 8018).
@trusted fn pbkdf2(alg: i64, pass: *u8, plen: i64, salt: *u8, slen: i64, iters: i64, out: *u8, olen: i64) -> bool {
    var hs: i64 = hash_size(alg);
    if hs == 0 || iters < 1 { ret false; }
    var sbuf: *u8 = heap_alloc(slen + 4);
    raw_copy(sbuf, salt, slen);
    var u: *u8 = heap_alloc(hs);
    var t: *u8 = heap_alloc(hs);
    var done: i64 = 0;
    var block: i64 = 1;
    while done < olen {
        store_be32(sbuf + slen, cast(u32) block);
        hmac(alg, pass, plen, sbuf, slen + 4, u);
        raw_copy(t, u, hs);
        var it: i64 = 1;
        while it < iters {
            hmac(alg, pass, plen, u, hs, u);
            var j: i64 = 0;
            while j < hs { t[j] = t[j] ^ u[j]; j = j + 1; }
            it = it + 1;
        }
        var n: i64 = olen - done;
        if n > hs { n = hs; }
        raw_copy(out + done, t, n);
        done = done + n;
        block = block + 1;
    }
    heap_free(sbuf); heap_free(u); heap_free(t);
    ret true;
}

// Constant-time comparison.
@trusted fn ct_equal(a: *u8, b: *u8, n: i64) -> bool {
    var acc: u8 = 0;
    var i: i64 = 0;
    while i < n { acc = acc | (a[i] ^ b[i]); i = i + 1; }
    ret acc == 0;
}
