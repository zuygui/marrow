@no_main

@import("raw.mw")
@import("heap.mw")
@import("hash.mw")

// ChaCha20, Poly1305 and the ChaCha20-Poly1305 AEAD (RFC 8439).
// Keys are 32 bytes, nonces 12 bytes, tags 16 bytes.

fn load_le32(p: *u8) -> u32 {
    ret (cast(u32) p[0]) | ((cast(u32) p[1]) << 8) | ((cast(u32) p[2]) << 16) | ((cast(u32) p[3]) << 24);
}
fn store_le32(p: *u8, v: u32) {
    p[0] = cast(u8) v;
    p[1] = cast(u8) (v >> 8);
    p[2] = cast(u8) (v >> 16);
    p[3] = cast(u8) (v >> 24);
}
fn store_le64(p: *u8, v: u64) {
    store_le32(p, cast(u32) v);
    store_le32(p + 4, cast(u32) (v >> 32));
}

fn chacha_qr(x: *u32, a: i64, b: i64, c: i64, d: i64) {
    x[a] = x[a] + x[b]; x[d] = rotl32(x[d] ^ x[a], 16);
    x[c] = x[c] + x[d]; x[b] = rotl32(x[b] ^ x[c], 12);
    x[a] = x[a] + x[b]; x[d] = rotl32(x[d] ^ x[a], 8);
    x[c] = x[c] + x[d]; x[b] = rotl32(x[b] ^ x[c], 7);
}

// One 64-byte keystream block.
@trusted fn chacha20_block(key: *u8, nonce: *u8, counter: u32, out: *u8) {
    var s: *u32 = cast(*u32) heap_alloc(64);
    var x: *u32 = cast(*u32) heap_alloc(64);
    s[0] = 0x61707865; s[1] = 0x3320646e; s[2] = 0x79622d32; s[3] = 0x6b206574;
    var i: i64 = 0;
    while i < 8 { s[4 + i] = load_le32(key + i * 4); i = i + 1; }
    s[12] = counter;
    s[13] = load_le32(nonce);
    s[14] = load_le32(nonce + 4);
    s[15] = load_le32(nonce + 8);
    i = 0;
    while i < 16 { x[i] = s[i]; i = i + 1; }
    var r: i64 = 0;
    while r < 10 {
        chacha_qr(x, 0, 4, 8, 12); chacha_qr(x, 1, 5, 9, 13);
        chacha_qr(x, 2, 6, 10, 14); chacha_qr(x, 3, 7, 11, 15);
        chacha_qr(x, 0, 5, 10, 15); chacha_qr(x, 1, 6, 11, 12);
        chacha_qr(x, 2, 7, 8, 13); chacha_qr(x, 3, 4, 9, 14);
        r = r + 1;
    }
    i = 0;
    while i < 16 { store_le32(out + i * 4, x[i] + s[i]); i = i + 1; }
    heap_free(s); heap_free(x);
}

// XORs `len` bytes of `in` with the keystream starting at block `counter`.
// `in` and `out` may be the same buffer.
@trusted fn chacha20_xor(key: *u8, nonce: *u8, counter: u32, in: *u8, out: *u8, len: i64) {
    var ks: *u8 = heap_alloc(64);
    var off: i64 = 0;
    var ctr: u32 = counter;
    while off < len {
        chacha20_block(key, nonce, ctr, ks);
        var n: i64 = len - off;
        if n > 64 { n = 64; }
        var i: i64 = 0;
        while i < n { out[off + i] = in[off + i] ^ ks[i]; i = i + 1; }
        off = off + n;
        ctr = ctr + 1;
    }
    heap_free(ks);
}

// ---------------------------------------------------------------- Poly1305

// st layout (u64): h[0..5], r[5..10], pad[10..14]
fn poly_block(st: *u64, m: *u8, hibit: u64) {
    var mask: u64 = 0x3ffffff;
    var r0: u64 = st[5]; var r1: u64 = st[6]; var r2: u64 = st[7]; var r3: u64 = st[8]; var r4: u64 = st[9];
    var s1: u64 = r1 * 5; var s2: u64 = r2 * 5; var s3: u64 = r3 * 5; var s4: u64 = r4 * 5;
    var h0: u64 = st[0] + ((cast(u64) load_le32(m)) & mask);
    var h1: u64 = st[1] + (((cast(u64) load_le32(m + 3)) >> 2) & mask);
    var h2: u64 = st[2] + (((cast(u64) load_le32(m + 6)) >> 4) & mask);
    var h3: u64 = st[3] + (((cast(u64) load_le32(m + 9)) >> 6) & mask);
    var h4: u64 = st[4] + (((cast(u64) load_le32(m + 12)) >> 8) | hibit);
    var d0: u64 = h0 * r0 + h1 * s4 + h2 * s3 + h3 * s2 + h4 * s1;
    var d1: u64 = h0 * r1 + h1 * r0 + h2 * s4 + h3 * s3 + h4 * s2;
    var d2: u64 = h0 * r2 + h1 * r1 + h2 * r0 + h3 * s4 + h4 * s3;
    var d3: u64 = h0 * r3 + h1 * r2 + h2 * r1 + h3 * r0 + h4 * s4;
    var d4: u64 = h0 * r4 + h1 * r3 + h2 * r2 + h3 * r1 + h4 * r0;
    var c: u64 = d0 >> 26; h0 = d0 & mask;
    d1 = d1 + c; c = d1 >> 26; h1 = d1 & mask;
    d2 = d2 + c; c = d2 >> 26; h2 = d2 & mask;
    d3 = d3 + c; c = d3 >> 26; h3 = d3 & mask;
    d4 = d4 + c; c = d4 >> 26; h4 = d4 & mask;
    h0 = h0 + c * 5; c = h0 >> 26; h0 = h0 & mask;
    h1 = h1 + c;
    st[0] = h0; st[1] = h1; st[2] = h2; st[3] = h3; st[4] = h4;
}

@trusted fn poly1305(key: *u8, msg: *u8, len: i64, tag: *u8) {
    var st: *u64 = cast(*u64) heap_alloc(14 * 8);
    raw_zero(cast(*u8) st, 14 * 8);
    st[5] = (cast(u64) load_le32(key)) & 0x3ffffff;
    st[6] = ((cast(u64) load_le32(key + 3)) >> 2) & 0x3ffff03;
    st[7] = ((cast(u64) load_le32(key + 6)) >> 4) & 0x3ffc0ff;
    st[8] = ((cast(u64) load_le32(key + 9)) >> 6) & 0x3f03fff;
    st[9] = ((cast(u64) load_le32(key + 12)) >> 8) & 0x00fffff;
    st[10] = cast(u64) load_le32(key + 16);
    st[11] = cast(u64) load_le32(key + 20);
    st[12] = cast(u64) load_le32(key + 24);
    st[13] = cast(u64) load_le32(key + 28);
    var off: i64 = 0;
    while off + 16 <= len { poly_block(st, msg + off, 16777216); off = off + 16; }
    if off < len {
        var last: *u8 = heap_alloc(16);
        raw_zero(last, 16);
        raw_copy(last, msg + off, len - off);
        last[len - off] = 1;
        poly_block(st, last, 0);
        heap_free(last);
    }
    var mask: u64 = 0x3ffffff;
    var h0: u64 = st[0]; var h1: u64 = st[1]; var h2: u64 = st[2]; var h3: u64 = st[3]; var h4: u64 = st[4];
    var c: u64 = h1 >> 26; h1 = h1 & mask;
    h2 = h2 + c; c = h2 >> 26; h2 = h2 & mask;
    h3 = h3 + c; c = h3 >> 26; h3 = h3 & mask;
    h4 = h4 + c; c = h4 >> 26; h4 = h4 & mask;
    h0 = h0 + c * 5; c = h0 >> 26; h0 = h0 & mask;
    h1 = h1 + c;
    var g0: u64 = h0 + 5; c = g0 >> 26; g0 = g0 & mask;
    var g1: u64 = h1 + c; c = g1 >> 26; g1 = g1 & mask;
    var g2: u64 = h2 + c; c = g2 >> 26; g2 = g2 & mask;
    var g3: u64 = h3 + c; c = g3 >> 26; g3 = g3 & mask;
    var g4: u64 = h4 + c - 67108864;
    var sel: u64 = (g4 >> 63) - 1;
    var nsel: u64 = ~sel;
    h0 = (h0 & nsel) | (g0 & sel);
    h1 = (h1 & nsel) | (g1 & sel);
    h2 = (h2 & nsel) | (g2 & sel);
    h3 = (h3 & nsel) | (g3 & sel);
    h4 = (h4 & nsel) | (g4 & sel);
    var w0: u64 = (h0 | (h1 << 26)) & 0xffffffff;
    var w1: u64 = ((h1 >> 6) | (h2 << 20)) & 0xffffffff;
    var w2: u64 = ((h2 >> 12) | (h3 << 14)) & 0xffffffff;
    var w3: u64 = ((h3 >> 18) | (h4 << 8)) & 0xffffffff;
    var f: u64 = w0 + st[10];
    store_le32(tag, cast(u32) f);
    f = w1 + st[11] + (f >> 32);
    store_le32(tag + 4, cast(u32) f);
    f = w2 + st[12] + (f >> 32);
    store_le32(tag + 8, cast(u32) f);
    f = w3 + st[13] + (f >> 32);
    store_le32(tag + 12, cast(u32) f);
    heap_free(st);
}

// ---------------------------------------------------------------- AEAD

@trusted fn aead_mac(key: *u8, nonce: *u8, aad: *u8, aadlen: i64, ct: *u8, ctlen: i64, tag: *u8) {
    var otk: *u8 = heap_alloc(64);
    chacha20_block(key, nonce, 0, otk);
    var pa: i64 = (16 - (aadlen % 16)) % 16;
    var pc: i64 = (16 - (ctlen % 16)) % 16;
    var total: i64 = aadlen + pa + ctlen + pc + 16;
    var buf: *u8 = heap_alloc(total);
    raw_zero(buf, total);
    raw_copy(buf, aad, aadlen);
    raw_copy(buf + aadlen + pa, ct, ctlen);
    store_le64(buf + total - 16, cast(u64) aadlen);
    store_le64(buf + total - 8, cast(u64) ctlen);
    poly1305(otk, buf, total, tag);
    heap_free(otk); heap_free(buf);
}

// Writes ciphertext followed by the 16-byte tag to `out`; returns len + 16.
fn chacha20poly1305_seal(key: *u8, nonce: *u8, aad: *u8, aadlen: i64, pt: *u8, len: i64, out: *u8) -> i64 {
    chacha20_xor(key, nonce, 1, pt, out, len);
    aead_mac(key, nonce, aad, aadlen, out, len, out + len);
    ret len + 16;
}

// `ct` holds ciphertext||tag (`len` bytes in total).  Returns the plaintext
// length, or -1 if authentication fails (nothing is written to `out` then).
@trusted fn chacha20poly1305_open(key: *u8, nonce: *u8, aad: *u8, aadlen: i64, ct: *u8, len: i64, out: *u8) -> i64 {
    if len < 16 { ret -1; }
    var n: i64 = len - 16;
    var tag: *u8 = heap_alloc(16);
    aead_mac(key, nonce, aad, aadlen, ct, n, tag);
    var ok: bool = ct_equal(tag, ct + n, 16);
    heap_free(tag);
    if !ok { ret -1; }
    chacha20_xor(key, nonce, 1, ct, out, n);
    ret n;
}
