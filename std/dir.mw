@no_main

@import("os.mw")
@import("text.mw")
@import("vec.mw")
@import("mem.mw")
@import("path.mw")

// Directories and file metadata (Linux today; other platforms report failure).

var DIR_KIND_OTHER: i64 = 0;
var DIR_KIND_FILE: i64 = 1;
var DIR_KIND_DIR: i64 = 2;
var DIR_KIND_LINK: i64 = 3;

struct DirEntry {
    name: *u8;
    kind: i64;
}

@trusted fn dir_entry_free(e: *DirEntry) {
    dealloc(e.name);
    dealloc(e);
}

// Frees the list returned by dir_list.
fn dir_list_free(v: ^VecPtr) {
    var i: i64 = 0;
    while i < vec_ptr_len(v) { dir_entry_free(vec_ptr_get(v, i)); i = i + 1; }
    vec_ptr_free(v);
}

// Entries of a directory (without "." and ".."), sorted by name.  null on error.
@trusted fn dir_list(path: *u8) -> ^VecPtr {
    var fd: i64 = sys_open(path, O_RDONLY, 0);
    if fd < 0 { ret null; }
    var out: ^VecPtr = vec_ptr_new(16);
    var buf: *u8 = alloc(8192);
    var ok: bool = true;
    var more: bool = true;
    while more {
        var n: i64 = sys_getdents(cast(i32) fd, buf, 8192);
        if n < 0 { ok = false; more = false; }
        else if n == 0 { more = false; }
        else {
            var off: i64 = 0;
            while off < n {
                var reclen: i64 = (cast(i64) buf[off + 16]) | ((cast(i64) buf[off + 17]) << 8);
                var dtype: i64 = cast(i64) buf[off + 18];
                var name: *u8 = buf + off + 19;
                if str_cmp(name, ".") != 0 && str_cmp(name, "..") != 0 {
                    var e: *DirEntry = alloc(16);
                    e.name = str_dup(name);
                    e.kind = DIR_KIND_OTHER;
                    if dtype == 8 { e.kind = DIR_KIND_FILE; }
                    else if dtype == 4 { e.kind = DIR_KIND_DIR; }
                    else if dtype == 10 { e.kind = DIR_KIND_LINK; }
                    // insertion keeps the list sorted
                    vec_ptr_push(out, e);
                    var i: i64 = vec_ptr_len(out) - 1;
                    while i > 0 {
                        var prev: *DirEntry = vec_ptr_get(out, i - 1);
                        var cur: *DirEntry = vec_ptr_get(out, i);
                        if str_cmp(prev.name, cur.name) > 0 {
                            vec_ptr_set(out, i - 1, cur);
                            vec_ptr_set(out, i, prev);
                            i = i - 1;
                        } else { i = 0; }
                    }
                }
                off = off + reclen;
            }
        }
    }
    sys_close(cast(i32) fd);
    dealloc(buf);
    if !ok { dir_list_free(out); ret null; }
    ret out;
}

// Mode, size and modification time (Unix seconds) of a path.  false if it
// does not exist or stat is unavailable.
@trusted fn file_stat(path: *u8, mode: *i64, size: *i64, mtime: *i64) -> bool {
    var fd: i64 = sys_open(path, O_RDONLY, 0);
    if fd < 0 { ret false; }
    var r: i64 = sys_fstat_info(cast(i32) fd, mode, size, mtime);
    sys_close(cast(i32) fd);
    ret r >= 0;
}

@trusted fn path_is_dir(path: *u8) -> bool {
    var m: i64 = 0; var s: i64 = 0; var t: i64 = 0;
    if !file_stat(path, raw m, raw s, raw t) { ret false; }
    ret (m & 61440) == 16384;
}

@trusted fn path_is_file(path: *u8) -> bool {
    var m: i64 = 0; var s: i64 = 0; var t: i64 = 0;
    if !file_stat(path, raw m, raw s, raw t) { ret false; }
    ret (m & 61440) == 32768;
}

// Size in bytes, or -1.
@trusted fn path_size(path: *u8) -> i64 {
    var m: i64 = 0; var s: i64 = 0; var t: i64 = 0;
    if !file_stat(path, raw m, raw s, raw t) { ret -1; }
    ret s;
}

// Modification time in Unix seconds, or -1.
@trusted fn path_mtime(path: *u8) -> i64 {
    var m: i64 = 0; var s: i64 = 0; var t: i64 = 0;
    if !file_stat(path, raw m, raw s, raw t) { ret -1; }
    ret t;
}

@trusted fn file_rename(from: *u8, to: *u8) -> bool { ret sys_rename(from, to) >= 0; }

// Removes an empty directory.
@trusted fn dir_remove(path: *u8) -> bool { ret sys_rmdir(path) >= 0; }

// Creates a directory and any missing parents (like `mkdir -p`).
@trusted fn dir_create_all(path: *u8) -> bool {
    if path_is_dir(path) { ret true; }
    var parent: *u8 = path_dirname(path);
    var ok: bool = true;
    if str_cmp(parent, path) != 0 && str_cmp(parent, ".") != 0 { ok = dir_create_all(parent); }
    dealloc(parent);
    if !ok { ret false; }
    if sys_mkdir(path, 493) >= 0 { ret true; }
    ret path_is_dir(path);
}

// Removes a file or a directory tree (symbolic links are removed, not followed).
@trusted fn remove_all(path: *u8) -> bool {
    var entries: ^VecPtr = dir_list(path);
    if entries == null { ret sys_unlink(path) >= 0; }
    var ok: bool = true;
    var i: i64 = 0;
    while i < vec_ptr_len(entries) {
        var e: *DirEntry = vec_ptr_get(entries, i);
        var child: *u8 = path_join(path, e.name);
        if e.kind == DIR_KIND_DIR { if !remove_all(child) { ok = false; } }
        else { if sys_unlink(child) < 0 { ok = false; } }
        dealloc(child);
        i = i + 1;
    }
    dir_list_free(entries);
    if !dir_remove(path) { ok = false; }
    ret ok;
}

// Current working directory as a new string, or null.
@trusted fn cwd_get() -> *u8 {
    var cap: i64 = 256;
    while cap <= 65536 {
        var buf: *u8 = alloc(cap);
        var n: i64 = sys_getcwd(buf, cast(u64) cap);
        if n > 0 { ret buf; }
        dealloc(buf);
        if n != -34 { ret null; }
        cap = cap * 4;
    }
    ret null;
}

@trusted fn cwd_set(path: *u8) -> bool { ret sys_chdir(path) >= 0; }
