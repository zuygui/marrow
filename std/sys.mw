@no_main

@import("io.mw")

@trusted fn exit(code: i32) {
    sys_exit(code);
}

// Runs a shell command and returns its exit status (-1 when unsupported).
@trusted fn exec(command: *u8) -> i32 {
    ret sys_system(command);
}

fn panic(message: *u8) {
    eprint("[FATAL PANIC] ");
    eprintln(message);
    exit(1);
}

fn assert(condition: i8, message: *u8) {
    if (condition == 0) {
        panic(message);
    }
}

@trusted fn getpid() -> i64 {
    ret sys_getpid();
}
