@no_main

@import("mem.mrw")

struct VecPtr {
    data: rawptr;
    len: i64;
    cap: i64;
}

fn vec_ptr_new(initial_cap: i64) -> *VecPtr {
    var v: *VecPtr = alloc(24);
    if (initial_cap < 4) {
        initial_cap = 4;
    }
    v.data = alloc(initial_cap * 8);
    v.len = 0;
    v.cap = initial_cap;
    ret v;
}

fn vec_ptr_push(v: *VecPtr, item: rawptr) {
    if (v.len >= v.cap) {
        var new_cap: i64 = v.cap * 2;
        v.data = realloc(v.data, new_cap * 8);
        v.cap = new_cap;
    }

    var slot: *rawptr = v.data + (v.len * 8);
    *slot = item;

    v.len = v.len + 1;
}

fn vec_ptr_get(v: *VecPtr, index: i64) -> rawptr {
    if (index < 0) { ret 0; }
    if (index >= v.len) { ret 0; }

    var slot: *rawptr = v.data + (index * 8);
    ret *slot;
}

fn vec_ptr_free(v: *VecPtr) {
    dealloc(v.data);
    dealloc(v);
}

fn vec_ptr_set(vec: *VecPtr, index: i64, value: rawptr) {
    if (vec == 0) { ret; }
    if (index < 0 || index >= vec.len) { ret; }

    var target: *rawptr = cast(*rawptr) (cast(i64) vec.data + (index * 8));
    *target = value;
}

struct VecI64 {
    data: rawptr;
    len: i64;
    cap: i64;
}

fn vec_i64_new(initial_cap: i64) -> *VecI64 {
    var v: *VecI64 = alloc(24);
    if (initial_cap < 4) {
        initial_cap = 4;
    }
    v.data = alloc(initial_cap * 8);
    v.len = 0;
    v.cap = initial_cap;
    ret v;
}

fn vec_i64_push(v: *VecI64, val: i64) {
    if (v.len >= v.cap) {
        var new_cap: i64 = v.cap * 2;
        v.data = realloc(v.data, new_cap * 8);
        v.cap = new_cap;
    }

    var slot: *i64 = v.data + (v.len * 8);
    *slot = val;

    v.len = v.len + 1;
}

fn vec_i64_get(v: *VecI64, index: i64) -> i64 {
    if (index < 0) { ret 0; }
    if (index >= v.len) { ret 0; }

    var slot: *i64 = v.data + (index * 8);
    ret *slot;
}

fn vec_i64_free(v: *VecI64) {
    dealloc(v.data);
    dealloc(v);
}