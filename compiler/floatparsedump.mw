// Test driver for floatparse.mw: reads one decimal literal per line from the file given
// as argument and prints each parsed value the way Rust's `{}` does.

@import("floatfmt.mw")
@import("floatparse.mw")

@export fn main(argc: i32, argv: rawptr) -> i32 {
    env_init(argc, argv);
    var data: *u8 = read_to_string(arg_get(1)).data;
    var p: *u8 = data;
    while *p != 0 {
        var n: i64 = 0;
        while p[n] != 10 && p[n] != 0 { n += 1; }
        var line: *u8 = str_dup_n(p, n);
        var v: f64 = 0.0;
        if parse_f64_exact(line, &v) { println(f64_shortest(v)); } else { println("error"); }
        p = p + n;
        if *p == 10 { p = p + 1; }
    }
    ret 0;
}
