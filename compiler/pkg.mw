// Projects and packages.
//
// A project is a directory with a `marrow.toml`:
//
//     [package]
//     name = "app"
//     version = "0.1.0"
//     # main = "src/main.mw"     (program entry, default)
//     # lib  = "src/lib.mw"      (what other packages import, default)
//
//     [dependencies]
//     json = "^1.2"                                        # from the registry
//     util = { git = "https://host/user/util", tag = "v1" } # any git repository (private ones too)
//     local = { path = "../local" }                         # a directory
//
// Dependencies are fetched once per machine into `~/.marrow` (override with MARROW_HOME) and
// shared by every project; each version has its own folder, so several versions of one package
// can coexist. `marrow.lock` pins what was resolved. The registry is the `registry` branch of
// https://github.com/zuygui/marrow (override with MARROW_REGISTRY and MARROW_REGISTRY_BRANCH):
// one `packages/<name>.toml` per package.
//
// Sources are used from the program with `@import("json", json)` and then `json::name`.

@import("toml.mw")
@import("semver.mw")
@import("tools.mw")

struct Dep {
    name: *u8;
    req: *u8;        // registry requirement ("^1.2"), null for git/path dependencies
    git: *u8;
    tag: *u8;
    rev: *u8;
    branch: *u8;
    path: *u8;
}

struct Manifest {
    dir: *u8;
    name: *u8;
    version: *u8;
    main: *u8;
    lib: *u8;
    deps: *VecPtr;   // *Dep
}

// A resolved package: where its files are, and the packages it depends on.
struct PNode {
    name: *u8;
    version: *u8;
    source: *u8;     // "registry", "git+<url>" or "path"
    ref: *u8;        // what was asked of a git dependency ("tag:v1"), "" otherwise
    rev: *u8;        // commit, "" for path dependencies
    dir: *u8;
    manifest: *Manifest;
    links: *VecPtr;  // *PLink
}

struct PLink {
    name: *u8;       // the name used in `@import("name")`
    node: *PNode;
}

struct LockEnt {
    name: *u8;
    version: *u8;
    source: *u8;
    ref: *u8;
    rev: *u8;
}

// What the loader needs: `owner` (a package directory) may `@import("name")`, which is `entry`.
struct DepEntry {
    owner: *u8;
    name: *u8;
    entry: *u8;
    root: *u8;       // directory of the dependency (the root of its namespace)
}

var PK_NODES: *VecPtr = null;
var PK_LOCK: *VecPtr = null;
var PK_UPDATE: bool = false;
var PK_REG_SYNCED: bool = false;
var PK_QUIET: bool = false;
var PKG_DEPS: *VecPtr = null;    // *DepEntry, read by the loader
// marrow.toml as it was before `add`/`remove` edited it, put back when the command fails.
var PK_BACKUP_PATH: *u8 = null;
var PK_BACKUP_TEXT: *u8 = null;

fn pk_restore_manifest() {
    if PK_BACKUP_PATH == null { ret; }
    write_string_to_file(PK_BACKUP_PATH, string_from(PK_BACKUP_TEXT));
    PK_BACKUP_PATH = null;
}

fn pk_say(verb: *u8, what: *u8) {
    if PK_QUIET { ret; }
    eprintln(cat4("  ", st_level(true, verb), " ", what));
}

fn pk_is_abs(p: *u8) -> bool {
    if p[0] == 47 || p[0] == 92 { ret true; }
    ret ((p[0] >= 65 && p[0] <= 90) || (p[0] >= 97 && p[0] <= 122)) && p[1] == 58;
}

fn pk_slashes(s: *u8) -> *u8 {
    var out: *String = string_new(str_len(s) + 1);
    for var i: i64 = 0; s[i] != 0; i += 1 {
        if s[i] == 92 { string_push_char(out, 47); } else { string_push_char(out, s[i]); }
    }
    ret out.data;
}

fn pk_abs(dir: *u8, p: *u8) -> *u8 {
    var q: *u8 = pk_slashes(p);
    if pk_is_abs(q) { ret path_normalize(q); }
    ret path_normalize(path_join(dir, q));
}

// ---- locations ---------------------------------------------------------------------------

fn marrow_home() -> *u8 {
    var h: *u8 = env_get("MARROW_HOME");
    if h != null && h[0] != 0 { ret pk_slashes(h); }
    var home: *u8 = env_get("HOME");
    if home == null || home[0] == 0 { home = env_get("USERPROFILE"); }
    if home == null { fatal_h("cannot find your home directory", "set `MARROW_HOME` to a writable directory", 2); }
    ret path_join(pk_slashes(home), ".marrow");
}

// A folder name made of the readable tail of `s`.
fn pk_slug(s: *u8) -> *u8 {
    var n: i64 = str_len(s);
    var start: i64 = 0;
    if n > 60 { start = n - 60; }
    var out: *String = string_new(64);
    for var i: i64 = start; i < n; i += 1 {
        var c: u8 = s[i];
        if (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45 { string_push_char(out, c); }
        else { string_push_char(out, 95); }
    }
    // distinguish slugs that only differ in the part that was cut or replaced
    var h: i64 = 5381;
    for var i: i64 = 0; i < n; i += 1 { h = (h * 33 + cast(i64) s[i]) & 4294967295; }
    string_push_char(out, 45);
    string_push_i64(out, h);
    ret out.data;
}

fn registry_url() -> *u8 {
    var r: *u8 = env_get("MARROW_REGISTRY");
    if r != null && r[0] != 0 { ret r; }
    ret "https://github.com/zuygui/marrow";
}

fn registry_branch() -> *u8 {
    var r: *u8 = env_get("MARROW_REGISTRY_BRANCH");
    if r != null && r[0] != 0 { ret r; }
    ret "registry";
}

// ---- running git ---------------------------------------------------------------------------

fn pk_need_git() {
    if find_in_path("git") == null {
        fatal_h("`git` was not found", "packages are fetched with git: install it from https://git-scm.com", 2);
    }
}

// The standard output of `cmd`, trimmed; null when it failed.
fn pk_capture(cmd: *u8) -> *u8 {
    var tmp_dir: *u8 = path_join(marrow_home(), "tmp");
    dir_create_all(tmp_dir);
    var tmp: *u8 = path_join(tmp_dir, cat2("out-", i64_str(getpid())));
    var st: i32 = exec(cat4(cmd, " > ", shq(tmp), ""));
    if st != 0 { file_remove(tmp); ret null; }
    var s: *String = read_to_string(tmp);
    file_remove(tmp);
    if s == null { ret null; }
    ret str_trim(s.data);
}

fn pk_head(dir: *u8) -> *u8 {
    ret pk_capture(cat3("git -C ", shq(dir), " rev-parse HEAD"));
}

// Clones `url` (at `ref`, a tag or a branch; or the commit `rev`) into a fresh folder `dest`.
fn pk_clone(url: *u8, ref: *u8, rev: *u8, dest: *u8) -> bool {
    dir_create_all(path_dirname(dest));
    remove_all(dest);
    if ref != null && ref[0] != 0 {
        if pk_git_quiet(cat5("clone --quiet --depth 1 --branch ", shq(ref), " ", shq(url), cat2(" ", shq(dest)))) { ret true; }
        remove_all(dest);
        ret false;
    }
    if !pk_git_quiet(cat4("clone --quiet ", shq(url), " ", shq(dest))) { remove_all(dest); ret false; }
    if rev != null && rev[0] != 0 {
        if !pk_git_quiet(cat4("-C ", shq(dest), " checkout --quiet ", shq(rev))) { remove_all(dest); ret false; }
    }
    ret true;
}

fn pk_git_quiet(args: *u8) -> bool {
    pk_need_git();
    ret exec(cat2("git ", args)) == 0;
}

// ---- manifests -----------------------------------------------------------------------------

fn pk_str_or(t: *TTable, key: *u8, fallback: *u8) -> *u8 {
    var s: *u8 = tt_str(t, key);
    if s == null { ret fallback; }
    ret s;
}

fn dep_new(name: *u8) -> *Dep {
    var d: *Dep = cast(*Dep) alloc(sizeof(Dep));
    mem_zero(cast(*u8) d, sizeof(Dep));
    d.name = name;
    ret d;
}

fn pk_valid_name(n: *u8) -> bool {
    if n[0] == 0 { ret false; }
    for var i: i64 = 0; n[i] != 0; i += 1 {
        var c: u8 = n[i];
        if !((c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 || c == 45) { ret false; }
    }
    ret true;
}

// Reads `<dir>/marrow.toml`; stops the program with a message when it is wrong.
fn manifest_load(dir: *u8) -> *Manifest {
    var file: *u8 = path_join(dir, "marrow.toml");
    var src: *String = read_to_string(file);
    if src == null { fatal(cat3("cannot read `", file, "`"), 2); }
    var err: *u8 = null;
    var t: *TTable = toml_parse(src.data, &err);
    if t == null { fatal(cat4("invalid `", file, "`: ", err), 2); }
    var pkg: *TTable = tt_table(t, "package");
    if pkg == null { fatal_h(cat3("`", file, "` has no `[package]` table"), "add:\n    [package]\n    name = \"my-project\"\n    version = \"0.1.0\"", 2); }
    var m: *Manifest = cast(*Manifest) alloc(sizeof(Manifest));
    m.dir = dir;
    m.name = tt_str(pkg, "name");
    if m.name == null || !pk_valid_name(m.name) {
        fatal_h(cat3("`", file, "` needs a valid `package.name`"), "use lowercase letters, digits, `-` and `_`", 2);
    }
    m.version = pk_str_or(pkg, "version", "0.0.0");
    if ver_parse(m.version) == null {
        fatal_h(cat5("`", file, "`: `", m.version, "` is not a valid version"), "versions look like `1.2.3`", 2);
    }
    m.main = pk_str_or(pkg, "main", "src/main.mw");
    m.lib = pk_str_or(pkg, "lib", "src/lib.mw");
    m.deps = vec_ptr_new(4);
    var deps: *TTable = tt_table(t, "dependencies");
    if deps != null {
        for var i: i64 = 0; i < vec_ptr_len(deps.keys); i += 1 {
            var name: *u8 = cast(*u8) vec_ptr_get(deps.keys, i);
            var v: *TVal = cast(*TVal) vec_ptr_get(deps.vals, i);
            var d: *Dep = dep_new(name);
            if v.kind == TV_STR { d.req = v.s; }
            else if v.kind == TV_TABLE {
                d.req = tt_str(v.tbl, "version");
                d.git = tt_str(v.tbl, "git");
                d.tag = tt_str(v.tbl, "tag");
                d.rev = tt_str(v.tbl, "rev");
                d.branch = tt_str(v.tbl, "branch");
                d.path = tt_str(v.tbl, "path");
                if d.git == null && d.path == null && d.req == null {
                    fatal_h(cat5("dependency `", name, "` in `", file, "` has no source"), "give a version (`\"^1.0\"`), or `git = \"url\"`, or `path = \"dir\"`", 2);
                }
            } else {
                fatal(cat5("dependency `", name, "` in `", file, "` must be a version string or a table"), 2);
            }
            if d.req != null {
                var rerr: *u8 = null;
                if req_parse(d.req, &rerr) == null { fatal(cat5("dependency `", name, "`: ", rerr, ""), 2); }
            }
            vec_ptr_push(m.deps, cast(rawptr) d);
        }
    }
    ret m;
}

// The nearest directory, from `start` upwards, holding a `marrow.toml`; null when none.
fn pk_find_root(start: *u8) -> *u8 {
    var d: *u8 = canon_path(start);
    while true {
        if path_is_file(path_join(d, "marrow.toml")) { ret d; }
        var up: *u8 = path_dirname(d);
        if str_eq(up, d) == 1 || up[0] == 0 { ret null; }
        d = up;
    }
}

// ---- the lock file -------------------------------------------------------------------------

fn lock_load(root: *u8) {
    PK_LOCK = vec_ptr_new(8);
    var file: *u8 = path_join(root, "marrow.lock");
    if !path_is_file(file) { ret; }
    var src: *String = read_to_string(file);
    if src == null { ret; }
    var err: *u8 = null;
    var t: *TTable = toml_parse(src.data, &err);
    if t == null { eprintln(cat4("warning: ignoring `", file, "`: ", err)); ret; }
    var arr: *VecPtr = tt_array(t, "package");
    if arr == null { ret; }
    for var i: i64 = 0; i < vec_ptr_len(arr); i += 1 {
        var v: *TVal = cast(*TVal) vec_ptr_get(arr, i);
        if v.kind != TV_TABLE { continue; }
        var e: *LockEnt = cast(*LockEnt) alloc(sizeof(LockEnt));
        e.name = pk_str_or(v.tbl, "name", "");
        e.version = pk_str_or(v.tbl, "version", "");
        e.source = pk_str_or(v.tbl, "source", "");
        e.ref = pk_str_or(v.tbl, "ref", "");
        e.rev = pk_str_or(v.tbl, "rev", "");
        vec_ptr_push(PK_LOCK, cast(rawptr) e);
    }
}

fn lock_text() -> *u8 {
    var out: *String = string_new(256);
    string_push_str(out, "# This file is generated by `marrow`. Do not edit it by hand.\n");
    // sorted by name then version, so that the file does not change between runs
    var order: *VecPtr = vec_ptr_new(vec_ptr_len(PK_NODES));
    for var i: i64 = 0; i < vec_ptr_len(PK_NODES); i += 1 {
        var n: *PNode = cast(*PNode) vec_ptr_get(PK_NODES, i);
        if str_eq(n.source, "path") == 1 { continue; }
        var at: i64 = vec_ptr_len(order);
        while at > 0 && pk_node_less(n, cast(*PNode) vec_ptr_get(order, at - 1)) { at -= 1; }
        vec_ptr_push(order, cast(rawptr) n);
        var k: i64 = vec_ptr_len(order) - 1;
        while k > at { vec_ptr_set(order, k, vec_ptr_get(order, k - 1)); k -= 1; }
        vec_ptr_set(order, at, cast(rawptr) n);
    }
    for var i: i64 = 0; i < vec_ptr_len(order); i += 1 {
        var n: *PNode = cast(*PNode) vec_ptr_get(order, i);
        string_push_str(out, "\n[[package]]\n");
        string_push_str(out, cat3("name = \"", n.name, "\"\n"));
        string_push_str(out, cat3("version = \"", n.version, "\"\n"));
        string_push_str(out, cat3("source = \"", n.source, "\"\n"));
        if n.ref[0] != 0 { string_push_str(out, cat3("ref = \"", n.ref, "\"\n")); }
        string_push_str(out, cat3("rev = \"", n.rev, "\"\n"));
    }
    ret out.data;
}

fn pk_node_less(a: *PNode, b: *PNode) -> bool {
    var c: i32 = str_cmp(a.name, b.name);
    if c != 0 { ret c < 0; }
    var va: *Version = ver_parse(a.version);
    var vb: *Version = ver_parse(b.version);
    if va != null && vb != null { ret ver_cmp(va, vb) < 0; }
    ret str_cmp(a.version, b.version) < 0;
}

fn lock_save(root: *u8) {
    var text: *u8 = lock_text();
    var file: *u8 = path_join(root, "marrow.lock");
    var old: *String = null;
    if path_is_file(file) { old = read_to_string(file); }
    if old != null && str_eq(old.data, text) == 1 { ret; }
    var s: *String = string_from(text);
    write_string_to_file(file, s);
}

// ---- the registry ----------------------------------------------------------------------------

fn registry_dir() -> *u8 {
    ret path_join(path_join(marrow_home(), "registry"), pk_slug(cat3(registry_url(), "#", registry_branch())));
}

// Makes sure the local copy of the index exists and, once per run when `fresh`, is up to date.
fn registry_sync(fresh: bool) -> *u8 {
    var dir: *u8 = registry_dir();
    var url: *u8 = registry_url();
    var branch: *u8 = registry_branch();
    if path_is_dir(path_join(dir, ".git")) {
        if fresh && !PK_REG_SYNCED {
            PK_REG_SYNCED = true;
            pk_say("Updating", "the package registry");
            if pk_git_quiet(cat5("-C ", shq(dir), " fetch --quiet --depth 1 origin ", shq(branch), "")) {
                pk_git_quiet(cat3("-C ", shq(dir), " reset --quiet --hard FETCH_HEAD"));
            } else {
                eprintln("warning: could not update the registry, using the local copy");
            }
        }
        ret dir;
    }
    PK_REG_SYNCED = true;
    pk_say("Fetching", cat2("the package registry from ", url));
    if !pk_clone(url, branch, null, dir) {
        fatal_h(cat3("cannot fetch the package registry from `", url, "`"),
            "check your network connection, or set MARROW_REGISTRY to another repository", 2);
    }
    ret dir;
}

// One package file of the registry: `packages/<folders>/<name>.toml`. The folders are free
// (categories such as `chat/` or `web/`); the file name is the package name.
struct RegFile {
    name: *u8;
    folder: *u8;     // "" or "chat" or "chat/bots", relative to packages/
    path: *u8;
}

fn reg_walk(root: *u8, rel: *u8, out: *VecPtr, depth: i64) {
    if depth > 8 { ret; }
    var dir: *u8 = root;
    if rel[0] != 0 { dir = path_join(root, rel); }
    var entries: *VecPtr = dir_list(dir);
    if entries == null { ret; }
    for var i: i64 = 0; i < vec_ptr_len(entries); i += 1 {
        var e: *DirEntry = cast(*DirEntry) vec_ptr_get(entries, i);
        if e.name[0] == 46 { continue; }
        if e.kind == DIR_KIND_DIR {
            var sub: *u8 = e.name;
            if rel[0] != 0 { sub = path_join(rel, e.name); }
            reg_walk(root, sub, out, depth + 1);
        } else if str_ends_with(e.name, ".toml") {
            var f: *RegFile = cast(*RegFile) alloc(sizeof(RegFile));
            f.name = str_dup_n(e.name, str_len(e.name) - 5);
            f.folder = rel;
            f.path = path_join(dir, e.name);
            vec_ptr_push(out, cast(rawptr) f);
        }
    }
}

// Every package file of the (synced) registry.
fn registry_files() -> *VecPtr {
    var out: *VecPtr = vec_ptr_new(32);
    reg_walk(path_join(registry_sync(PK_UPDATE), "packages"), "", out, 0);
    ret out;
}

fn reg_lookup(files: *VecPtr, name: *u8) -> *RegFile {
    var hit: *RegFile = null;
    for var i: i64 = 0; i < vec_ptr_len(files); i += 1 {
        var f: *RegFile = cast(*RegFile) vec_ptr_get(files, i);
        if str_eq(f.name, name) != 1 { continue; }
        if hit != null {
            fatal_h(cat3("the registry has two packages named `", name, "`"),
                cat5("`", hit.path, "` and `", f.path, "`: package names must be unique"), 2);
        }
        hit = f;
    }
    ret hit;
}

// The index entry of `name` (a table with `repo` and `[[version]]`), or null.
fn registry_entry(name: *u8) -> *TTable {
    var f: *RegFile = reg_lookup(registry_files(), name);
    if f == null && !PK_REG_SYNCED {
        // the local copy may simply be old
        registry_sync(true);
        f = reg_lookup(registry_files(), name);
    }
    if f == null { ret null; }
    var src: *String = read_to_string(f.path);
    if src == null { ret null; }
    var err: *u8 = null;
    var t: *TTable = toml_parse(src.data, &err);
    if t == null { fatal(cat5("the registry entry of `", name, "` is invalid: ", err, ""), 2); }
    ret t;
}

// ---- resolving ---------------------------------------------------------------------------------

fn pk_find_node(name: *u8, version: *u8, source: *u8, ref: *u8) -> *PNode {
    for var i: i64 = 0; i < vec_ptr_len(PK_NODES); i += 1 {
        var n: *PNode = cast(*PNode) vec_ptr_get(PK_NODES, i);
        if str_eq(n.name, name) == 1 && str_eq(n.version, version) == 1 && str_eq(n.source, source) == 1 && str_eq(n.ref, ref) == 1 { ret n; }
    }
    ret null;
}

fn pnode_new(name: *u8, version: *u8, source: *u8, ref: *u8, rev: *u8, dir: *u8) -> *PNode {
    var n: *PNode = cast(*PNode) alloc(sizeof(PNode));
    n.name = name;
    n.version = version;
    n.source = source;
    n.ref = ref;
    n.rev = rev;
    n.dir = dir;
    n.links = vec_ptr_new(4);
    n.manifest = null;
    vec_ptr_push(PK_NODES, cast(rawptr) n);
    ret n;
}

fn lock_find(name: *u8, source: *u8, ref: *u8) -> *LockEnt {
    for var i: i64 = 0; i < vec_ptr_len(PK_LOCK); i += 1 {
        var e: *LockEnt = cast(*LockEnt) vec_ptr_get(PK_LOCK, i);
        if str_eq(e.name, name) == 1 && str_eq(e.source, source) == 1 && str_eq(e.ref, ref) == 1 { ret e; }
    }
    ret null;
}

// The locked registry entry of `name` with the highest version satisfying `req`.
fn lock_find_reg(name: *u8, req: *Req) -> *LockEnt {
    var best: *LockEnt = null;
    var bestv: *Version = null;
    for var i: i64 = 0; i < vec_ptr_len(PK_LOCK); i += 1 {
        var e: *LockEnt = cast(*LockEnt) vec_ptr_get(PK_LOCK, i);
        if str_eq(e.name, name) != 1 || str_eq(e.source, "registry") != 1 { continue; }
        var v: *Version = ver_parse(e.version);
        if v == null || !req_matches(req, v) { continue; }
        if best == null || ver_cmp(v, bestv) > 0 { best = e; bestv = v; }
    }
    ret best;
}

fn pk_ref_of(d: *Dep) -> *u8 {
    if d.tag != null { ret cat2("tag:", d.tag); }
    if d.branch != null { ret cat2("branch:", d.branch); }
    if d.rev != null { ret cat2("rev:", d.rev); }
    ret "";
}

// A registry package at an exact version, fetched into the shared cache when missing.
fn pk_install_registry(name: *u8, version: *u8, repo: *u8, tag: *u8, rev: *u8) -> *PNode {
    var dir: *u8 = path_join(path_join(path_join(marrow_home(), "pkg"), name), version);
    var ref: *u8 = tag;
    if rev != null && rev[0] != 0 { ref = null; }
    if !path_is_file(path_join(dir, "marrow.toml")) {
        pk_say("Installing", cat4(name, " v", version, ""));
        var tmp: *u8 = cat3(dir, ".tmp-", i64_str(getpid()));
        if !pk_clone(repo, ref, rev, tmp) {
            fatal_h(cat5("cannot fetch `", name, "` v", version, cat3(" from `", repo, "`")), "check that the tag exists in the repository and that you can reach it", 2);
        }
        remove_all(dir);
        if !file_rename(tmp, dir) { fatal(cat3("cannot install `", name, "`"), 2); }
    }
    var head: *u8 = pk_head(dir);
    if head == null { head = ""; }
    ret pnode_new(name, version, "registry", "", head, dir);
}

fn pk_resolve_registry(d: *Dep) -> *PNode {
    var rerr: *u8 = null;
    var req: *Req = req_parse(d.req, &rerr);
    // 1. a version already selected in this build that satisfies the requirement
    var best: *PNode = null;
    var bestv: *Version = null;
    for var i: i64 = 0; i < vec_ptr_len(PK_NODES); i += 1 {
        var n: *PNode = cast(*PNode) vec_ptr_get(PK_NODES, i);
        if str_eq(n.name, d.name) != 1 || str_eq(n.source, "registry") != 1 { continue; }
        var v: *Version = ver_parse(n.version);
        if v != null && req_matches(req, v) && (best == null || ver_cmp(v, bestv) > 0) { best = n; bestv = v; }
    }
    if best != null { ret best; }
    // 2. what the lock file says
    if !PK_UPDATE {
        var le: *LockEnt = lock_find_reg(d.name, req);
        if le != null {
            var dir: *u8 = path_join(path_join(path_join(marrow_home(), "pkg"), le.name), le.version);
            if path_is_file(path_join(dir, "marrow.toml")) {
                ret pnode_new(le.name, le.version, "registry", "", le.rev, dir);
            }
            // locked but not installed on this machine: fetch exactly that commit
            var entry: *TTable = registry_entry(d.name);
            if entry != null {
                var repo: *u8 = tt_str(entry, "repo");
                if repo != null { ret pk_install_registry(le.name, le.version, repo, null, le.rev); }
            }
        }
    }
    // 3. the highest matching version of the index
    var e: *TTable = registry_entry(d.name);
    if e == null {
        fatal_h(cat3("package `", d.name, "` was not found in the registry"),
            "check the name (`marrow search <text>`), or depend on its git repository: `marrow add <name> --git <url>`", 2);
    }
    var repo2: *u8 = tt_str(e, "repo");
    if repo2 == null { fatal(cat3("the registry entry of `", d.name, "` has no `repo`"), 2); }
    var versions: *VecPtr = tt_array(e, "version");
    var pick: *TTable = null;
    var pickv: *Version = null;
    if versions != null {
        for var i: i64 = 0; i < vec_ptr_len(versions); i += 1 {
            var tv: *TVal = cast(*TVal) vec_ptr_get(versions, i);
            if tv.kind != TV_TABLE { continue; }
            var vs: *u8 = tt_str(tv.tbl, "version");
            if vs == null { continue; }
            var yk: *TVal = tt_get(tv.tbl, "yanked");
            if yk != null && yk.kind == TV_BOOL && yk.n == 1 { continue; }
            var v: *Version = ver_parse(vs);
            if v == null || !req_matches(req, v) { continue; }
            if pick == null || ver_cmp(v, pickv) > 0 { pick = tv.tbl; pickv = v; }
        }
    }
    if pick == null {
        fatal_h(cat5("no version of `", d.name, "` satisfies `", d.req, "`"), "run `marrow search` to see the package, or relax the requirement", 2);
    }
    var tag: *u8 = pk_str_or(pick, "tag", cat2("v", tt_str(pick, "version")));
    var rev: *u8 = tt_str(pick, "rev");
    ret pk_install_registry(d.name, tt_str(pick, "version"), repo2, tag, rev);
}

fn pk_resolve_git(d: *Dep) -> *PNode {
    var ref: *u8 = pk_ref_of(d);
    var source: *u8 = cat2("git+", d.git);
    var base: *u8 = path_join(path_join(marrow_home(), "git"), pk_slug(d.git));
    var le: *LockEnt = null;
    if !PK_UPDATE { le = lock_find(d.name, source, ref); }
    var rev: *u8 = null;
    var dir: *u8 = null;
    if le != null && le.rev[0] != 0 {
        rev = le.rev;
        dir = path_join(base, rev);
        if !path_is_file(path_join(dir, "marrow.toml")) {
            pk_say("Fetching", cat3(d.name, " from ", d.git));
            var tmp: *u8 = cat3(dir, ".tmp-", i64_str(getpid()));
            if !pk_clone(d.git, null, rev, tmp) { fatal(cat3("cannot fetch `", d.name, "`"), 2); }
            remove_all(dir);
            file_rename(tmp, dir);
        }
    } else {
        pk_say("Fetching", cat3(d.name, " from ", d.git));
        var tmp2: *u8 = cat2(path_join(base, "tmp-"), i64_str(getpid()));
        var cref: *u8 = null;
        var crev: *u8 = null;
        if d.tag != null { cref = d.tag; } else if d.branch != null { cref = d.branch; } else if d.rev != null { crev = d.rev; }
        if !pk_clone(d.git, cref, crev, tmp2) {
            fatal_h(cat5("cannot fetch `", d.name, "` from `", d.git, "`"), "check the URL, your access to the repository and the tag/branch/rev", 2);
        }
        rev = pk_head(tmp2);
        if rev == null { fatal(cat3("cannot read the commit of `", d.name, "`"), 2); }
        dir = path_join(base, rev);
        if path_is_dir(dir) { remove_all(tmp2); } else { file_rename(tmp2, dir); }
    }
    var existing: *PNode = null;
    for var i: i64 = 0; i < vec_ptr_len(PK_NODES); i += 1 {
        var n: *PNode = cast(*PNode) vec_ptr_get(PK_NODES, i);
        if str_eq(n.source, source) == 1 && str_eq(n.rev, rev) == 1 && str_eq(n.name, d.name) == 1 { existing = n; }
    }
    if existing != null { ret existing; }
    var mf: *Manifest = manifest_load(dir);
    var node: *PNode = pnode_new(d.name, mf.version, source, ref, rev, dir);
    node.manifest = mf;
    ret node;
}

fn pk_resolve_path(owner: *u8, d: *Dep) -> *PNode {
    var dir: *u8 = pk_abs(owner, d.path);
    if !path_is_file(path_join(dir, "marrow.toml")) {
        fatal(cat5("dependency `", d.name, "`: `", dir, "` has no marrow.toml"), 2);
    }
    for var i: i64 = 0; i < vec_ptr_len(PK_NODES); i += 1 {
        var n: *PNode = cast(*PNode) vec_ptr_get(PK_NODES, i);
        if str_eq(n.source, "path") == 1 && str_eq(n.dir, dir) == 1 { ret n; }
    }
    var mf: *Manifest = manifest_load(dir);
    var node: *PNode = pnode_new(d.name, mf.version, "path", "", "", dir);
    node.manifest = mf;
    ret node;
}

fn pk_resolve_deps(owner: *PNode, depth: i64) {
    if depth > 64 { fatal("the dependencies are nested too deeply (is there a cycle?)", 2); }
    var mf: *Manifest = owner.manifest;
    for var i: i64 = 0; i < vec_ptr_len(mf.deps); i += 1 {
        var d: *Dep = cast(*Dep) vec_ptr_get(mf.deps, i);
        var node: *PNode = null;
        if d.path != null { node = pk_resolve_path(owner.dir, d); }
        else if d.git != null { node = pk_resolve_git(d); }
        else { node = pk_resolve_registry(d); }
        var link: *PLink = cast(*PLink) alloc(sizeof(PLink));
        link.name = d.name;
        link.node = node;
        vec_ptr_push(owner.links, cast(rawptr) link);
        if node.manifest == null {
            node.manifest = manifest_load(node.dir);
            if str_eq(node.manifest.name, d.name) != 1 {
                eprintln(cat5("warning: the package fetched as `", d.name, "` calls itself `", node.manifest.name, "`"));
            }
            pk_resolve_deps(node, depth + 1);
        } else if vec_ptr_len(node.links) == 0 && node != owner {
            pk_resolve_deps(node, depth + 1);
        }
    }
}

// Resolves every dependency of the project at `root`, fetching what is missing; updates
// `marrow.lock`. Returns the root node.
fn pk_resolve_project(root: *u8, update: bool) -> *PNode {
    PK_NODES = vec_ptr_new(16);
    PK_UPDATE = update;
    lock_load(root);
    var mf: *Manifest = manifest_load(root);
    var rn: *PNode = pnode_new(mf.name, mf.version, "path", "", "", root);
    rn.manifest = mf;
    // the root is not a dependency: keep it out of the lock file
    pk_resolve_deps(rn, 0);
    lock_save(root);
    ret rn;
}

// The import table the loader consults, for `rn` and everything below it.
fn pk_dep_entries(rn: *PNode) -> *VecPtr {
    var out: *VecPtr = vec_ptr_new(16);
    for var i: i64 = 0; i < vec_ptr_len(PK_NODES); i += 1 {
        var n: *PNode = cast(*PNode) vec_ptr_get(PK_NODES, i);
        for var j: i64 = 0; j < vec_ptr_len(n.links); j += 1 {
            var l: *PLink = cast(*PLink) vec_ptr_get(n.links, j);
            var e: *DepEntry = cast(*DepEntry) alloc(sizeof(DepEntry));
            e.owner = n.dir;
            e.name = l.name;
            e.root = l.node.dir;
            var lib: *u8 = path_join(l.node.dir, l.node.manifest.lib);
            if !path_is_file(lib) {
                fatal_h(cat5("package `", l.name, "` has no library file `", l.node.manifest.lib, "`"),
                    "a package is imported through the `lib` file of its marrow.toml (default `src/lib.mw`)", 2);
            }
            e.entry = lib;
            vec_ptr_push(out, cast(rawptr) e);
        }
    }
    ret out;
}
