// Finds the functions marked `@test` in a source file, and the files that hold tests.

@import("strutil.mw")

fn ts_ident_char(c: u8) -> bool {
    ret (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

fn ts_space(c: u8) -> bool { ret c == 32 || c == 9 || c == 10 || c == 13; }

// True when `i` sits after a `//` on its line.
fn ts_in_comment(src: *u8, i: i64) -> bool {
    var k: i64 = i - 1;
    while k >= 0 && src[k] != 10 {
        if src[k] == 47 && k > 0 && src[k - 1] == 47 { ret true; }
        k -= 1;
    }
    ret false;
}

// Names of the parameterless functions declared right after an `@test` decorator.
fn ts_find_tests(src: *u8) -> *VecPtr {
    var out: *VecPtr = cast(*VecPtr) vec_ptr_new(4);
    var n: i64 = str_len(src);
    var i: i64 = 0;
    while i < n {
        if src[i] == 64 && str_starts_with(src + i + 1, "test") && !ts_ident_char(src[i + 5]) && !ts_in_comment(src, i) {
            var j: i64 = i + 5;
            while ts_space(src[j]) { j += 1; }
            if src[j] == 102 && src[j + 1] == 110 && ts_space(src[j + 2]) {
                j += 2;
                while ts_space(src[j]) { j += 1; }
                var s: i64 = j;
                while ts_ident_char(src[j]) { j += 1; }
                var e: i64 = j;
                while ts_space(src[j]) { j += 1; }
                if e > s && src[j] == 40 {
                    j += 1;
                    while ts_space(src[j]) { j += 1; }
                    if src[j] == 41 { vec_ptr_push(out, cast(rawptr) str_dup_n(src + s, e - s)); }
                }
            }
            i += 5;
        } else {
            i += 1;
        }
    }
    ret out;
}

// A `main` function is declared in `src`.
fn ts_has_main(src: *u8) -> bool {
    var n: i64 = str_len(src);
    for var i: i64 = 0; i + 8 < n; i += 1 {
        if (i == 0 || !ts_ident_char(src[i - 1])) && src[i] == 102 && src[i + 1] == 110 && ts_space(src[i + 2]) {
            var j: i64 = i + 2;
            while ts_space(src[j]) { j += 1; }
            if str_starts_with(src + j, "main") && !ts_ident_char(src[j + 4]) && !ts_in_comment(src, i) { ret true; }
        }
    }
    ret false;
}
