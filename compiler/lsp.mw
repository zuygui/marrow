// `marrow lsp`: a language server on stdin/stdout (Language Server Protocol, JSON-RPC).
//
// What it offers:
//   - diagnostics: the errors and warnings of `marrow check` for the project, sent when a file is
//     opened or saved (the compiler reads files from disk, so unsaved edits are not checked);
//   - formatting: `textDocument/formatting` runs the same formatter as `marrow fmt` on the text of
//     the editor, saved or not.
// The check itself is a run of this very compiler with `--message-format json`.

@import("../std/json.mw")

struct Lsp {
    uris: *VecPtr;          // open documents: uri
    texts: *VecPtr;         // ... and their text (*String)
    published: *VecPtr;     // uris that received diagnostics (to clear them later)
    self_path: *u8;
    inbuf: *u8;
    inlen: i64;
    inpos: i64;
    shutdown: bool;
}

fn lsp_getc(l: *Lsp) -> i64 {
    if l.inpos >= l.inlen {
        l.inlen = sys_read(0, l.inbuf, 65536);
        l.inpos = 0;
        if l.inlen <= 0 { l.inlen = 0; ret -1; }
    }
    var c: i64 = l.inbuf[l.inpos];
    l.inpos += 1;
    ret c;
}

// The next message, or null at the end of the input.
fn lsp_read(l: *Lsp) -> *Json {
    var length: i64 = -1;
    while true {
        var line: *String = cast(*String) string_new(64);
        var c: i64 = lsp_getc(l);
        if c < 0 { ret null; }
        while c >= 0 && c != 10 {
            if c != 13 { string_push_char(line, cast(u8) c); }
            c = lsp_getc(l);
        }
        if line.len == 0 { break; }
        if str_starts_with(line.data, "Content-Length:") {
            var p: *u8 = line.data + 15;
            while p[0] == 32 { p = p + 1; }
            length = 0;
            while p[0] >= 48 && p[0] <= 57 { length = length * 10 + (p[0] - 48); p = p + 1; }
        }
    }
    if length < 0 { ret null; }
    var body: *u8 = alloc(length + 1);
    for var i: i64 = 0; i < length; i += 1 {
        var c: i64 = lsp_getc(l);
        if c < 0 { ret null; }
        body[i] = cast(u8) c;
    }
    body[length] = 0;
    ret json_parse(body, length);
}

fn lsp_send(msg: *Json) {
    var text: *u8 = json_stringify(msg, false);
    var head: *u8 = cat3("Content-Length: ", i64_str(str_len(text)), "\r\n\r\n");
    os_write_all(1, head, str_len(head));
    os_write_all(1, text, str_len(text));
}

fn lsp_reply(id: *Json, result: *Json) {
    var m: *Json = json_object();
    json_set(m, "jsonrpc", json_str("2.0"));
    if id != null && id.kind == 2 { json_set(m, "id", json_int(json_as_i64(id))); }
    else if id != null { json_set(m, "id", json_str(json_as_str(id))); }
    else { json_set(m, "id", json_null()); }
    json_set(m, "result", result);
    lsp_send(m);
}

fn lsp_error(id: *Json, code: i64, text: *u8) {
    var m: *Json = json_object();
    json_set(m, "jsonrpc", json_str("2.0"));
    if id != null && id.kind == 2 { json_set(m, "id", json_int(json_as_i64(id))); }
    else if id != null { json_set(m, "id", json_str(json_as_str(id))); }
    var e: *Json = json_object();
    json_set(e, "code", json_int(code));
    json_set(e, "message", json_str(text));
    json_set(m, "error", e);
    lsp_send(m);
}

fn lsp_notify(method: *u8, params: *Json) {
    var m: *Json = json_object();
    json_set(m, "jsonrpc", json_str("2.0"));
    json_set(m, "method", json_str(method));
    json_set(m, "params", params);
    lsp_send(m);
}

fn lsp_hex(c: i64) -> i64 {
    if c >= 48 && c <= 57 { ret c - 48; }
    if c >= 97 && c <= 102 { ret c - 87; }
    if c >= 65 && c <= 70 { ret c - 55; }
    ret -1;
}

// `file:///home/me/a%20b.mw` -> `/home/me/a b.mw`
fn lsp_uri_path(uri: *u8) -> *u8 {
    if !str_starts_with(uri, "file://") { ret null; }
    var s: *u8 = uri + 7;
    var out: *String = cast(*String) string_new(64);
    var i: i64 = 0;
    if s[0] == 47 && s[2] == 58 { i = 1; }    // /C:/dir on Windows
    while s[i] != 0 {
        if s[i] == 37 && lsp_hex(s[i + 1]) >= 0 && lsp_hex(s[i + 2]) >= 0 {
            string_push_char(out, cast(u8) (lsp_hex(s[i + 1]) * 16 + lsp_hex(s[i + 2])));
            i += 3;
        } else { string_push_char(out, s[i]); i += 1; }
    }
    ret out.data;
}

fn lsp_path_uri(path: *u8) -> *u8 {
    var out: *String = cast(*String) string_new(64);
    string_push_str(out, "file://");
    if path[0] != 47 { string_push_char(out, 47); }
    var i: i64 = 0;
    while path[i] != 0 {
        var c: u8 = path[i];
        if c == 32 { string_push_str(out, "%20"); }
        else if c == 92 { string_push_char(out, 47); }
        else { string_push_char(out, c); }
        i += 1;
    }
    ret out.data;
}

fn lsp_doc_index(l: *Lsp, uri: *u8) -> i64 {
    for var i: i64 = 0; i < vec_ptr_len(l.uris); i += 1 {
        if str_eq(cast(*u8) vec_ptr_get(l.uris, i), uri) == 1 { ret i; }
    }
    ret -1;
}

fn lsp_set_text(l: *Lsp, uri: *u8, text: *u8) {
    var i: i64 = lsp_doc_index(l, uri);
    var s: *String = cast(*String) string_from(text);
    if i < 0 { vec_ptr_push(l.uris, cast(rawptr) str_dup(uri)); vec_ptr_push(l.texts, cast(rawptr) s); }
    else { vec_ptr_set(l.texts, i, cast(rawptr) s); }
}

fn lsp_forget(l: *Lsp, uri: *u8) {
    var i: i64 = lsp_doc_index(l, uri);
    if i < 0 { ret; }
    var n: i64 = vec_ptr_len(l.uris);
    vec_ptr_set(l.uris, i, vec_ptr_get(l.uris, n - 1));
    vec_ptr_set(l.texts, i, vec_ptr_get(l.texts, n - 1));
    l.uris.len -= 1;
    l.texts.len -= 1;
}

fn lsp_range(l1: i64, c1: i64, l2: i64, c2: i64) -> *Json {
    var r: *Json = json_object();
    var a: *Json = json_object();
    json_set(a, "line", json_int(l1));
    json_set(a, "character", json_int(c1));
    var b: *Json = json_object();
    json_set(b, "line", json_int(l2));
    json_set(b, "character", json_int(c2));
    json_set(r, "start", a);
    json_set(r, "end", b);
    ret r;
}

// The file to give to `marrow check` for a document: the project's entry point, or the file.
fn lsp_entry(path: *u8) -> *u8 {
    var root: *u8 = pk_find_root(path_dirname(path));
    if root != null {
        var m: *u8 = path_join(root, "src/main.mw");
        if file_exists(m) != 0 { ret m; }
        var lib: *u8 = path_join(root, "src/lib.mw");
        if file_exists(lib) != 0 { ret lib; }
    }
    ret path;
}

fn lsp_publish(uri: *u8, list: *Json) {
    var p: *Json = json_object();
    json_set(p, "uri", json_str(uri));
    json_set(p, "diagnostics", list);
    lsp_notify("textDocument/publishDiagnostics", p);
}

// Runs the check for a document and sends what it reports.
fn lsp_check(l: *Lsp, uri: *u8) {
    var path: *u8 = lsp_uri_path(uri);
    if path == null { ret; }
    var entry: *u8 = lsp_entry(path);
    var tmpdir: *u8 = env_get_or("TMPDIR", "/tmp");
    var out: *u8 = path_join(tmpdir, cat3("marrow-lsp-", i64_str(getpid()), ".json"));
    var cmd: *u8 = cat7("\"", l.self_path, "\" check --message-format json --color never \"", entry, "\" 2> \"", out, "\"");
    exec(cmd);
    var text: *String = cast(*String) read_to_string(out);
    file_remove(out);
    var files: *VecPtr = cast(*VecPtr) vec_ptr_new(4);      // uri
    var lists: *VecPtr = cast(*VecPtr) vec_ptr_new(4);      // *Json arrays
    if text != null {
        var p: i64 = 0;
        while p < text.len {
            var q: i64 = p;
            while q < text.len && text.data[q] != 10 { q += 1; }
            if q > p {
                var line: *u8 = str_dup_n(text.data + p, q - p);
                var d: *Json = json_parse_str(line);
                if d != null && json_kind(d) == 5 && json_has(d, "file") {
                    var furi: *u8 = lsp_path_uri(json_as_str(json_get(d, "file")));
                    var k: i64 = -1;
                    for var m: i64 = 0; m < vec_ptr_len(files); m += 1 { if str_eq(cast(*u8) vec_ptr_get(files, m), furi) == 1 { k = m; } }
                    if k < 0 { k = vec_ptr_len(files); vec_ptr_push(files, cast(rawptr) furi); vec_ptr_push(lists, cast(rawptr) json_array()); }
                    var lsp_d: *Json = json_object();
                    json_set(lsp_d, "range", lsp_range(json_as_i64(json_get(d, "line")) - 1, json_as_i64(json_get(d, "col")) - 1,
                            json_as_i64(json_get(d, "endLine")) - 1, json_as_i64(json_get(d, "endCol")) - 1));
                    var sev: i64 = 1;
                    if str_is(json_as_str(json_get(d, "severity")), "warning") { sev = 2; }
                    json_set(lsp_d, "severity", json_int(sev));
                    json_set(lsp_d, "code", json_str(json_as_str(json_get(d, "code"))));
                    json_set(lsp_d, "source", json_str("marrow"));
                    json_set(lsp_d, "message", json_str(json_as_str(json_get(d, "message"))));
                    json_push(cast(*Json) vec_ptr_get(lists, k), lsp_d);
                }
            }
            p = q + 1;
        }
    }
    // what was reported before and is gone now
    for var m: i64 = 0; m < vec_ptr_len(l.published); m += 1 {
        var old: *u8 = cast(*u8) vec_ptr_get(l.published, m);
        var still: bool = false;
        for var k: i64 = 0; k < vec_ptr_len(files); k += 1 { if str_eq(cast(*u8) vec_ptr_get(files, k), old) == 1 { still = true; } }
        if !still { lsp_publish(old, json_array()); }
    }
    l.published = cast(*VecPtr) vec_ptr_new(4);
    for var k: i64 = 0; k < vec_ptr_len(files); k += 1 {
        lsp_publish(cast(*u8) vec_ptr_get(files, k), cast(*Json) vec_ptr_get(lists, k));
        vec_ptr_push(l.published, vec_ptr_get(files, k));
    }
    // the document that was asked for has no diagnostics: make sure its marks are cleared
    var seen: bool = false;
    for var k: i64 = 0; k < vec_ptr_len(files); k += 1 { if str_eq(cast(*u8) vec_ptr_get(files, k), uri) == 1 { seen = true; } }
    if !seen { lsp_publish(uri, json_array()); }
}

fn lsp_format(l: *Lsp, id: *Json, uri: *u8) {
    var text: *String = null;
    var i: i64 = lsp_doc_index(l, uri);
    if i >= 0 { text = cast(*String) vec_ptr_get(l.texts, i); }
    else { var path: *u8 = lsp_uri_path(uri); if path != null { text = cast(*String) read_to_string(path); } }
    if text == null { lsp_reply(id, json_null()); ret; }
    var out: *String = fmt_source(text.data, text.len);
    if out == null || !fmt_same_tokens(text.data, text.len, out.data, out.len) { lsp_reply(id, json_null()); ret; }
    var edits: *Json = json_array();
    if !(out.len == text.len && str_eq(out.data, text.data) == 1) {
        var lines: i64 = 1;
        for var k: i64 = 0; k < text.len; k += 1 { if text.data[k] == 10 { lines += 1; } }
        var e: *Json = json_object();
        json_set(e, "range", lsp_range(0, 0, lines, 0));
        json_set(e, "newText", json_str(out.data));
        json_push(edits, e);
    }
    lsp_reply(id, edits);
}

fn lsp_handle(l: *Lsp, m: *Json) {
    var method: *u8 = json_as_str(json_get(m, "method"));
    var id: *Json = null;
    if json_has(m, "id") { id = json_get(m, "id"); }
    var params: *Json = json_get(m, "params");
    var doc: *Json = json_get(params, "textDocument");
    var uri: *u8 = null;
    if doc != null { uri = json_as_str(json_get(doc, "uri")); }
    if method == null { ret; }
    if str_is(method, "initialize") {
        var caps: *Json = json_object();
        var sync: *Json = json_object();
        json_set(sync, "openClose", json_bool(true));
        json_set(sync, "change", json_int(1));
        var save: *Json = json_object();
        json_set(save, "includeText", json_bool(false));
        json_set(sync, "save", save);
        json_set(caps, "textDocumentSync", sync);
        json_set(caps, "documentFormattingProvider", json_bool(true));
        var info: *Json = json_object();
        json_set(info, "name", json_str("marrow"));
        json_set(info, "version", json_str(MARROW_VERSION));
        var res: *Json = json_object();
        json_set(res, "capabilities", caps);
        json_set(res, "serverInfo", info);
        lsp_reply(id, res);
    } else if str_is(method, "shutdown") {
        l.shutdown = true;
        lsp_reply(id, json_null());
    } else if str_is(method, "exit") {
        if l.shutdown { exit(0); }
        exit(1);
    } else if str_is(method, "textDocument/didOpen") {
        if uri != null {
            lsp_set_text(l, uri, json_as_str(json_get(doc, "text")));
            lsp_check(l, uri);
        }
    } else if str_is(method, "textDocument/didChange") {
        var changes: *Json = json_get(params, "contentChanges");
        if uri != null && json_len(changes) > 0 {
            lsp_set_text(l, uri, json_as_str(json_get(json_at(changes, json_len(changes) - 1), "text")));
        }
    } else if str_is(method, "textDocument/didSave") {
        if uri != null { lsp_check(l, uri); }
    } else if str_is(method, "textDocument/didClose") {
        if uri != null { lsp_forget(l, uri); }
    } else if str_is(method, "textDocument/formatting") {
        if uri != null { lsp_format(l, id, uri); }
    } else if id != null {
        lsp_error(id, -32601, "method not found");
    }
}

fn cmd_lsp() -> i32 {
    var l: *Lsp = cast(*Lsp) alloc(sizeof(Lsp));
    mem_zero(cast(*u8) l, sizeof(Lsp));
    l.uris = cast(*VecPtr) vec_ptr_new(8);
    l.texts = cast(*VecPtr) vec_ptr_new(8);
    l.published = cast(*VecPtr) vec_ptr_new(4);
    l.inbuf = alloc(65536);
    l.self_path = arg_get(0);
    while true {
        var m: *Json = lsp_read(l);
        if m == null { break; }
        lsp_handle(l, m);
    }
    ret 0;
}
