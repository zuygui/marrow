// `marrow`, the Marrow compiler written in Marrow: the same pipeline as src/main.rs
// (load imports -> lower -> type check -> QBE IL -> `qbe` -> `cc`).
//
// Diagnostics are rendered like the Rust driver does (compiler/diagrender.mw), colors included;
// only the terminal detection of `--color auto` is approximate (see `stderr_is_tty`). The generated
// IL and assembly are identical.

@import("codegen.mw")
@import("runtime.mw")
@import("diagrender.mw")
@import("tools.mw")
@import("cmds.mw")

var MARROW_VERSION: *u8 = "v0.3.0";

var USAGE: *u8 = "The Marrow compiler and package manager\n\nUsage: marrow <COMMAND> [OPTIONS]\n       marrow [OPTIONS] <input.mw> [output.ssa]     (same as `marrow build`)\n\nBuilding:\n  build [input.mw]   Compile a program (the project's `main` when no file is given)\n  run [input.mw] [-- ARGS...]   Build, then run the program\n  check [input.mw]   Type-check only, no code is generated\n\nProjects and packages:\n  new <name> [--lib]   Create a project in a new directory\n  init [--lib]         Create a project in the current directory\n  add <name>[@version] [--git URL [--tag T|--rev R|--branch B]] [--path DIR]\n                       Add a dependency to marrow.toml and install it\n  remove <name>        Remove a dependency\n  install              Fetch the dependencies listed in marrow.toml\n  update               Fetch newer versions of the dependencies, rewrite marrow.lock\n  tree                 Show the dependency tree\n  search [text]        Search the package registry\n\nOther:\n  doctor               Check that the tools needed to build programs are installed\n  version              Print the compiler version\n  help                 Print this help\n\nOptions:\n      --check            Type-check the program and stop (no code is generated)\n      --nostdlib         Link without libc: use Marrow's own `_start` and syscall stub\n      --target <T>       Target as <arch>-<os>, e.g. x86_64-linux, aarch64-linux, riscv64-linux\n                         (default: the host; cross targets only emit assembly)\n      --color <WHEN>     Colorize diagnostics: auto (default), always or never\n  -V, --version          Print the compiler version\n  -h, --help             Print this help\n\nEnvironment:\n  MARROW_QBE             Path of the `qbe` binary (default: next to `marrow`, then PATH)\n  MARROW_CC              C compiler used to assemble and link (default: cc, gcc or clang)\n  MARROW_HOME            Where packages are cached (default: ~/.marrow)\n  MARROW_REGISTRY        Git URL or path of the package registry (default: github.com/zuygui/marrow)";
// `error: msg` plus an optional help line, in the layout of a diagnostic without a span.
fn fatal_h(msg: *u8, help: *u8, code: i32) {
    var d: *Diag = cast(*Diag) alloc(sizeof(Diag));
    d.code = "";
    d.msg = msg;
    d.file = -1;
    diag_init(d);
    if help != null { diag_help(d, help); }
    var r: *Renderer = renderer_new(null);
    var out: *String = render_diag(r, d);
    eprintln(out.data);
    pk_restore_manifest();
    exit(code);
}

fn fatal(msg: *u8, code: i32) { fatal_h(msg, null, code); }

// `path` with its last extension replaced by `ext` (without the dot; may be empty).
fn with_extension(path: *u8, ext: *u8) -> *u8 {
    var n: i64 = str_len(path);
    var dot: i64 = -1;
    var i: i64 = n - 1;
    while i >= 0 && path[i] != 47 {
        if path[i] == 46 { dot = i; break; }
        i -= 1;
    }
    var stem: *u8 = path;
    if dot > 0 { stem = str_dup_n(path, dot); }
    if str_len(ext) == 0 { ret stem; }
    ret cat3(stem, ".", ext);
}

var N_ERRORS: i64 = 0;
var N_WARNINGS: i64 = 0;
var N_SUPPRESSED: i64 = 0;
var MAX_SHOWN: i64 = 100;   // diagnostics rendered; the rest is only counted
var RENDERER: *Renderer = null;

fn print_diag(ld: *Loader, d: *Diag) {
    if RENDERER == null { RENDERER = renderer_new(ld); }
    if d.code[0] == 87 { N_WARNINGS += 1; } else { N_ERRORS += 1; }
    if N_ERRORS + N_WARNINGS > MAX_SHOWN { N_SUPPRESSED += 1; ret; }
    var r: *String = render_diag(RENDERER, d);
    eprintln(demangle(ld, r.data));
}

fn finish_diags() {
    if N_SUPPRESSED > 0 {
        var more: *u8 = cat3(i64_str(N_SUPPRESSED), " more diagnostics are not shown (only the first ", cat2(i64_str(MAX_SHOWN), " are)"));
        eprintln(cat4(st_level(true, "note"), st_bold(":"), " ", st_bold(more)));
    }
    if N_ERRORS > 0 {
        var msg: *String = string_new(64);
        string_push_str(msg, "aborting due to ");
        if N_ERRORS == 1 { string_push_str(msg, "1 previous error"); }
        else { string_push_i64(msg, N_ERRORS); string_push_str(msg, " previous errors"); }
        if N_WARNINGS > 0 {
            string_push_str(msg, "; ");
            string_push_i64(msg, N_WARNINGS);
            if N_WARNINGS == 1 { string_push_str(msg, " warning emitted"); } else { string_push_str(msg, " warnings emitted"); }
        }
        eprintln(cat4(st_level(false, "error"), st_bold(":"), " ", st_bold(msg.data)));
    } else if N_WARNINGS > 0 {
        var msg: *String = string_new(32);
        string_push_i64(msg, N_WARNINGS);
        if N_WARNINGS == 1 { string_push_str(msg, " warning emitted"); } else { string_push_str(msg, " warnings emitted"); }
        eprintln(cat4(st_level(true, "warning"), st_bold(":"), " ", st_bold(msg.data)));
    }
}

// Whether stderr looks like a terminal: a character device (this also holds for
// /dev/null, which a real `isatty` would reject).
fn stderr_is_tty() -> bool {
    var mode: i64 = 0;
    var size: i64 = 0;
    var mtime: i64 = 0;
    if sys_fstat_info(2, &mode, &size, &mtime) < 0 { ret false; }
    ret (mode & 61440) == 8192;
}

// 0 auto, 1 always, 2 never -> whether to color.
fn color_wanted(choice: i64) -> bool {
    if choice == 1 { ret true; }
    if choice == 2 { ret false; }
    if !stderr_is_tty() { ret false; }
    if env_get("NO_COLOR") != null { ret false; }
    var term: *u8 = env_get("TERM");
    if term != null && str_is(term, "dumb") { ret false; }
    ret true;
}

fn parse_color(v: *u8) -> i64 {
    var c: i64 = 0;
    if str_is(v, "always") { c = 1; }
    else if str_is(v, "never") { c = 2; }
    else if !str_is(v, "auto") {
        fatal_h(cat3("invalid value `", v, "` for `--color`"), "possible values are `auto`, `always` and `never`", 2);
    }
    STYLE_COLOR = color_wanted(c);
    ret c;
}

// Quoted for `/bin/sh` (single quotes), or for cmd.exe on Windows (double quotes).
fn shq(s: *u8) -> *u8 {
    var out: *String = string_new(str_len(s) + 8);
    if OS == 2 {
        string_push_char(out, 34);
        string_push_str(out, s);
        string_push_char(out, 34);
        ret out.data;
    }
    string_push_char(out, 39);
    for var i: i64 = 0; s[i] != 0; i += 1 {
        if s[i] == 39 { string_push_str(out, "'\\''"); } else { string_push_char(out, s[i]); }
    }
    string_push_char(out, 39);
    ret out.data;
}

fn run_cmd(cmd: *u8, what: *u8) {
    var st: i32 = exec(cmd);
    if st == 127 || st < 0 {
        fatal(cat3("failed to execute `", what, "`"), 2);
    }
    if st != 0 {
        fatal(cat5("`", what, "` failed with exit code ", i64_str(cast(i64) st), ""), 1);
    }
}


struct Opts {
    check_only: bool;
    nostdlib: bool;
    target_arg: *u8;
    input: *u8;
    output: *u8;
    exe: *u8;          // set by `compile` when an executable was produced
    exe_path: *u8;     // where to put the executable (default: next to the input)
}

fn is_command(a: *u8) -> bool {
    ret str_is(a, "build") || str_is(a, "run") || str_is(a, "check") || str_is(a, "doctor")
        || str_is(a, "version") || str_is(a, "help") || str_is(a, "new") || str_is(a, "init")
        || str_is(a, "add") || str_is(a, "remove") || str_is(a, "install") || str_is(a, "update")
        || str_is(a, "tree") || str_is(a, "search");
}

// `./prog` for a bare file name, so that the shell does not look it up in PATH.
fn exe_command_path(exe: *u8) -> *u8 {
    for var i: i64 = 0; exe[i] != 0; i += 1 {
        if exe[i] == 47 || exe[i] == 92 { ret exe; }
    }
    if OS == 2 { ret cat2(".\\", exe); }
    ret cat2("./", exe);
}

// The whole pipeline for one program; returns the process exit code.
fn compile(o: *Opts) -> i32 {
    var input: *u8 = o.input;
    var output: *u8 = o.output;
    if file_exists(input) == 0 {
        fatal(cat3("input file `", input, "` not found"), 2);
    }
    if output == null { output = with_extension(input, "ssa"); }

    var target: *Target = target_host();
    if o.target_arg != null {
        target = target_parse(o.target_arg);
        if target == null { fatal(cat3("unknown target `", o.target_arg, "`"), 2); }
    }

    var ld: *Loader = loader_new(target_dir_name(target), path_dirname(input));
    var is_library: bool = false;
    var ok: bool = load_with_imports(ld, input, &is_library);
    for var k: i64 = 0; k < vec_ptr_len(ld.diags); k += 1 { print_diag(ld, cast(*Diag) vec_ptr_get(ld.diags, k)); }
    if !ok || vec_ptr_len(ld.diags) > 0 { finish_diags(); ret 1; }

    var lw: *Lw = lw_new();
    lower_program(lw, ld.items);
    var bad: bool = false;
    for var k: i64 = 0; k < vec_ptr_len(lw.diags); k += 1 {
        var d: *Diag = cast(*Diag) vec_ptr_get(lw.diags, k);
        if d.code[0] != 87 { bad = true; }
        print_diag(ld, d);
    }
    if bad { finish_diags(); ret 1; }

    CK_FILES = ld.files;
    var ck: *Ck = ck_new();
    check_program(ck, lw.out);
    var failed: bool = false;
    for var k: i64 = 0; k < vec_ptr_len(ck.diags); k += 1 {
        var d: *Diag = cast(*Diag) vec_ptr_get(ck.diags, k);
        if d.code[0] != 87 { failed = true; }
        print_diag(ld, d);
    }
    finish_diags();
    if failed { ret 1; }
    if o.check_only {
        eprintln("Check finished: no errors found.");
        ret 0;
    }

    var cross: bool = o.target_arg != null && !target_is_host(target);
    if o.nostdlib && !target_nostdlib_supported(target) {
        fatal(cat3("`--nostdlib` is not supported on ", target_dir_name(target), " yet"), 2);
    }

    // Look for the tools before doing any work that needs them.
    var qbe: *u8 = find_qbe();
    if qbe == null {
        fatal_h("`qbe` was not found", qbe_install_hint(), 2);
    }
    var compiler: *u8 = null;
    if !cross {
        compiler = find_cc();
        if compiler == null {
            fatal_h("no C compiler was found to assemble and link the program", cc_install_hint(), 2);
        }
    }

    var names: *VecPtr = vec_ptr_new(16);
    for var k: i64 = 0; k < vec_ptr_len(ld.files); k += 1 {
        var sf: *SourceFile = cast(*SourceFile) vec_ptr_get(ld.files, k);
        vec_ptr_push(names, cast(rawptr) canon_path(sf.name));
    }
    var il: *String = generate(names, lw.out);
    if write_string_to_file(output, il) == 0 {
        fatal(cat3("failed to write `", output, "`"), 2);
    }

    var asm_path: *u8 = with_extension(output, "s");
    var qcmd: *String = string_new(128);
    string_push_str(qcmd, shq(tool_cmd(qbe)));
    string_push_str(qcmd, cat2(" -t ", target_qbe_target(target)));
    string_push_str(qcmd, cat5(" -o ", shq(asm_path), " ", shq(output), ""));
    run_cmd(qcmd.data, "qbe");

    var asm: *String = target_adapt_asm(target, read_to_string(asm_path).data);
    string_push_str(asm, target_runtime_asm(target, o.nostdlib));
    if write_string_to_file(asm_path, asm) == 0 {
        fatal(cat3("failed to write `", asm_path, "`"), 2);
    }
    if cross {
        eprintln(cat4("Cross target ", target_dir_name(target), ": assembly written to ", asm_path));
        ret 0;
    }

    if is_library {
        var obj: *u8 = with_extension(input, "o");
        run_cmd(cat7(shq(tool_cmd(compiler)), " -c ", shq(asm_path), " -o ", shq(obj), "", ""), "C compiler");
        eprintln(cat5("Library compiled (no `main`, see `@no_main`): ", obj, "\nLink it into a program with: cc your_program.o ", obj, " -o your_program"));
        ret 0;
    }
    var exe: *u8 = with_extension(input, "");
    if o.exe_path != null { exe = o.exe_path; }
    var lcmd: *String = string_new(128);
    string_push_str(lcmd, shq(tool_cmd(compiler)));
    if o.nostdlib && target_freestanding_link(target) { string_push_str(lcmd, " -nostdlib -static -no-pie"); }
    // Windows: link Winsock and give the main thread a fully committed 64 MiB stack
    // (generated code does not probe the stack page by page).
    string_push_str(lcmd, cat5(" ", shq(asm_path), " -o ", shq(exe), ""));
    if OS == 2 { string_push_str(lcmd, " -lws2_32 -lcrypt32 -Xlinker --stack -Xlinker 67108864,67108864"); }
    run_cmd(lcmd.data, "C compiler");
    eprintln(cat2("Compilation successful! Executable created at: ", exe));
    o.exe = exe;
    ret 0;
}

@export fn main(argc: i32, argv: rawptr) -> i32 {
    env_init(argc, argv);
    var o: *Opts = cast(*Opts) alloc(sizeof(Opts));
    mem_zero(cast(*u8) o, sizeof(Opts));
    var cmd: *u8 = "build";
    var npos: i64 = 0;
    STYLE_COLOR = color_wanted(0);
    var i: i64 = 1;
    if i < arg_count() && is_command(arg_get(1)) {
        cmd = arg_get(1);
        i = 2;
    }
    if str_is(cmd, "help") { println(USAGE); ret 0; }
    if str_is(cmd, "version") { println(cat2("Marrow version: ", MARROW_VERSION)); ret 0; }
    if str_is(cmd, "doctor") { ret run_doctor(MARROW_VERSION); }
    if str_is(cmd, "new") || str_is(cmd, "init") {
        var lib: bool = false;
        var pname: *u8 = null;
        for var k: i64 = 2; k < arg_count(); k += 1 {
            var x: *u8 = arg_get(k);
            if str_is(x, "--lib") { lib = true; }
            else if x[0] == 45 && str_len(x) > 1 { fatal(cat3("unknown option `", x, "`"), 2); }
            else if pname == null { pname = x; }
            else { fatal(cat3("unexpected argument `", x, "`"), 2); }
        }
        if str_is(cmd, "init") { ret cmd_init(lib); }
        if pname == null { fatal_h("`marrow new` needs a name", "usage: marrow new <name> [--lib]", 2); }
        ret cmd_new(pname, lib);
    }
    if str_is(cmd, "add") { ret cmd_add(2); }
    if str_is(cmd, "remove") { ret cmd_remove(); }
    if str_is(cmd, "install") { ret cmd_install(false); }
    if str_is(cmd, "update") { ret cmd_install(true); }
    if str_is(cmd, "tree") { ret cmd_tree(); }
    if str_is(cmd, "search") { ret cmd_search(); }
    if str_is(cmd, "check") { o.check_only = true; }
    var prog_args: i64 = -1;   // index of the first argument after `--` (run)
    while i < arg_count() {
        var a: *u8 = arg_get(i);
        if str_is(a, "--") && str_is(cmd, "run") {
            prog_args = i + 1;
            break;
        } else if str_is(a, "--version") || str_is(a, "-V") {
            println(cat2("Marrow version: ", MARROW_VERSION));
            ret 0;
        } else if str_is(a, "--help") || str_is(a, "-h") {
            println(USAGE);
            ret 0;
        } else if str_is(a, "--check") {
            o.check_only = true;
        } else if str_is(a, "--nostdlib") {
            o.nostdlib = true;
        } else if str_is(a, "--target") {
            i += 1;
            if i >= arg_count() { fatal_h("option `--target` requires a value", "example: `--target aarch64-linux`", 2); }
            o.target_arg = arg_get(i);
        } else if str_starts_with(a, "--target=") {
            o.target_arg = a + 9;
        } else if str_is(a, "--color") {
            i += 1;
            if i >= arg_count() { fatal_h("option `--color` requires a value", "possible values are `auto`, `always` and `never`", 2); }
            parse_color(arg_get(i));
        } else if str_starts_with(a, "--color=") {
            parse_color(a + 8);
        } else if a[0] == 45 && str_len(a) > 1 {
            var h: *u8 = "run `marrow --help` to see the available options";
            if str_is(cmd, "run") { h = "to pass arguments to the program, put them after `--`"; }
            fatal_h(cat3("unknown option `", a, "`"), h, 2);
        } else {
            if npos == 0 { o.input = a; }
            else if npos == 1 && str_is(cmd, "build") { o.output = a; }
            else { fatal_h(cat3("unexpected argument `", a, "`"), "run `marrow help` to see how to call the compiler", 2); }
            npos += 1;
        }
        i += 1;
    }
    // Inside a project (a `marrow.toml` in the input's directory or above), the dependencies
    // are resolved first and can be imported by name.
    var proj: *u8 = null;
    if o.input == null { proj = cmd_root(); }
    else if file_exists(o.input) != 0 { proj = pk_find_root(path_dirname(o.input)); }
    if proj != null {
        var rn: *PNode = pk_resolve_project(proj, false);
        PKG_DEPS = pk_dep_entries(rn);
        if o.input == null {
            o.input = path_join(proj, rn.manifest.main);
            if !o.check_only {
                var bdir: *u8 = path_join(proj, "build");
                dir_create_all(bdir);
                o.output = path_join(bdir, cat2(rn.name, ".ssa"));
                o.exe_path = path_join(bdir, rn.name);
            }
        }
    }
    var rc: i32 = compile(o);
    if rc != 0 || !str_is(cmd, "run") { ret rc; }
    if o.exe == null {
        fatal("nothing to run: the input is a library (`@no_main`)", 2);
    }
    if o.target_arg != null { 
        var t: *Target = target_parse(o.target_arg);
        if t != null && !target_is_host(t) { fatal("cannot run a program built for another target", 2); }
    }
    var rcmd: *String = string_new(128);
    string_push_str(rcmd, shq(exe_command_path(o.exe)));
    if prog_args >= 0 {
        for var k: i64 = prog_args; k < arg_count(); k += 1 {
            string_push_char(rcmd, 32);
            string_push_str(rcmd, shq(arg_get(k)));
        }
    }
    var st: i32 = exec(rcmd.data);
    if st < 0 { fatal(cat3("failed to run `", o.exe, "`"), 2); }
    ret st;
}
