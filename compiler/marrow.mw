// `marrow`, the Marrow compiler written in Marrow: the same pipeline as src/main.rs
// (load imports -> lower -> type check -> QBE IL -> `qbe` -> `cc`).
//
// What differs from the Rust driver: diagnostics show the message and the source line
// with the primary span underlined, in the layout of the Rust renderer, but without the
// notes, help texts, secondary labels and suggestions (the Marrow passes do not carry
// them) and without colors, and `--color` is accepted and ignored. The generated IL and assembly are
// identical.

@import("codegen.mw")
@import("runtime.mw")

var USAGE: *u8 = "Usage: marrow [OPTIONS] <input.mw> [output.ssa]\n\nOptions:\n      --check            Type-check the program and stop (no code is generated)\n      --nostdlib         Link without libc: use Marrow's own `_start` and syscall stub\n      --target <T>       Target as <arch>-<os>, e.g. x86_64-linux, aarch64-linux, riscv64-linux\n                         (default: the host; cross targets only emit assembly)\n      --color <WHEN>     Accepted for compatibility (diagnostics are never colored)\n  -V, --version          Print the compiler version\n  -h, --help             Print this help";

fn fatal(msg: *u8, code: i32) {
    eprint("error: ");
    eprintln(msg);
    exit(code);
}

// `path` with its last extension replaced by `ext` (without the dot; may be empty).
fn with_extension(path: *u8, ext: *u8) -> *u8 {
    var n: i64 = str_len(path);
    var dot: i64 = -1;
    var i: i64 = n - 1;
    while i >= 0 && path[i] != 47 {
        if path[i] == 46 { dot = i; break; }
        i -= 1;
    }
    var stem: *u8 = path;
    if dot > 0 { stem = str_dup_n(path, dot); }
    if str_len(ext) == 0 { ret stem; }
    ret cat3(stem, ".", ext);
}

var N_ERRORS: i64 = 0;
var N_WARNINGS: i64 = 0;

fn digits(n: i64) -> i64 {
    var d: i64 = 1;
    var m: i64 = n;
    while m >= 10 { m = m / 10; d += 1; }
    ret d;
}

fn push_spaces(s: *String, n: i64) {
    for var i: i64 = 0; i < n; i += 1 { string_push_char(s, 32); }
}

// Renders a diagnostic like src/diagnostic.rs does for one primary label without text,
// notes or suggestions (those are not carried by the Marrow passes), without colors.
fn render_diag(ld: *Loader, d: *Diag) -> *String {
    var out: *String = string_new(256);
    var warn: bool = d.code[0] == 87;
    if warn { string_push_str(out, "warning["); } else { string_push_str(out, "error["); }
    string_push_str(out, d.code);
    string_push_str(out, "]: ");
    string_push_str(out, d.msg);
    string_push_char(out, 10);
    if d.file < 0 { ret out; }
    var sf: *SourceFile = cast(*SourceFile) vec_ptr_get(ld.files, d.file);
    var src: *String = sf.src;
    // find the line holding character offset d.start
    var line_no: i64 = 1;
    var line_start: i64 = 0;       // byte offset
    var seen: i64 = 0;             // characters before line_start
    var i: i64 = 0;
    var cseen: i64 = 0;
    while i < src.len {
        var b: u8 = src.data[i];
        if (b & 192) != 128 {
            if cseen == d.start { break; }
            cseen += 1;
            if b == 10 { line_no += 1; line_start = i + 1; seen = cseen; }
        }
        i += 1;
    }
    var line_end: i64 = line_start;
    while line_end < src.len && src.data[line_end] != 10 { line_end += 1; }
    if line_end > line_start && src.data[line_end - 1] == 13 { line_end -= 1; }

    var pad: i64 = digits(line_no);
    // start/end in characters relative to the line
    var s_rel: i64 = d.start - seen;
    var e_rel: i64 = d.end - seen;
    var text: *String = string_new(line_end - line_start + 16);
    var col: i64 = 0;
    var ds: i64 = -1;
    var de: i64 = -1;
    var ci: i64 = 0;
    var p: i64 = line_start;
    while p < line_end {
        if ci == s_rel { ds = col; }
        if ci == e_rel { de = col; }
        var b: u8 = src.data[p];
        if b == 9 {
            string_push_str(text, "    ");
            col += 4;
            p += 1;
        } else {
            string_push_char(text, b);
            p += 1;
            while p < line_end && (src.data[p] & 192) == 128 { string_push_char(text, src.data[p]); p += 1; }
            col += 1;
        }
        ci += 1;
    }
    if ds < 0 { ds = col; }
    if de < 0 { de = col; }
    if de <= ds { de = ds + 1; }

    push_spaces(out, pad);
    string_push_str(out, "--> ");
    string_push_str(out, sf.name);
    string_push_char(out, 58);
    string_push_i64(out, line_no);
    string_push_char(out, 58);
    string_push_i64(out, d.start - seen + 1);
    string_push_char(out, 10);
    push_spaces(out, pad + 1);
    string_push_str(out, "|\n");
    string_push_i64(out, line_no);
    string_push_str(out, " | ");
    string_push_str(out, text.data);
    string_push_char(out, 10);
    push_spaces(out, pad + 1);
    string_push_str(out, "| ");
    push_spaces(out, ds);
    for var k: i64 = ds; k < de; k += 1 { string_push_char(out, 94); }
    string_push_char(out, 10);
    ret out;
}

fn print_diag(ld: *Loader, d: *Diag) {
    if d.code[0] == 87 { N_WARNINGS += 1; } else { N_ERRORS += 1; }
    var r: *String = render_diag(ld, d);
    eprintln(r.data);
}

fn finish_diags() {
    if N_ERRORS > 0 {
        var msg: *String = string_new(64);
        string_push_str(msg, "error: aborting due to ");
        if N_ERRORS == 1 { string_push_str(msg, "1 previous error"); }
        else { string_push_i64(msg, N_ERRORS); string_push_str(msg, " previous errors"); }
        if N_WARNINGS > 0 {
            string_push_str(msg, "; ");
            string_push_i64(msg, N_WARNINGS);
            if N_WARNINGS == 1 { string_push_str(msg, " warning emitted"); } else { string_push_str(msg, " warnings emitted"); }
        }
        eprintln(msg.data);
    } else if N_WARNINGS > 0 {
        var msg: *String = string_new(32);
        string_push_str(msg, "warning: ");
        string_push_i64(msg, N_WARNINGS);
        if N_WARNINGS == 1 { string_push_str(msg, " warning emitted"); } else { string_push_str(msg, " warnings emitted"); }
        eprintln(msg.data);
    }
}

// Single-quoted for `/bin/sh`.
fn shq(s: *u8) -> *u8 {
    var out: *String = string_new(str_len(s) + 8);
    string_push_char(out, 39);
    for var i: i64 = 0; s[i] != 0; i += 1 {
        if s[i] == 39 { string_push_str(out, "'\\''"); } else { string_push_char(out, s[i]); }
    }
    string_push_char(out, 39);
    ret out.data;
}

fn run_cmd(cmd: *u8, what: *u8) {
    var st: i32 = exec(cmd);
    if st == 127 || st < 0 {
        fatal(cat3("failed to execute `", what, "`"), 2);
    }
    if st != 0 {
        fatal(cat5("`", what, "` failed with exit code ", i64_str(cast(i64) st), ""), 1);
    }
}

@export fn main(argc: i32, argv: rawptr) -> i32 {
    env_init(argc, argv);
    var check_only: bool = false;
    var nostdlib: bool = false;
    var target_arg: *u8 = null;
    var input: *u8 = null;
    var output: *u8 = null;
    var npos: i64 = 0;
    var i: i64 = 1;
    while i < arg_count() {
        var a: *u8 = arg_get(i);
        if str_is(a, "--version") || str_is(a, "-V") {
            println("Marrow version: v0.1.0");
            ret 0;
        } else if str_is(a, "--help") || str_is(a, "-h") {
            println(USAGE);
            ret 0;
        } else if str_is(a, "--check") {
            check_only = true;
        } else if str_is(a, "--nostdlib") {
            nostdlib = true;
        } else if str_is(a, "--target") {
            i += 1;
            if i >= arg_count() { fatal("option `--target` requires a value", 2); }
            target_arg = arg_get(i);
        } else if str_is(a, "--color") {
            i += 1;
            if i >= arg_count() { fatal("option `--color` requires a value", 2); }
        } else if str_starts_with(a, "--color=") {
        } else if a[0] == 45 && str_len(a) > 1 {
            fatal(cat3("unknown option `", a, "`"), 2);
        } else {
            if npos == 0 { input = a; }
            else if npos == 1 { output = a; }
            else { fatal(cat3("unexpected argument `", a, "`"), 2); }
            npos += 1;
        }
        i += 1;
    }
    if input == null {
        eprintln(USAGE);
        ret 2;
    }
    if file_exists(input) == 0 {
        fatal(cat3("input file `", input, "` not found"), 2);
    }
    if output == null { output = with_extension(input, "ssa"); }

    var target: *Target = target_host();
    if target_arg != null {
        target = target_parse(target_arg);
        if target == null { fatal(cat3("unknown target `", target_arg, "`"), 2); }
    }

    var ld: *Loader = loader_new(target_dir_name(target), path_dirname(input));
    var is_library: bool = false;
    var ok: bool = load_with_imports(ld, input, &is_library);
    for var k: i64 = 0; k < vec_ptr_len(ld.diags); k += 1 { print_diag(ld, cast(*Diag) vec_ptr_get(ld.diags, k)); }
    if !ok || vec_ptr_len(ld.diags) > 0 { finish_diags(); ret 1; }

    var lw: *Lw = lw_new();
    lower_program(lw, ld.items);
    var bad: bool = false;
    for var k: i64 = 0; k < vec_ptr_len(lw.diags); k += 1 {
        var d: *Diag = cast(*Diag) vec_ptr_get(lw.diags, k);
        if d.code[0] != 87 { bad = true; }
        print_diag(ld, d);
    }
    if bad { finish_diags(); ret 1; }

    var ck: *Ck = ck_new();
    check_program(ck, lw.out);
    var failed: bool = false;
    for var k: i64 = 0; k < vec_ptr_len(ck.diags); k += 1 {
        var d: *Diag = cast(*Diag) vec_ptr_get(ck.diags, k);
        if d.code[0] != 87 { failed = true; }
        print_diag(ld, d);
    }
    finish_diags();
    if failed { ret 1; }
    if check_only {
        eprintln("Check finished: no errors found.");
        ret 0;
    }

    var names: *VecPtr = vec_ptr_new(16);
    for var k: i64 = 0; k < vec_ptr_len(ld.files); k += 1 {
        var sf: *SourceFile = cast(*SourceFile) vec_ptr_get(ld.files, k);
        vec_ptr_push(names, cast(rawptr) canon_path(sf.name));
    }
    var il: *String = generate(names, lw.out);
    if write_string_to_file(output, il) == 0 {
        fatal(cat3("failed to write `", output, "`"), 2);
    }

    var asm_path: *u8 = with_extension(output, "s");
    var qcmd: *String = string_new(128);
    string_push_str(qcmd, "qbe");
    if target_arg != null { string_push_str(qcmd, cat2(" -t ", target_qbe_target(target))); }
    string_push_str(qcmd, cat5(" ", shq(output), " -o ", shq(asm_path), ""));
    run_cmd(qcmd.data, "qbe");

    var cross: bool = target_arg != null && !target_is_host(target);
    if nostdlib && !target_nostdlib_supported(target) {
        fatal(cat3("`--nostdlib` is not supported on ", target_dir_name(target), " yet"), 2);
    }
    var asm: *String = target_adapt_asm(target, read_to_string(asm_path).data);
    string_push_str(asm, target_runtime_asm(target, nostdlib));
    if write_string_to_file(asm_path, asm) == 0 {
        fatal(cat3("failed to write `", asm_path, "`"), 2);
    }
    if cross {
        eprintln(cat4("Cross target ", target_dir_name(target), ": assembly written to ", asm_path));
        ret 0;
    }

    var compiler: *u8 = "cc";
    if OS == 2 { compiler = "gcc"; }
    if is_library {
        var obj: *u8 = with_extension(input, "o");
        run_cmd(cat7(compiler, " -c ", shq(asm_path), " -o ", shq(obj), "", ""), compiler);
        eprintln(cat5("Library compiled (no `main`, see `@no_main`): ", obj, "\nLink it into a program with: cc your_program.o ", obj, " -o your_program"));
        ret 0;
    }
    var exe: *u8 = with_extension(input, "");
    var lcmd: *String = string_new(128);
    string_push_str(lcmd, compiler);
    if nostdlib && target_freestanding_link(target) { string_push_str(lcmd, " -nostdlib -static"); }
    if OS == 2 { string_push_str(lcmd, " -lws2_32"); }
    string_push_str(lcmd, cat5(" ", shq(asm_path), " -o ", shq(exe), ""));
    run_cmd(lcmd.data, compiler);
    eprintln(cat2("Compilation successful! Executable created at: ", exe));
    ret 0;
}
