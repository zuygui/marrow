// Printing of `f64` values the way Rust's `{}` does: the shortest decimal string that
// reads back as the same number (and the closest one among those), never in
// scientific notation, and without a trailing `.0`. The digits come from the
// free-format algorithm of Burger and Dybvig on a small bignum.

@import("../std/std.mw")
@import("../std/math.mw")

struct Big {
    d: *u32;     // little-endian 32-bit limbs
    n: i64;      // limbs in use
}

var BIG_CAP: i64 = 160;

fn big_new() -> *Big {
    var b: *Big = cast(*Big) alloc(sizeof(Big));
    b.d = cast(*u32) alloc(BIG_CAP * 4);
    mem_zero(cast(*u8) b.d, BIG_CAP * 4);
    b.n = 0;
    ret b;
}

fn big_from_u64(v: u64) -> *Big {
    var b: *Big = big_new();
    b.d[0] = cast(u32) (v & 4294967295);
    b.d[1] = cast(u32) (v >> 32);
    b.n = 2;
    big_trim(b);
    ret b;
}

fn big_trim(b: *Big) {
    while b.n > 0 && b.d[b.n - 1] == 0 { b.n -= 1; }
}

fn big_free(b: *Big) {
    dealloc(cast(*u8) b.d);
    dealloc(cast(*u8) b);
}

fn big_copy(a: *Big) -> *Big {
    var b: *Big = big_new();
    for var i: i64 = 0; i < a.n; i += 1 { b.d[i] = a.d[i]; }
    b.n = a.n;
    ret b;
}

fn big_mul_small(a: *Big, m: u32) {
    var carry: u64 = 0;
    for var i: i64 = 0; i < a.n; i += 1 {
        var x: u64 = cast(u64) a.d[i];
        var y: u64 = cast(u64) m;
        var t: u64 = x * y + carry;
        a.d[i] = cast(u32) (t & 4294967295);
        carry = t >> 32;
    }
    if carry != 0 {
        a.d[a.n] = cast(u32) carry;
        a.n += 1;
    }
}

fn big_shl(a: *Big, bits: i64) {
    var words: i64 = bits / 32;
    var rem: u64 = cast(u64) (bits % 32);
    if a.n == 0 { ret; }
    if words > 0 {
        for var i: i64 = a.n - 1; i >= 0; i -= 1 { a.d[i + words] = a.d[i]; }
        for var i: i64 = 0; i < words; i += 1 { a.d[i] = 0; }
        a.n += words;
    }
    if rem > 0 {
        var carry: u64 = 0;
        for var i: i64 = 0; i < a.n; i += 1 {
            var x: u64 = cast(u64) a.d[i];
            var t: u64 = (x << rem) | carry;
            a.d[i] = cast(u32) (t & 4294967295);
            carry = t >> 32;
        }
        if carry != 0 {
            a.d[a.n] = cast(u32) carry;
            a.n += 1;
        }
    }
}

// -1, 0, 1
fn big_cmp(a: *Big, b: *Big) -> i64 {
    if a.n != b.n {
        if a.n < b.n { ret -1; }
        ret 1;
    }
    for var i: i64 = a.n - 1; i >= 0; i -= 1 {
        if a.d[i] != b.d[i] {
            if a.d[i] < b.d[i] { ret -1; }
            ret 1;
        }
    }
    ret 0;
}

fn big_add(a: *Big, b: *Big) -> *Big {
    var r: *Big = big_new();
    var n: i64 = a.n;
    if b.n > n { n = b.n; }
    var carry: u64 = 0;
    for var i: i64 = 0; i < n; i += 1 {
        var x: u64 = 0;
        var y: u64 = 0;
        if i < a.n { x = cast(u64) a.d[i]; }
        if i < b.n { y = cast(u64) b.d[i]; }
        var t: u64 = x + y + carry;
        r.d[i] = cast(u32) (t & 4294967295);
        carry = t >> 32;
    }
    r.n = n;
    if carry != 0 {
        r.d[n] = cast(u32) carry;
        r.n = n + 1;
    }
    ret r;
}

// a - b, requires a >= b.
fn big_sub(a: *Big, b: *Big) -> *Big {
    var r: *Big = big_new();
    var borrow: i64 = 0;
    for var i: i64 = 0; i < a.n; i += 1 {
        var x: i64 = cast(i64) a.d[i];
        var y: i64 = 0;
        if i < b.n { y = cast(i64) b.d[i]; }
        var t: i64 = x - y - borrow;
        // branch-free: QBE's rv64 backend asserts on the `borrow = 1 / 0` phi of the branchy form
        var sign: u64 = cast(u64) t;
        borrow = cast(i64) (sign >> 63);
        t += borrow * 4294967296;
        r.d[i] = cast(u32) t;
    }
    r.n = a.n;
    big_trim(r);
    ret r;
}

fn big_pow2(k: i64) -> *Big {
    var b: *Big = big_from_u64(1);
    big_shl(b, k);
    ret b;
}

// The value of a decimal digit string, for the final output of `f64_shortest`.
fn push_digits(s: *String, digits: *u8, n: i64) {
    for var i: i64 = 0; i < n; i += 1 { string_push_char(s, digits[i]); }
}

// Shortest round-trip rendering of a finite, positive `v`.
fn f64_positive(v: f64) -> *u8 {
    var bits: u64 = f64_to_bits(v);
    var frac: u64 = bits & 4503599627370495;
    var bexp: i64 = cast(i64) ((bits >> 52) & 2047);
    var m: u64 = frac;
    var e: i64 = 0;
    if bexp == 0 {
        e = -1074;
    } else {
        m = m | 4503599627370496;
        e = bexp - 1075;
    }
    var even: bool = (m & 1) == 0;
    var r: *Big = null;
    var s: *Big = null;
    var mplus: *Big = null;
    var mminus: *Big = null;
    var boundary: bool = frac == 0 && bexp > 1;
    if e >= 0 {
        if !boundary {
            r = big_from_u64(m);
            big_shl(r, e + 1);
            s = big_from_u64(2);
            mplus = big_pow2(e);
            mminus = big_pow2(e);
        } else {
            r = big_from_u64(m);
            big_shl(r, e + 2);
            s = big_from_u64(4);
            mplus = big_pow2(e + 1);
            mminus = big_pow2(e);
        }
    } else {
        if !boundary {
            r = big_from_u64(m);
            big_shl(r, 1);
            s = big_pow2(-e + 1);
            mplus = big_from_u64(1);
            mminus = big_from_u64(1);
        } else {
            r = big_from_u64(m);
            big_shl(r, 2);
            s = big_pow2(-e + 2);
            mplus = big_from_u64(2);
            mminus = big_from_u64(1);
        }
    }
    // Estimate k = ceil(log10(v)) and scale so that 0.1 <= r/s < 1 (the estimate is
    // fixed up below).
    var k: i64 = 0;
    {
        // log10(v) ~ (e + 52) * log10(2)
        var ee: f64 = cast(f64) (e + 52);
        var est: f64 = ee * 0.30102999566398114;
        k = cast(i64) est;
        if est > 0.0 { k += 1; }
    }
    if k >= 0 {
        for var i: i64 = 0; i < k; i += 1 { big_mul_small(s, 10); }
    } else {
        for var i: i64 = 0; i < -k; i += 1 {
            big_mul_small(r, 10);
            big_mul_small(mplus, 10);
            big_mul_small(mminus, 10);
        }
    }
    // fixup: if r + m+ >= s (or > when not even) then k is too small
    var hi: *Big = big_add(r, mplus);
    var c: i64 = big_cmp(hi, s);
    var too_small: bool = false;
    if even { too_small = c >= 0; } else { too_small = c > 0; }
    if too_small {
        big_mul_small(s, 10);
        k += 1;
    } else {
        // maybe k is too large: then (r + m+) * 10 < s
        var t: *Big = big_copy(hi);
        big_mul_small(t, 10);
        var c2: i64 = big_cmp(t, s);
        big_free(t);
        var too_big: bool = false;
        if even { too_big = c2 < 0; } else { too_big = c2 <= 0; }
        if too_big {
            big_mul_small(r, 10);
            big_mul_small(mplus, 10);
            big_mul_small(mminus, 10);
            k -= 1;
        }
    }
    big_free(hi);
    // Digit generation.
    var digits: *u8 = alloc(40);
    var nd: i64 = 0;
    while true {
        big_mul_small(r, 10);
        big_mul_small(mplus, 10);
        big_mul_small(mminus, 10);
        // d = floor(r / s) by repeated subtraction (d < 10)
        var d: i64 = 0;
        while big_cmp(r, s) >= 0 {
            var nr: *Big = big_sub(r, s);
            big_free(r);
            r = nr;
            d += 1;
        }
        var c1: i64 = big_cmp(r, mminus);
        var tc1: bool = false;
        if even { tc1 = c1 <= 0; } else { tc1 = c1 < 0; }
        var sum: *Big = big_add(r, mplus);
        var c3: i64 = big_cmp(sum, s);
        big_free(sum);
        var tc2: bool = false;
        if even { tc2 = c3 >= 0; } else { tc2 = c3 > 0; }
        if !tc1 && !tc2 {
            digits[nd] = cast(u8) (48 + d);
            nd += 1;
            continue;
        }
        var last: i64 = d;
        if tc1 && !tc2 {
            last = d;
        } else if !tc1 && tc2 {
            last = d + 1;
        } else {
            var twice: *Big = big_copy(r);
            big_shl(twice, 1);
            if big_cmp(twice, s) < 0 { last = d; } else { last = d + 1; }
            big_free(twice);
        }
        digits[nd] = cast(u8) (48 + last);
        nd += 1;
        break;
    }
    // The digit may have become 10 after rounding up (cannot happen for the shortest
    // output, but stay safe).
    big_free(r);
    big_free(s);
    big_free(mplus);
    big_free(mminus);
    var out: *String = string_new(32);
    if k <= 0 {
        string_push_str(out, "0.");
        for var i: i64 = 0; i < -k; i += 1 { string_push_char(out, 48); }
        push_digits(out, digits, nd);
    } else if k >= nd {
        push_digits(out, digits, nd);
        for var i: i64 = 0; i < k - nd; i += 1 { string_push_char(out, 48); }
    } else {
        push_digits(out, digits, k);
        string_push_char(out, 46);
        push_digits(out, digits + k, nd - k);
    }
    ret out.data;
}

// `x` formatted like Rust's `{}`.
fn f64_shortest(x: f64) -> *u8 {
    if is_nan(x) { ret "NaN"; }
    if x == math_inf() { ret "inf"; }
    if x == 0.0 - math_inf() { ret "-inf"; }
    var bits: u64 = f64_to_bits(x);
    var neg: bool = (bits >> 63) == 1;
    var mag: f64 = x;
    if neg { mag = 0.0 - x; }
    var body: *u8 = "0";
    if mag != 0.0 { body = f64_positive(mag); }
    if neg { ret str_concat("-", body); }
    ret body;
}
