// `lexdump <file>`: prints the tokens produced by the Marrow lexer, in the same
// format as `marrow --dump-tokens` (used to check both lexers against each other).

@import("../std/std.mw")
@import("lexer.mw")

fn hex_digit(v: i64) -> u8 {
    if v < 10 { ret cast(u8) (48 + v); }
    ret cast(u8) (87 + v);
}

fn print_escaped(s: *u8, n: i64) {
    for var i: i64 = 0; i < n; i += 1 {
        var b: u8 = s[i];
        if b >= 32 && b < 127 && b != 92 && b != 34 {
            print_char(b);
        } else {
            print("\\x");
            print_char(hex_digit(cast(i64) (b >> 4)));
            print_char(hex_digit(cast(i64) (b & 15)));
        }
    }
}

@export fn main(argc: i32, argv: rawptr) -> i32 {
    env_init(argc, argv);
    if arg_count() < 2 {
        eprintln("usage: lexdump <file>");
        ret 2;
    }
    var src: *String = read_to_string(arg_get(1));
    if src == null { ret 2; }
    var lx: *Lexer = lexer_new(src.data, src.len);
    lex_all(lx);
    if lx.failed {
        print("Error ");
        print(lx.err_code);
        print(" ");
        print_i64(lx.err_start);
        print(" ");
        print_i64(lx.err_end);
        print("\n");
        ret 1;
    }
    var n: i64 = vec_ptr_len(lx.tokens);
    for var i: i64 = 0; i < n; i += 1 {
        var t: *Token = cast(*Token) vec_ptr_get(lx.tokens, i);
        print(tok_kind_name(t.kind));
        print(" ");
        print_i64(t.start);
        print(" ");
        print_i64(t.end);
        match t.kind {
            TokKind::Identifier => { print(" "); print_escaped(t.text, t.text_len); }
            TokKind::FloatLiteral => { print(" "); print(t.text); }
            TokKind::StringLiteral => { print(" "); print_escaped(t.text, t.text_len); }
            TokKind::IntLiteral => { print(" "); print_u64(t.int_val); }
            TokKind::CharLiteral => { print(" "); print_i64(t.char_val); }
            else => { }
        }
        print("\n");
    }
    ret 0;
}
