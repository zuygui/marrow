// The Marrow parser, written in Marrow. A port of src/parser.rs that builds the
// generic `Node` tree of ast.mw.
//
// On a syntax error the parser records the first error (code and primary span,
// exactly where the Rust parser puts it) and unwinds by returning dummy nodes;
// every loop checks `p.failed` so nothing spins.

@import("lexer.mw")
@import("lints.mw")
@import("ast.mw")
@import("floatfmt.mw")

struct Parser {
    toks: *VecPtr;
    pos: i64;
    ntoks: i64;
    allow_struct_lit: bool;
    line_starts: *VecI64;
    failed: bool;
    err_code: *u8;
    err_start: i64;
    err_end: i64;
    err_msg: *u8;
    err_label: *u8;
    err_help: *u8;
    err_note: *u8;
    sec_text: *u8;     // secondary label (null when none)
    sec_start: i64;
    sec_end: i64;
    file: i64;      // id of the file being parsed (stored on `Item` nodes)
    depth: i64;     // nesting of expressions, types and blocks being parsed
}

fn parser_new(lx: *Lexer) -> *Parser {
    var p: *Parser = cast(*Parser) alloc(sizeof(Parser));
    mem_zero(cast(*u8) p, sizeof(Parser));
    p.toks = lx.tokens;
    p.ntoks = vec_ptr_len(lx.tokens);
    p.allow_struct_lit = true;
    // Character offsets at which each line starts.
    p.line_starts = cast(*VecI64) vec_i64_new(64);
    vec_i64_push(p.line_starts, 0);
    var chars: i64 = 0;
    for var i: i64 = 0; i < lx.len; i += 1 {
        var b: i64 = cast(i64) lx.src[i];
        if (b & 192) != 128 { chars += 1; }
        if b == 10 { vec_i64_push(p.line_starts, chars); }
    }
    ret p;
}

// ---- tokens ------------------------------------------------------------------

fn tok_at(p: *Parser, off: i64) -> *Token {
    var i: i64 = p.pos + off;
    if i >= p.ntoks { i = p.ntoks - 1; }
    ret cast(*Token) vec_ptr_get(p.toks, i);
}

fn cur(p: *Parser) -> *Token { ret tok_at(p, 0); }

fn kind(p: *Parser) -> TokKind { ret tok_at(p, 0).kind; }

fn at(p: *Parser, k: TokKind) -> bool { ret tok_at(p, 0).kind == k; }

fn at_off(p: *Parser, off: i64, k: TokKind) -> bool { ret tok_at(p, off).kind == k; }

fn cur_start(p: *Parser) -> i64 { ret cur(p).start; }

// End of the last consumed token.
fn prev_end(p: *Parser) -> i64 {
    if p.pos == 0 { ret cur(p).end; }
    var t: *Token = cast(*Token) vec_ptr_get(p.toks, p.pos - 1);
    ret t.end;
}

fn advance(p: *Parser) {
    if p.pos < p.ntoks - 1 { p.pos += 1; }
}

fn at_eof(p: *Parser) -> bool { ret kind(p) == TokKind::Eof; }

fn is_kw(p: *Parser, off: i64, word: *u8) -> bool {
    var t: *Token = tok_at(p, off);
    if t.kind != TokKind::Identifier { ret false; }
    ret str_eq(t.text, word) == 1;
}

fn str_is(a: *u8, b: *u8) -> bool { ret str_eq(a, b) == 1; }

fn is_keyword(s: *u8) -> bool {
    ret str_is(s, "fn") || str_is(s, "struct") || str_is(s, "var") || str_is(s, "ret")
        || str_is(s, "if") || str_is(s, "else") || str_is(s, "while") || str_is(s, "for")
        || str_is(s, "cast") || str_is(s, "true") || str_is(s, "false") || str_is(s, "null")
        || str_is(s, "va_start") || str_is(s, "va_arg") || str_is(s, "va_end")
        || str_is(s, "break") || str_is(s, "continue") || str_is(s, "sizeof")
        || str_is(s, "enum") || str_is(s, "match")
        || str_is(s, "raw") || str_is(s, "unsafe") || str_is(s, "move") || str_is(s, "const");
}

fn is_builtin_type(s: *u8) -> bool {
    ret str_is(s, "i8") || str_is(s, "i16") || str_is(s, "i32") || str_is(s, "i64")
        || str_is(s, "u8") || str_is(s, "u16") || str_is(s, "u32") || str_is(s, "u64")
        || str_is(s, "f32") || str_is(s, "f64") || str_is(s, "bool") || str_is(s, "rawptr");
}

// ---- errors ------------------------------------------------------------------

fn p_fail(p: *Parser, code: *u8, start: i64, end: i64) -> bool {
    if p.failed { ret false; }
    p.failed = true;
    p.err_code = code;
    p.err_start = start;
    p.err_end = end;
    p.err_msg = "syntax error";
    p.err_label = "";
    ret true;
}

// Nesting limit of expressions, types and blocks: deeper input would overflow the stack of
// the compiler, so it is rejected with an error instead (rustc stops at 128 as well).
var MAX_NESTING: i64 = 200;

fn p_enter(p: *Parser) -> bool {
    p.depth += 1;
    if p.depth > MAX_NESTING {
        var t: *Token = cur(p);
        if p_fail_m(p, "E0206", "this code is nested too deeply", "nesting limit reached here", t.start, t.end) {
            p.err_help = "split it into several statements, or move parts of it into separate functions";
            p.err_note = cat3("the limit is ", i64_str(MAX_NESTING), " levels of parentheses, blocks and types");
        }
        ret false;
    }
    ret true;
}

fn p_leave(p: *Parser) { p.depth -= 1; }

fn p_fail_m(p: *Parser, code: *u8, msg: *u8, label: *u8, start: i64, end: i64) -> bool {
    if !p_fail(p, code, start, end) { ret false; }
    p.err_msg = msg;
    p.err_label = label;
    ret true;
}

// Start of the last consumed token.
fn prev_start(p: *Parser) -> i64 {
    if p.pos == 0 { ret cur(p).start; }
    var t: *Token = cast(*Token) vec_ptr_get(p.toks, p.pos - 1);
    ret t.start;
}

fn tok_symbol(k: TokKind) -> *u8 {
    if k == TokKind::ColonColon { ret "::"; }
    if k == TokKind::Colon { ret ":"; }
    if k == TokKind::Semicolon { ret ";"; }
    if k == TokKind::Comma { ret ","; }
    if k == TokKind::Dot { ret "."; }
    if k == TokKind::DotDot { ret ".."; }
    if k == TokKind::Ellipsis { ret "..."; }
    if k == TokKind::LParen { ret "("; }
    if k == TokKind::RParen { ret ")"; }
    if k == TokKind::LBrace { ret "{"; }
    if k == TokKind::RBrace { ret "}"; }
    if k == TokKind::LBracket { ret "["; }
    if k == TokKind::RBracket { ret "]"; }
    if k == TokKind::Arrow { ret "->"; }
    if k == TokKind::FatArrow { ret "=>"; }
    if k == TokKind::At { ret "@"; }
    if k == TokKind::Eq { ret "="; }
    if k == TokKind::EqEq { ret "=="; }
    if k == TokKind::NotEq { ret "!="; }
    if k == TokKind::Not { ret "!"; }
    if k == TokKind::Lt { ret "<"; }
    if k == TokKind::LtEq { ret "<="; }
    if k == TokKind::Gt { ret ">"; }
    if k == TokKind::GtEq { ret ">="; }
    if k == TokKind::Plus { ret "+"; }
    if k == TokKind::PlusEq { ret "+="; }
    if k == TokKind::Minus { ret "-"; }
    if k == TokKind::MinusEq { ret "-="; }
    if k == TokKind::Star { ret "*"; }
    if k == TokKind::StarEq { ret "*="; }
    if k == TokKind::Slash { ret "/"; }
    if k == TokKind::SlashEq { ret "/="; }
    if k == TokKind::Pipe { ret "|"; }
    if k == TokKind::Caret { ret "^"; }
    if k == TokKind::Tilde { ret "~"; }
    if k == TokKind::Shl { ret "<<"; }
    if k == TokKind::Shr { ret ">>"; }
    if k == TokKind::AmpEq { ret "&="; }
    if k == TokKind::PipeEq { ret "|="; }
    if k == TokKind::CaretEq { ret "^="; }
    if k == TokKind::ShlEq { ret "<<="; }
    if k == TokKind::ShrEq { ret ">>="; }
    if k == TokKind::Percent { ret "%"; }
    if k == TokKind::AmpAmp { ret "&&"; }
    if k == TokKind::PipePipe { ret "||"; }
    if k == TokKind::Amp { ret "&"; }
    ret "?";
}

// Rust's `char::escape_default` for one code point, appended to `out`.
fn push_escape_default(out: *String, c: i64) {
    if c == 9 { string_push_str(out, "\\t"); ret; }
    if c == 13 { string_push_str(out, "\\r"); ret; }
    if c == 10 { string_push_str(out, "\\n"); ret; }
    if c == 39 { string_push_str(out, "\\'"); ret; }
    if c == 34 { string_push_str(out, "\\\""); ret; }
    if c == 92 { string_push_str(out, "\\\\"); ret; }
    if c >= 32 && c < 127 { string_push_char(out, cast(u8) c); ret; }
    string_push_str(out, "\\u{");
    var started: bool = false;
    for var sh: i64 = 28; sh >= 0; sh -= 4 {
        var d: i64 = (c >> sh) & 15;
        if d != 0 || started || sh == 0 {
            started = true;
            if d < 10 { string_push_char(out, cast(u8) (48 + d)); } else { string_push_char(out, cast(u8) (87 + d)); }
        }
    }
    string_push_char(out, 125);
}

// Describes a token the way `describe_kind` does in the Rust parser.
fn describe_token(t: *Token) -> *u8 {
    if t.kind == TokKind::Identifier {
        if is_keyword(t.text) { ret cat3("keyword `", t.text, "`"); }
        ret cat3("identifier `", t.text, "`");
    }
    if t.kind == TokKind::IntLiteral { ret cat3("integer literal `", u64_str(t.int_val), "`"); }
    if t.kind == TokKind::FloatLiteral { ret cat3("float literal `", f64_shortest(t.float_val), "`"); }
    if t.kind == TokKind::StringLiteral {
        var out: *String = cast(*String) string_new(32);
        string_push_str(out, "string literal \"");
        var i: i64 = 0;
        var n: i64 = 0;
        while i < t.text_len && n < 20 {
            var b: i64 = cast(i64) t.text[i];
            var len: i64 = 1;
            var cp: i64 = b;
            if b >= 240 { len = 4; cp = b & 7; }
            else if b >= 224 { len = 3; cp = b & 15; }
            else if b >= 192 { len = 2; cp = b & 31; }
            for var j: i64 = 1; j < len && i + j < t.text_len; j += 1 { cp = (cp << 6) | (cast(i64) t.text[i + j] & 63); }
            push_escape_default(out, cp);
            i += len;
            n += 1;
        }
        if i < t.text_len { string_push_str(out, "..."); }
        string_push_char(out, 34);
        ret out.data;
    }
    if t.kind == TokKind::CharLiteral {
        var out: *String = cast(*String) string_new(16);
        string_push_str(out, "character literal `'");
        push_escape_default(out, t.char_val);
        string_push_str(out, "'`");
        ret out.data;
    }
    if t.kind == TokKind::Eof { ret "end of file"; }
    ret cat3("`", tok_symbol(t.kind), "`");
}

// 0-based line index containing character offset `off`.
fn line_of(p: *Parser, off: i64) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = vec_i64_len(p.line_starts);
    while lo < hi {
        var mid: i64 = (lo + hi) / 2;
        if vec_i64_get(p.line_starts, mid) <= off { lo = mid + 1; } else { hi = mid; }
    }
    if lo == 0 { ret 0; }
    ret lo - 1;
}

// `expected X, found Y`: where the error points depends on whether a missing
// terminator should be reported just after the previous token. Returns true when
// this was the first error (so callers can attach notes).
fn error_expected(p: *Parser, what: *u8, code: *u8, terminator: bool) -> bool {
    var c: *Token = cur(p);
    var msg: *u8 = cat4("expected ", what, ", found ", describe_token(c));
    var label: *u8 = cat2("expected ", what);
    if at_eof(p) && p.pos > 0 {
        var e: i64 = prev_end(p);
        ret p_fail_m(p, code, msg, label, e, e);
    }
    var on_later_line: bool = false;
    if p.pos > 0 {
        on_later_line = line_of(p, prev_end(p)) != line_of(p, c.start);
    }
    if terminator && on_later_line {
        var e: i64 = prev_end(p);
        var first: bool = p_fail_m(p, code, msg, label, e, e);
        if first {
            p.sec_text = "unexpected token";
            p.sec_start = c.start;
            p.sec_end = c.end;
        }
        ret first;
    }
    ret p_fail_m(p, code, msg, label, c.start, c.end);
}

fn unclosed_delimiter(p: *Parser, open_start: i64, open_end: i64) {
    var first: bool = p_fail_m(p, "E0201", "this file contains an unclosed delimiter",
        "unclosed delimiter `{`", open_start, open_end);
    if first {
        p.sec_text = "...the file ends here without closing it";
        p.sec_start = prev_start(p);
        p.sec_end = prev_end(p);
    }
}

fn expect_d(p: *Parser, k: TokKind, desc: *u8) -> bool {
    if at(p, k) {
        advance(p);
        ret true;
    }
    var terminator: bool = k == TokKind::Semicolon || k == TokKind::RParen || k == TokKind::RBracket
        || k == TokKind::RBrace || k == TokKind::Comma;
    error_expected(p, desc, "E0201", terminator);
    ret false;
}

fn expect(p: *Parser, k: TokKind) -> bool {
    ret expect_d(p, k, cat3("`", tok_symbol(k), "`"));
}

// An identifier that is not a keyword; null (and an error) otherwise.
fn expect_ident(p: *Parser, desc: *u8) -> *Token {
    var t: *Token = cur(p);
    if t.kind == TokKind::Identifier {
        if is_keyword(t.text) {
            var first: bool = p_fail_m(p, "E0202", cat4("expected ", desc, ", found keyword `", cat2(t.text, "`")),
                cat3("expected ", desc, ", found reserved word"), t.start, t.end);
            if first {
                p.err_help = cat3("`", t.text, "` is a reserved word and cannot be used as a name; pick another name");
            }
            ret null;
        }
        advance(p);
        ret t;
    }
    error_expected(p, desc, "E0201", false);
    ret null;
}

// ---- node helpers --------------------------------------------------------------

fn mk(kind: NodeKind, start: i64, end: i64) -> *Node { ret node_new(kind, start, end); }

fn mk_none() -> *Node { ret node_new(NodeKind::None, 0, 0); }

fn mk_text(kind: NodeKind, start: i64, end: i64, text: *u8) -> *Node {
    var n: *Node = node_new(kind, start, end);
    node_set_cstr(n, text);
    ret n;
}

// Consumes `>`, splitting a `>>` token when generics are nested.
fn expect_gt(p: *Parser) -> bool {
    var t: *Token = cur(p);
    if t.kind == TokKind::Gt {
        advance(p);
        ret true;
    }
    if t.kind == TokKind::Shr {
        t.kind = TokKind::Gt;
        t.start += 1;
        ret true;
    }
    error_expected(p, "`>`", "E0201", false);
    ret false;
}

// ---- types -------------------------------------------------------------------

// `<A, B>` — the `<` is the current token. Returns a `Types` node.
fn parse_type_args(p: *Parser) -> *Node {
    var n: *Node = mk(NodeKind::Types, 0, 0);
    expect(p, TokKind::Lt);
    while !p.failed {
        node_add(n, parse_type(p));
        if at(p, TokKind::Comma) { advance(p); } else { break; }
    }
    expect_gt(p);
    ret n;
}

fn parse_type(p: *Parser) -> *Node {
    if !p_enter(p) { ret mk_none(); }
    var t: *Node = parse_type_inner(p);
    p_leave(p);
    ret t;
}

// The pointer types of the memory model (a `TyPtr` whose `flags` tell which one it is):
//   `*T` raw pointer (0)   `^T` owning pointer (1)   `&T` shared borrow (2)   `&mut T` mutable borrow (3)
// They all lower to a plain pointer for now: the checks come with the ownership rules.
fn parse_type_inner(p: *Parser) -> *Node {
    var start: i64 = cur_start(p);
    if at(p, TokKind::Caret) || at(p, TokKind::Amp) || at(p, TokKind::AmpAmp) {
        var double: bool = at(p, TokKind::AmpAmp);
        var fl: i64 = 1;
        if !at(p, TokKind::Caret) { fl = 2; }
        advance(p);
        if fl == 2 && !double && is_kw(p, 0, "mut") { advance(p); fl = 3; }
        var inner2: *Node = parse_type(p);
        var n2: *Node = mk(NodeKind::TyPtr, start, prev_end(p));
        n2.flags = fl;
        node_add(n2, inner2);
        if double {
            var outer: *Node = mk(NodeKind::TyPtr, start, prev_end(p));
            outer.flags = 2;
            node_add(outer, n2);
            ret outer;
        }
        ret n2;
    }
    if at(p, TokKind::Star) {
        advance(p);
        var inner: *Node = parse_type(p);
        var n: *Node = mk(NodeKind::TyPtr, start, prev_end(p));
        node_add(n, inner);
        ret n;
    }
    var t: *Node = parse_primary_type(p);
    while !p.failed && at(p, TokKind::LBracket) && at_off(p, 1, TokKind::RBracket) {
        advance(p);
        advance(p);
        var n: *Node = mk(NodeKind::TySlice, start, prev_end(p));
        node_add(n, t);
        t = n;
    }
    ret t;
}

fn parse_primary_type(p: *Parser) -> *Node {
    var start: i64 = cur_start(p);
    if at(p, TokKind::LBracket) {
        advance(p);
        var size: *Node = with_struct_lit(p, true, 0);
        expect(p, TokKind::RBracket);
        var inner: *Node = parse_type(p);
        var n: *Node = mk(NodeKind::TyArray, start, prev_end(p));
        node_add(n, size);
        node_add(n, inner);
        ret n;
    }
    if is_kw(p, 0, "fn") {
        advance(p);
        expect(p, TokKind::LParen);
        var params: *Node = mk(NodeKind::Types, 0, 0);
        while !p.failed && !at(p, TokKind::RParen) {
            node_add(params, parse_type(p));
            if at(p, TokKind::Comma) { advance(p); } else { break; }
        }
        expect(p, TokKind::RParen);
        var ret_ty: *Node = mk_none();
        if at(p, TokKind::Arrow) {
            advance(p);
            ret_ty = parse_type(p);
        }
        var n: *Node = mk(NodeKind::TyFunc, start, prev_end(p));
        node_add(n, params);
        node_add(n, ret_ty);
        ret n;
    }
    var t: *Token = cur(p);
    if t.kind == TokKind::Identifier && !is_keyword(t.text) {
        advance(p);
        var tname: *u8 = t.text;
        var tend: i64 = t.end;
        // `module::Type`
        if at(p, TokKind::ColonColon) && at_off(p, 1, TokKind::Identifier) && !is_keyword(tok_at(p, 1).text) {
            advance(p);
            var u: *Token = cur(p);
            advance(p);
            tname = cat3(t.text, "::", u.text);
            tend = u.end;
        }
        var builtin: bool = is_builtin_type(tname);
        if !builtin && at(p, TokKind::Lt) {
            var args: *Node = parse_type_args(p);
            var n: *Node = mk_text(NodeKind::TyGeneric, start, prev_end(p), tname);
            var count: i64 = node_nkids(args);
            for var i: i64 = 0; i < count; i += 1 { node_add(n, node_kid(args, i)); }
            ret n;
        }
        if builtin { ret mk_text(NodeKind::TyBuiltin, t.start, t.end, t.text); }
        ret mk_text(NodeKind::TyCustom, t.start, tend, tname);
    }
    error_expected(p, "a type", "E0204", false);
    ret mk_none();
}

// ---- expressions ---------------------------------------------------------------

// Runs one of the expression parsers with `allow_struct_lit` set to `allowed`:
// what = 0 expression, 1 expression list (returned as a `Types`-like holder),
// 2 type.
fn with_struct_lit(p: *Parser, allowed: bool, what: i64) -> *Node {
    var old: bool = p.allow_struct_lit;
    p.allow_struct_lit = allowed;
    var r: *Node = null;
    if what == 0 { r = parse_expression(p); }
    else if what == 1 { r = parse_expression_list(p); }
    else { r = parse_type(p); }
    p.allow_struct_lit = old;
    ret r;
}

// A comma-separated list, returned as a node whose kids are the expressions.
fn parse_expression_list(p: *Parser) -> *Node {
    var list: *Node = mk(NodeKind::Types, 0, 0);
    node_add(list, parse_expression(p));
    while !p.failed && at(p, TokKind::Comma) {
        advance(p);
        node_add(list, parse_expression(p));
    }
    ret list;
}

fn parse_expression(p: *Parser) -> *Node {
    if !p_enter(p) { ret mk_none(); }
    var e: *Node = parse_assignment(p);
    p_leave(p);
    ret e;
}

// The compound or plain assignment operator at the cursor, or null.
fn assign_op(k: TokKind) -> *u8 {
    match k {
        TokKind::Eq => { ret "="; }
        TokKind::PlusEq => { ret "+="; }
        TokKind::MinusEq => { ret "-="; }
        TokKind::StarEq => { ret "*="; }
        TokKind::SlashEq => { ret "/="; }
        TokKind::AmpEq => { ret "&="; }
        TokKind::PipeEq => { ret "|="; }
        TokKind::CaretEq => { ret "^="; }
        TokKind::ShlEq => { ret "<<="; }
        TokKind::ShrEq => { ret ">>="; }
        else => { ret null; }
    }
}

fn parse_assignment(p: *Parser) -> *Node {
    var left: *Node = parse_binary(p, 0);
    var op: *u8 = assign_op(kind(p));
    if op == null || p.failed { ret left; }
    var optk: *Token = cur(p);
    advance(p);
    var value: *Node = parse_expression(p);
    var n: *Node = mk_text(NodeKind::Assign, left.start, value.end, op);
    n.a_start = optk.start;
    n.a_end = optk.end;
    node_add(n, left);
    node_add(n, value);
    ret n;
}

// Operator of precedence level `lvl` at kind `k`, or null.
// 0 `||`, 1 `&&`, 2 equality, 3 relational, 4 `|`, 5 `^`, 6 `&`, 7 shifts,
// 8 additive, 9 multiplicative.
fn binary_op(lvl: i64, k: TokKind) -> *u8 {
    if lvl == 0 { if k == TokKind::PipePipe { ret "||"; } }
    else if lvl == 1 { if k == TokKind::AmpAmp { ret "&&"; } }
    else if lvl == 2 {
        if k == TokKind::EqEq { ret "=="; }
        if k == TokKind::NotEq { ret "!="; }
    } else if lvl == 3 {
        if k == TokKind::Lt { ret "<"; }
        if k == TokKind::LtEq { ret "<="; }
        if k == TokKind::Gt { ret ">"; }
        if k == TokKind::GtEq { ret ">="; }
    } else if lvl == 4 { if k == TokKind::Pipe { ret "|"; } }
    else if lvl == 5 { if k == TokKind::Caret { ret "^"; } }
    else if lvl == 6 { if k == TokKind::Amp { ret "&"; } }
    else if lvl == 7 {
        if k == TokKind::Shl { ret "<<"; }
        if k == TokKind::Shr { ret ">>"; }
    } else if lvl == 8 {
        if k == TokKind::Plus { ret "+"; }
        if k == TokKind::Minus { ret "-"; }
    } else if lvl == 9 {
        if k == TokKind::Star { ret "*"; }
        if k == TokKind::Slash { ret "/"; }
        if k == TokKind::Percent { ret "%"; }
    }
    ret null;
}

fn parse_binary(p: *Parser, lvl: i64) -> *Node {
    if lvl == 10 { ret parse_unary(p); }
    var left: *Node = parse_binary(p, lvl + 1);
    while !p.failed {
        var op: *u8 = binary_op(lvl, kind(p));
        if op == null { break; }
        var optk: *Token = cur(p);
        advance(p);
        var right: *Node = parse_binary(p, lvl + 1);
        var n: *Node = mk_text(NodeKind::Binary, left.start, right.end, op);
        n.a_start = optk.start;
        n.a_end = optk.end;
        node_add(n, left);
        node_add(n, right);
        left = n;
    }
    ret left;
}

fn unary_op(k: TokKind) -> *u8 {
    match k {
        TokKind::Minus => { ret "-"; }
        TokKind::Not => { ret "!"; }
        TokKind::Tilde => { ret "~"; }
        TokKind::Amp => { ret "&"; }
        TokKind::Star => { ret "*"; }
        else => { ret null; }
    }
}

fn parse_unary(p: *Parser) -> *Node {
    var start: i64 = cur_start(p);
    // `raw x` is the address of `x` as a raw pointer (`*T`), `&x` borrows it (`&T`), `&mut x` borrows it to modify it (`&mut T`), `move x` hands `x` over (checked later)
    if is_kw(p, 0, "raw") || is_kw(p, 0, "move") {
        var is_raw: bool = is_kw(p, 0, "raw");
        advance(p);
        if !p_enter(p) { ret mk_none(); }
        var operand: *Node = parse_unary(p);
        p_leave(p);
        if !is_raw { ret operand; }
        var addr: *Node = mk_text(NodeKind::Unary, start, operand.end, "raw");
        node_add(addr, operand);
        ret addr;
    }
    // `&mut x`: the address of `x`, to modify it
    if at(p, TokKind::Amp) && is_kw(p, 1, "mut") {
        advance(p);
        advance(p);
        if !p_enter(p) { ret mk_none(); }
        var target: *Node = parse_unary(p);
        p_leave(p);
        var amp: *Node = mk_text(NodeKind::Unary, start, target.end, "&mut");
        node_add(amp, target);
        ret amp;
    }
    var op: *u8 = unary_op(kind(p));
    if op == null { ret parse_postfix(p); }
    advance(p);
    if !p_enter(p) { ret mk_none(); }
    var e: *Node = parse_unary(p);
    p_leave(p);
    var n: *Node = mk_text(NodeKind::Unary, start, e.end, op);
    node_add(n, e);
    ret n;
}

// `[ .. end? ]` after the opening bracket and an optional start expression.
fn finish_slice(p: *Parser, base: *Node, first: *Node) -> *Node {
    advance(p); // `..`
    var end: *Node = mk_none();
    if !at(p, TokKind::RBracket) { end = with_struct_lit(p, true, 0); }
    expect(p, TokKind::RBracket);
    var n: *Node = mk(NodeKind::Slice, base.start, prev_end(p));
    node_add(n, base);
    node_add(n, first);
    node_add(n, end);
    ret n;
}

fn parse_postfix(p: *Parser) -> *Node {
    var e: *Node = parse_primary(p);
    while !p.failed {
        if at(p, TokKind::LBracket) {
            advance(p);
            if at(p, TokKind::DotDot) {
                e = finish_slice(p, e, mk_none());
            } else {
                var first: *Node = with_struct_lit(p, true, 0);
                if at(p, TokKind::DotDot) {
                    e = finish_slice(p, e, first);
                } else {
                    expect(p, TokKind::RBracket);
                    var n: *Node = mk(NodeKind::Index, e.start, prev_end(p));
                    node_add(n, e);
                    node_add(n, first);
                    e = n;
                }
            }
        } else if at(p, TokKind::Dot) {
            advance(p);
            var m: *Token = expect_ident(p, "a member name");
            if m == null { break; }
            var n: *Node = mk_text(NodeKind::Member, e.start, m.end, m.text);
            n.a_start = m.start;
            n.a_end = m.end;
            node_add(n, e);
            e = n;
        } else if at(p, TokKind::LParen) {
            advance(p);
            var n: *Node = mk(NodeKind::Call, e.start, 0);
            node_add(n, e);
            if !at(p, TokKind::RParen) {
                var args: *Node = with_struct_lit(p, true, 1);
                var count: i64 = node_nkids(args);
                for var i: i64 = 0; i < count; i += 1 { node_add(n, node_kid(args, i)); }
            }
            expect(p, TokKind::RParen);
            n.end = prev_end(p);
            e = n;
        } else {
            break;
        }
    }
    ret e;
}

// `Name { field: value, ... }`; the `{` is the current token.
fn parse_struct_initializer(p: *Parser, name: *u8, start: i64, name_end: i64, targs: *Node) -> *Node {
    var lb: *Token = cur(p);
    expect(p, TokKind::LBrace);
    var old: bool = p.allow_struct_lit;
    p.allow_struct_lit = true;
    var n: *Node = mk_text(NodeKind::StructInit, start, 0, name);
    n.a_start = start;
    n.a_end = name_end;
    node_add(n, targs);
    if !at(p, TokKind::RBrace) {
        while !p.failed {
            var f: *Token = expect_ident(p, "a field name");
            if f == null { break; }
            expect(p, TokKind::Colon);
            var v: *Node = parse_expression(p);
            var fi: *Node = mk_text(NodeKind::FieldInit, 0, 0, f.text);
            fi.a_start = f.start;
            fi.a_end = f.end;
            node_add(fi, v);
            node_add(n, fi);
            if p.failed { break; }
            if at(p, TokKind::Comma) {
                advance(p);
                if at(p, TokKind::RBrace) { break; }
            } else {
                break;
            }
        }
    }
    p.allow_struct_lit = old;
    if p.failed { ret n; }
    if at_eof(p) {
        unclosed_delimiter(p, lb.start, lb.end);
        ret n;
    }
    expect(p, TokKind::RBrace);
    n.end = prev_end(p);
    ret n;
}

// `cast(T) e`, `sizeof(T)`, `va_*`: the compiler built-ins.
fn parse_builtin_call(p: *Parser, name: *u8, start: i64) -> *Node {
    advance(p);
    if str_is(name, "cast") {
        expect_d(p, TokKind::LParen, "`(` after `cast`");
        var t: *Node = with_struct_lit(p, true, 2);
        expect_d(p, TokKind::RParen, "`)`");
        var e: *Node = parse_expression(p);
        var n: *Node = mk(NodeKind::Cast, start, e.end);
        node_add(n, t);
        node_add(n, e);
        ret n;
    }
    if str_is(name, "sizeof") {
        expect_d(p, TokKind::LParen, "`(` after `sizeof`");
        var t: *Node = with_struct_lit(p, true, 2);
        expect_d(p, TokKind::RParen, "`)`");
        var n: *Node = mk(NodeKind::SizeOf, start, prev_end(p));
        node_add(n, t);
        ret n;
    }
    if str_is(name, "va_start") {
        expect_d(p, TokKind::LParen, "`(` after `va_start`");
        expect_d(p, TokKind::RParen, "`)` (`va_start` takes no arguments)");
        ret mk(NodeKind::VaStart, start, prev_end(p));
    }
    if str_is(name, "va_arg") {
        expect_d(p, TokKind::LParen, "`(` after `va_arg`");
        var list: *Node = with_struct_lit(p, true, 0);
        expect_d(p, TokKind::Comma, "`,` between the argument list and the type to read");
        var t: *Node = with_struct_lit(p, true, 2);
        expect_d(p, TokKind::RParen, "`)`");
        var n: *Node = mk(NodeKind::VaArg, start, prev_end(p));
        node_add(n, list);
        node_add(n, t);
        ret n;
    }
    // va_end
    expect_d(p, TokKind::LParen, "`(` after `va_end`");
    var list: *Node = with_struct_lit(p, true, 0);
    expect_d(p, TokKind::RParen, "`)`");
    var n: *Node = mk(NodeKind::VaEnd, start, prev_end(p));
    node_add(n, list);
    ret n;
}

// `name::<T>`, `name::<T> { .. }`, `Enum::Variant`, `Enum::<T>::Variant`; the
// name has been consumed and `::` is the current token.
fn parse_path_expr(p: *Parser, name: *u8, start: i64) -> *Node {
    var name_end: i64 = prev_end(p);
    advance(p); // `::`
    var targs: *Node = mk(NodeKind::Types, 0, 0);
    if at(p, TokKind::Lt) {
        targs = parse_type_args(p);
        if !at(p, TokKind::ColonColon) {
            if p.allow_struct_lit && at(p, TokKind::LBrace) {
                ret parse_struct_initializer(p, name, start, name_end, targs);
            }
            var g: *Node = mk_text(NodeKind::GenericRef, start, prev_end(p), name);
            var count: i64 = node_nkids(targs);
            for var i: i64 = 0; i < count; i += 1 { node_add(g, node_kid(targs, i)); }
            ret g;
        }
        advance(p);
    }
    var v: *Token = expect_ident(p, "a variant name");
    if v == null { ret mk_none(); }
    // `module::name::<T>`: a generic function or type of an imported module
    if at(p, TokKind::ColonColon) && at_off(p, 1, TokKind::Lt) && !at_off(p, 0, TokKind::Lt) && node_nkids(targs) == 0 {
        advance(p);
        var mt: *Node = parse_type_args(p);
        var qname: *u8 = cat3(name, "::", v.text);
        if p.allow_struct_lit && at(p, TokKind::LBrace) {
            ret parse_struct_initializer(p, qname, start, prev_end(p), mt);
        }
        var gq: *Node = mk_text(NodeKind::GenericRef, start, prev_end(p), qname);
        var mc: i64 = node_nkids(mt);
        for var i: i64 = 0; i < mc; i += 1 { node_add(gq, node_kid(mt, i)); }
        ret gq;
    }
    // `module::Type { field: .. }`
    if p.allow_struct_lit && node_nkids(targs) == 0 && at(p, TokKind::LBrace)
        && (at_off(p, 1, TokKind::RBrace) || (at_off(p, 1, TokKind::Identifier) && at_off(p, 2, TokKind::Colon))) {
        ret parse_struct_initializer(p, cat3(name, "::", v.text), start, prev_end(p), mk(NodeKind::Types, 0, 0));
    }
    // `module::Enum::Variant`
    if at(p, TokKind::ColonColon) && at_off(p, 1, TokKind::Identifier) {
        advance(p);
        var w: *Token = cur(p);
        advance(p);
        var qtext: *u8 = cat5(name, "::", v.text, "::", w.text);
        var qn: *Node = mk_text(NodeKind::Path, start, prev_end(p), qtext);
        var qc: i64 = node_nkids(targs);
        for var i: i64 = 0; i < qc; i += 1 { node_add(qn, node_kid(targs, i)); }
        ret qn;
    }
    var text: *u8 = alloc(str_len(name) + str_len(v.text) + 3);
    var l1: i64 = str_len(name);
    mem_copy(text, name, l1);
    text[l1] = 58;
    text[l1 + 1] = 58;
    mem_copy(text + l1 + 2, v.text, str_len(v.text) + 1);
    var n: *Node = mk_text(NodeKind::Path, start, prev_end(p), text);
    var count: i64 = node_nkids(targs);
    for var i: i64 = 0; i < count; i += 1 { node_add(n, node_kid(targs, i)); }
    ret n;
}

// `if cond { a } else { b }` used as a value; each branch holds one expression.
fn parse_if_expr(p: *Parser) -> *Node {
    var start: i64 = cur_start(p);
    advance(p); // if
    var cond: *Node = with_struct_lit(p, false, 0);
    expect(p, TokKind::LBrace);
    var a: *Node = with_struct_lit(p, true, 0);
    expect(p, TokKind::RBrace);
    if !is_kw(p, 0, "else") {
        error_expected(p, "`else`: an `if` used as a value needs both branches", "E0205", false);
        ret mk_none();
    }
    advance(p);
    var b: *Node = null;
    if is_kw(p, 0, "if") {
        b = parse_if_expr(p);
    } else {
        expect(p, TokKind::LBrace);
        b = with_struct_lit(p, true, 0);
        expect(p, TokKind::RBrace);
    }
    var n: *Node = mk(NodeKind::IfExpr, start, prev_end(p));
    node_add(n, cond);
    node_add(n, a);
    node_add(n, b);
    ret n;
}

fn parse_primary(p: *Parser) -> *Node {
    var t: *Token = cur(p);
    var start: i64 = t.start;
    if t.kind == TokKind::Identifier {
        var name: *u8 = t.text;
        if str_is(name, "cast") || str_is(name, "sizeof") || str_is(name, "va_start")
            || str_is(name, "va_arg") || str_is(name, "va_end") {
            ret parse_builtin_call(p, name, start);
        }
        if str_is(name, "true") || str_is(name, "false") {
            advance(p);
            ret mk_text(NodeKind::Bool, t.start, t.end, name);
        }
        if str_is(name, "null") {
            advance(p);
            ret mk(NodeKind::Null, t.start, t.end);
        }
        if str_is(name, "if") { ret parse_if_expr(p); }
        if is_keyword(name) {
            error_expected(p, "an expression", "E0205", false);
            ret mk_none();
        }
        advance(p);
        if at(p, TokKind::ColonColon) { ret parse_path_expr(p, name, start); }
        if p.allow_struct_lit && at(p, TokKind::LBrace) {
            ret parse_struct_initializer(p, name, start, prev_end(p), mk(NodeKind::Types, 0, 0));
        }
        ret mk_text(NodeKind::Ident, t.start, t.end, name);
    }
    if t.kind == TokKind::IntLiteral {
        advance(p);
        var buf: *u8 = alloc(24);
        var n: i64 = fmt_u64(buf, t.int_val, 10);
        buf[n] = 0;
        ret mk_text(NodeKind::Int, t.start, t.end, buf);
    }
    if t.kind == TokKind::FloatLiteral {
        advance(p);
        var fnode: *Node = mk(NodeKind::Float, t.start, t.end);
        fnode.fval = t.float_val;
        ret fnode;
    }
    if t.kind == TokKind::StringLiteral {
        advance(p);
        var n: *Node = mk(NodeKind::Str, t.start, t.end);
        node_set_text(n, t.text, t.text_len);
        ret n;
    }
    if t.kind == TokKind::CharLiteral {
        advance(p);
        var buf: *u8 = alloc(24);
        var n: i64 = fmt_i64(buf, t.char_val);
        buf[n] = 0;
        ret mk_text(NodeKind::Char, t.start, t.end, buf);
    }
    if t.kind == TokKind::LParen {
        advance(p);
        var e: *Node = with_struct_lit(p, true, 0);
        expect(p, TokKind::RParen);
        // The span of a parenthesized expression includes the parentheses.
        e.start = start;
        e.end = prev_end(p);
        ret e;
    }
    error_expected(p, "an expression", "E0205", false);
    ret mk_none();
}

// ---- statements ----------------------------------------------------------------

// `{ stmt* }` into `into`'s kids; `into.end` is left to the caller.
fn parse_block_into(p: *Parser, into: *Node) {
    if !p_enter(p) { ret; }
    parse_block_body(p, into);
    p_leave(p);
}

fn parse_block_body(p: *Parser, into: *Node) {
    var lb: *Token = cur(p);
    expect(p, TokKind::LBrace);
    while !p.failed && !at(p, TokKind::RBrace) {
        if at_eof(p) {
            unclosed_delimiter(p, lb.start, lb.end);
            ret;
        }
        node_add(into, parse_statement(p));
    }
    expect(p, TokKind::RBrace);
}

fn parse_block(p: *Parser) -> *Node {
    var b: *Node = mk(NodeKind::Block, 0, 0);
    parse_block_into(p, b);
    ret b;
}

// `var name (: type)? (= expr)?`; the `var` keyword is the current token.
// Fills `into` (text = name, kids = type or None, value).
// The flag of a `const` declaration (the lower bits of `flags` are the lints allowed by `@allow`).
var FLAG_CONST: i64 = 1048576;

fn parse_var_decl_head(p: *Parser, into: *Node, allow_zero: bool) {
    var is_const: bool = is_kw(p, 0, "const");
    if is_const { into.flags = into.flags | FLAG_CONST; }
    advance(p); // var or const
    var name: *Token = expect_ident(p, "variable name");
    if name == null { ret; }
    node_set_cstr(into, name.text);
    into.a_start = name.start;
    into.a_end = name.end;
    var ty: *Node = mk_none();
    var has_ty: bool = false;
    if at(p, TokKind::Colon) {
        advance(p);
        ty = parse_type(p);
        has_ty = true;
    }
    node_add(into, ty);
    if allow_zero && has_ty && at(p, TokKind::Semicolon) && !is_const {
        var t: *Token = cur(p);
        node_add(into, mk(NodeKind::Zeroed, t.start, t.end));
        ret;
    }
    if !at(p, TokKind::Eq) {
        if error_expected(p, "`=`", "E0201", false) {
            p.err_note = "variables must be initialized where they are declared: `var name: Type = value;` (a `const` needs its value too)";
        }
        ret;
    }
    advance(p);
    node_add(into, parse_expression(p));
}

fn parse_if(p: *Parser, n: *Node) {
    advance(p); // if
    node_add(n, with_struct_lit(p, false, 0));
    node_add(n, parse_block(p));
    if is_kw(p, 0, "else") {
        advance(p);
        if is_kw(p, 0, "if") {
            var inner: *Node = mk(NodeKind::ElseIf, 0, 0);
            parse_if(p, inner);
            node_add(n, inner);
        } else {
            node_add(n, parse_block(p));
        }
    } else {
        node_add(n, mk_none());
    }
}

fn parse_match(p: *Parser, n: *Node) {
    advance(p); // match
    node_add(n, with_struct_lit(p, false, 0));
    var lb: *Token = cur(p);
    expect(p, TokKind::LBrace);
    while !p.failed && !at(p, TokKind::RBrace) {
        if at_eof(p) {
            unclosed_delimiter(p, lb.start, lb.end);
            ret;
        }
        var arm_start: i64 = cur_start(p);
        var arm: *Node = mk(NodeKind::Arm, arm_start, 0);
        if is_kw(p, 0, "else") {
            advance(p);
            node_add(arm, mk(NodeKind::Else, 0, 0));
        } else {
            var en: *Token = expect_ident(p, "an enum name");
            if en == null { ret; }
            expect(p, TokKind::ColonColon);
            var en_text: *u8 = en.text;
            // `module::Enum::Variant`
            if at(p, TokKind::Identifier) && at_off(p, 1, TokKind::ColonColon) && at_off(p, 2, TokKind::Identifier) {
                en_text = cat3(en.text, "::", cur(p).text);
                advance(p);
                advance(p);
            }
            var targs: *Node = mk(NodeKind::Types, 0, 0);
            if at(p, TokKind::Lt) {
                targs = parse_type_args(p);
                expect(p, TokKind::ColonColon);
            }
            var v: *Token = expect_ident(p, "a variant name");
            if v == null { ret; }
            var binds: *String = cast(*String) string_new(16);
            var bnodes: *VecPtr = cast(*VecPtr) vec_ptr_new(4);
            if at(p, TokKind::LParen) {
                advance(p);
                var first: bool = true;
                while !p.failed && !at(p, TokKind::RParen) {
                    var b: *Token = expect_ident(p, "a binding name");
                    if b == null { ret; }
                    if !first { string_push_char(binds, 44); }
                    first = false;
                    string_push_str(binds, b.text);
                    vec_ptr_push(bnodes, cast(rawptr) mk_text(NodeKind::Ident, b.start, b.end, b.text));
                    if at(p, TokKind::Comma) { advance(p); } else { break; }
                }
                expect(p, TokKind::RParen);
            }
            var text: *String = cast(*String) string_from(en_text);
            string_push_str(text, "::");
            string_push_str(text, v.text);
            var pat: *Node = mk(NodeKind::Pat, arm_start, prev_end(p));
            node_set_text(pat, text.data, text.len);
            node_add(pat, targs);
            var bn: *Node = mk(NodeKind::Binds, 0, 0);
            node_set_text(bn, binds.data, binds.len);
            for var bi: i64 = 0; bi < vec_ptr_len(bnodes); bi += 1 { node_add(bn, cast(*Node) vec_ptr_get(bnodes, bi)); }
            node_add(pat, bn);
            node_add(arm, pat);
        }
        expect(p, TokKind::FatArrow);
        node_add(arm, parse_block(p));
        if at(p, TokKind::Comma) { advance(p); }
        arm.end = prev_end(p);
        node_add(n, arm);
    }
    expect(p, TokKind::RBrace);
}

fn parse_for(p: *Parser, n: *Node) {
    advance(p); // for
    if !at(p, TokKind::Semicolon) {
        if is_kw(p, 0, "var") {
            var init: *Node = mk(NodeKind::InitVar, 0, 0);
            parse_var_decl_head(p, init, true);
            node_add(n, init);
        } else {
            error_expected(p, "a `var` declaration in the `for` initializer", "E0201", false);
            ret;
        }
    } else {
        node_add(n, mk_none());
    }
    expect(p, TokKind::Semicolon);
    if !at(p, TokKind::Semicolon) { node_add(n, with_struct_lit(p, false, 0)); } else { node_add(n, mk_none()); }
    expect(p, TokKind::Semicolon);
    if !at(p, TokKind::LBrace) { node_add(n, with_struct_lit(p, false, 0)); } else { node_add(n, mk_none()); }
    node_add(n, parse_block(p));
}

// Decorators in front of a statement: only `@allow(lint, ...)` in front of a `var` is accepted.
// Returns the lints it allows, as a mask of bits (see `lint_mask_of`).
fn parse_stmt_decorators(p: *Parser) -> i64 {
    var mask: i64 = 0;
    while !p.failed && at(p, TokKind::At) {
        var d: *Node = parse_decorator(p);
        if p.failed { ret 0; }
        if str_eq(d.text, "allow") == 1 && node_nkids(d) >= 1 {
            for var k: i64 = 0; k < node_nkids(d); k += 1 {
                var a: *Node = node_kid(d, k);
                var m: i64 = -1;
                if a.kind == NodeKind::Ident { m = lint_mask_of(a.text); }
                if m < 0 {
                    if p_fail_m(p, "E0207", "unknown lint in `@allow`", "no lint has this name", a.start, a.end) {
                        if a.kind == NodeKind::Ident { p.err_help = lint_unknown_help(a.text); }
                    }
                    ret 0;
                }
                mask = mask | m;
            }
        } else if p_fail_m(p, "E0207", "this decorator cannot be used on a statement", "not allowed here", d.a_start, d.a_end) {
            p.err_help = "only `@allow(unused)` and the like can be written in front of a local `var`";
        }
    }
    if !p.failed && !is_kw(p, 0, "var") && !is_kw(p, 0, "const") {
        var t: *Token = cur(p);
        if p_fail_m(p, "E0207", "`@allow(...)` must be followed by a `var` declaration", "expected `var`", t.start, t.end) {
            p.err_help = "write it in front of the variable: `@allow(unused) var x: i64 = 0;`";
        }
    }
    ret mask;
}

fn parse_statement(p: *Parser) -> *Node {
    var start: i64 = cur_start(p);
    var n: *Node = null;
    if at(p, TokKind::At) {
        var allow: i64 = parse_stmt_decorators(p);
        if p.failed { ret mk_none(); }
        var v: *Node = parse_statement(p);
        if v.kind == NodeKind::LocalVar { v.flags = v.flags | allow; }
        ret v;
    }
    if is_kw(p, 0, "unsafe") && at_off(p, 1, TokKind::LBrace) {
        advance(p);
        n = mk(NodeKind::BlockStmt, start, 0);
        n.flags = 1;
        parse_block_into(p, n);
    } else if at(p, TokKind::LBrace) {
        n = mk(NodeKind::BlockStmt, start, 0);
        parse_block_into(p, n);
    } else if is_kw(p, 0, "if") {
        n = mk(NodeKind::If, start, 0);
        parse_if(p, n);
    } else if is_kw(p, 0, "match") {
        n = mk(NodeKind::Match, start, 0);
        parse_match(p, n);
    } else if is_kw(p, 0, "while") {
        n = mk(NodeKind::While, start, 0);
        advance(p);
        node_add(n, with_struct_lit(p, false, 0));
        node_add(n, parse_block(p));
    } else if is_kw(p, 0, "for") {
        n = mk(NodeKind::For, start, 0);
        parse_for(p, n);
    } else if is_kw(p, 0, "break") || is_kw(p, 0, "continue") {
        if is_kw(p, 0, "break") { n = mk(NodeKind::Break, start, 0); } else { n = mk(NodeKind::Continue, start, 0); }
        advance(p);
        expect(p, TokKind::Semicolon);
    } else if is_kw(p, 0, "ret") {
        n = mk(NodeKind::Return, start, 0);
        advance(p);
        if !at(p, TokKind::Semicolon) { node_add(n, parse_expression(p)); } else { node_add(n, mk_none()); }
        expect(p, TokKind::Semicolon);
    } else if is_kw(p, 0, "var") || is_kw(p, 0, "const") {
        n = mk(NodeKind::LocalVar, start, 0);
        parse_var_decl_head(p, n, true);
        expect(p, TokKind::Semicolon);
    } else if is_kw(p, 0, "fn") || is_kw(p, 0, "struct") {
        var t: *Token = cur(p);
        var word: *u8 = "struct";
        if is_kw(p, 0, "fn") { word = "function"; }
        if p_fail_m(p, "E0203", cat2(word, " declarations are only allowed at the top level"),
            cat3("nested ", word, " declaration"), t.start, t.end) {
            p.err_help = "move the declaration out of the function body";
        }
        ret mk_none();
    } else {
        n = mk(NodeKind::ExprStmt, start, 0);
        node_add(n, parse_expression(p));
        expect(p, TokKind::Semicolon);
    }
    n.end = prev_end(p);
    ret n;
}

// ---- items ---------------------------------------------------------------------

fn parse_decorator(p: *Parser) -> *Node {
    var start: i64 = cur_start(p);
    expect(p, TokKind::At);
    var name: *Token = null;
    if is_kw(p, 0, "unsafe") {
        name = cur(p);      // `@trusted` is the one decorator named like a keyword
        advance(p);
    } else {
        name = expect_ident(p, "decorator name");
    }
    if name == null { ret mk_none(); }
    var n: *Node = mk_text(NodeKind::Decorator, start, 0, name.text);
    n.a_start = start;
    n.a_end = name.end;
    if at(p, TokKind::LParen) {
        advance(p);
        if !at(p, TokKind::RParen) {
            var args: *Node = with_struct_lit(p, true, 1);
            var count: i64 = node_nkids(args);
            for var i: i64 = 0; i < count; i += 1 { node_add(n, node_kid(args, i)); }
        }
        expect(p, TokKind::RParen);
    }
    n.end = prev_end(p);
    ret n;
}

// `<T, U>` after a declaration name: a `Generics` node with the names joined by commas.
fn parse_generic_params(p: *Parser) -> *Node {
    var names: *String = cast(*String) string_new(16);
    if at(p, TokKind::Lt) {
        advance(p);
        var first: bool = true;
        while !p.failed {
            var t: *Token = expect_ident(p, "a type parameter name");
            if t == null { break; }
            if !first { string_push_char(names, 44); }
            first = false;
            string_push_str(names, t.text);
            if at(p, TokKind::Comma) { advance(p); } else { break; }
        }
        expect_gt(p);
    }
    var g: *Node = mk(NodeKind::Generics, 0, 0);
    node_set_text(g, names.data, names.len);
    ret g;
}

// `(name: T, ..., ...)` as a `Params` node (text `...` when variadic).
fn parse_params(p: *Parser) -> *Node {
    var n: *Node = mk_text(NodeKind::Params, 0, 0, "");
    expect(p, TokKind::LParen);
    if !at(p, TokKind::RParen) {
        while !p.failed {
            if at(p, TokKind::Ellipsis) {
                advance(p);
                node_set_cstr(n, "...");
                break;
            }
            var name: *Token = expect_ident(p, "parameter name");
            if name == null { break; }
            expect(p, TokKind::Colon);
            var ty: *Node = parse_type(p);
            var par: *Node = mk_text(NodeKind::Param, name.start, ty.end, name.text);
            par.a_start = name.start;
            par.a_end = name.end;
            node_add(par, ty);
            node_add(n, par);
            if at(p, TokKind::Comma) { advance(p); } else { break; }
        }
    }
    expect(p, TokKind::RParen);
    ret n;
}

fn parse_fn_decl(p: *Parser, start: i64) -> *Node {
    advance(p); // fn
    var name: *Token = expect_ident(p, "function name");
    if name == null { ret mk_none(); }
    var n: *Node = mk_text(NodeKind::Fn, start, 0, name.text);
    n.a_start = name.start;
    n.a_end = name.end;
    node_add(n, parse_generic_params(p));
    node_add(n, parse_params(p));
    if at(p, TokKind::Arrow) {
        advance(p);
        node_add(n, parse_type(p));
    } else {
        node_add(n, mk_none());
    }
    var needs_semicolon: bool = true;
    if at(p, TokKind::FatArrow) {
        advance(p);
        var body: *Node = mk(NodeKind::ExprBody, 0, 0);
        node_add(body, parse_expression(p));
        node_add(n, body);
    } else if at(p, TokKind::LBrace) {
        var lb: i64 = cur_start(p);
        var body: *Node = mk(NodeKind::FnBlock, lb, 0);
        parse_block_into(p, body);
        body.end = prev_end(p);
        node_add(n, body);
        needs_semicolon = false;
    } else {
        node_add(n, mk_none());
    }
    if needs_semicolon {
        expect(p, TokKind::Semicolon);
    } else if at(p, TokKind::Semicolon) {
        advance(p);
    }
    n.end = prev_end(p);
    ret n;
}

fn parse_struct_decl(p: *Parser, start: i64) -> *Node {
    advance(p); // struct
    var name: *Token = expect_ident(p, "struct name");
    if name == null { ret mk_none(); }
    var n: *Node = mk_text(NodeKind::Struct, start, 0, name.text);
    n.a_start = name.start;
    n.a_end = name.end;
    node_add(n, parse_generic_params(p));
    var lb: *Token = cur(p);
    expect(p, TokKind::LBrace);
    while !p.failed && !at(p, TokKind::RBrace) {
        if at_eof(p) {
            unclosed_delimiter(p, lb.start, lb.end);
            ret n;
        }
        var f: *Token = expect_ident(p, "field name");
        if f == null { ret n; }
        expect(p, TokKind::Colon);
        var ty: *Node = parse_type(p);
        expect(p, TokKind::Semicolon);
        var fld: *Node = mk_text(NodeKind::Field, 0, 0, f.text);
        fld.a_start = f.start;
        fld.a_end = f.end;
        node_add(fld, ty);
        node_add(n, fld);
    }
    expect(p, TokKind::RBrace);
    if at(p, TokKind::Semicolon) { advance(p); }
    n.end = prev_end(p);
    ret n;
}

fn parse_enum_decl(p: *Parser, start: i64) -> *Node {
    advance(p); // enum
    var name: *Token = expect_ident(p, "enum name");
    if name == null { ret mk_none(); }
    var n: *Node = mk_text(NodeKind::Enum, start, 0, name.text);
    n.a_start = name.start;
    n.a_end = name.end;
    node_add(n, parse_generic_params(p));
    var lb: *Token = cur(p);
    expect(p, TokKind::LBrace);
    while !p.failed && !at(p, TokKind::RBrace) {
        if at_eof(p) {
            unclosed_delimiter(p, lb.start, lb.end);
            ret n;
        }
        var v: *Token = expect_ident(p, "variant name");
        if v == null { ret n; }
        var vn: *Node = mk_text(NodeKind::Variant, v.start, v.end, v.text);
        if at(p, TokKind::LParen) {
            advance(p);
            while !p.failed && !at(p, TokKind::RParen) {
                node_add(vn, parse_type(p));
                if at(p, TokKind::Comma) { advance(p); } else { break; }
            }
            expect(p, TokKind::RParen);
        }
        expect(p, TokKind::Semicolon);
        node_add(n, vn);
    }
    expect(p, TokKind::RBrace);
    if at(p, TokKind::Semicolon) { advance(p); }
    n.end = prev_end(p);
    ret n;
}

fn parse_global_var_decl(p: *Parser, start: i64) -> *Node {
    var n: *Node = mk(NodeKind::GlobalVar, start, 0);
    parse_var_decl_head(p, n, false);
    expect(p, TokKind::Semicolon);
    n.end = prev_end(p);
    ret n;
}

fn parse_binding_decl(p: *Parser) -> *Node {
    var start: i64 = cur_start(p);
    if is_kw(p, 0, "fn") { ret parse_fn_decl(p, start); }
    if is_kw(p, 0, "struct") { ret parse_struct_decl(p, start); }
    if is_kw(p, 0, "enum") { ret parse_enum_decl(p, start); }
    if is_kw(p, 0, "var") || is_kw(p, 0, "const") { ret parse_global_var_decl(p, start); }
    if error_expected(p, "`fn`, `struct`, `enum`, `var` or `const`", "E0203", false) {
        if at_eof(p) && p.pos > 0 {
            p.err_help = "decorators such as `@export` or `@import(...)` must be followed by a declaration";
        } else {
            p.err_note = "only function, struct and global variable declarations are allowed at the top level";
        }
    }
    ret mk_none();
}

fn parse_global_item(p: *Parser) -> *Node {
    var start: i64 = cur_start(p);
    var item: *Node = mk(NodeKind::Item, start, 0);
    item.file = p.file;
    while !p.failed && at(p, TokKind::At) { node_add(item, parse_decorator(p)); }
    node_add(item, parse_binding_decl(p));
    item.end = prev_end(p);
    ret item;
}

// Parses the whole token stream into a list of `Item` nodes (the kids of the
// returned `Types` node, which stands for the program).
fn parse_program(p: *Parser) -> *Node {
    var prog: *Node = mk(NodeKind::Types, 0, 0);
    while !p.failed && !at_eof(p) { node_add(prog, parse_global_item(p)); }
    ret prog;
}
