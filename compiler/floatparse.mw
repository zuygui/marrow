// Exact decimal -> `f64` conversion (round to nearest, ties to even), like Rust's
// `str::parse::<f64>`. The standard library's `parse_f64` is only exact for ordinary
// inputs; this starts from its result and corrects it by comparing the exact decimal
// value with the midpoints between neighbouring doubles, using the bignums of floatfmt.mw.

@import("floatfmt.mw")

fn fbig_add_small(a: *FBig, v: u32) {
    var carry: u64 = cast(u64) v;
    for var i: i64 = 0; carry != 0; i += 1 {
        if i >= a.n { a.d[i] = 0; a.n = i + 1; }
        var t: u64 = cast(u64) a.d[i] + carry;
        a.d[i] = cast(u32) (t & 4294967295);
        carry = t >> 32;
    }
}

fn fbig_mul_pow10(a: *FBig, e: i64) {
    var left: i64 = e;
    while left >= 9 {
        fbig_mul_small(a, 1000000000);
        left -= 9;
    }
    var m: u32 = 1;
    for var i: i64 = 0; i < left; i += 1 { m = m * 10; }
    if left > 0 { fbig_mul_small(a, m); }
}

// Compares D * 10^e10 with X * 2^s (X < 2^55): -1, 0 or 1.
fn cmp_dec_bin(d: *FBig, e10: i64, x: u64, s: i64) -> i64 {
    var l: *FBig = fbig_copy(d);
    if e10 > 0 { fbig_mul_pow10(l, e10); }
    if s < 0 { fbig_shl(l, -s); }
    var r: *FBig = fbig_from_u64(x);
    if e10 < 0 { fbig_mul_pow10(r, -e10); }
    if s > 0 { fbig_shl(r, s); }
    var c: i64 = fbig_cmp(l, r);
    fbig_free(l);
    fbig_free(r);
    ret c;
}

// `text` is an unsigned decimal literal already accepted by `parse_f64`.
fn parse_f64_exact(text: *u8, out: *f64) -> bool {
    var approx: f64 = 0.0;
    if !parse_f64(text, &approx) { ret false; }
    // significant digits (leading zeros skipped), at most 600 of them
    var d: *FBig = fbig_new();
    var nd: i64 = 0;
    var dropped: i64 = 0;
    var tail: bool = false;
    var frac: i64 = 0;
    var seen_dot: bool = false;
    var i: i64 = 0;
    while text[i] != 0 && text[i] != 101 && text[i] != 69 {
        var c: u8 = text[i];
        if c == 46 {
            seen_dot = true;
        } else if c >= 48 && c <= 57 {
            var dig: u32 = cast(u32) (c - 48);
            if nd == 0 && dig == 0 {
                if seen_dot { frac += 1; }
            } else if nd < 600 {
                fbig_mul_small(d, 10);
                fbig_add_small(d, dig);
                nd += 1;
                if seen_dot { frac += 1; }
            } else {
                if dig != 0 { tail = true; }
                if !seen_dot { dropped += 1; }
            }
        }
        i += 1;
    }
    var e10: i64 = dropped - frac;
    if text[i] != 0 {
        i += 1;
        var eneg: bool = false;
        if text[i] == 45 { eneg = true; i += 1; } else if text[i] == 43 { i += 1; }
        var e: i64 = 0;
        while text[i] >= 48 && text[i] <= 57 {
            if e < 100000 { e = e * 10 + cast(i64) (text[i] - 48); }
            i += 1;
        }
        if eneg { e = 0 - e; }
        e10 += e;
    }
    if tail {
        // a nonzero tail below the kept digits: stay strictly between the midpoints
        fbig_mul_small(d, 10);
        fbig_add_small(d, 1);
        e10 -= 1;
    }
    if d.n == 0 { out[0] = 0.0; fbig_free(d); ret true; }
    // beyond these the value is certainly infinite / zero
    if nd + e10 > 330 { out[0] = math_inf(); fbig_free(d); ret true; }
    if nd + e10 < -340 { out[0] = 0.0; fbig_free(d); ret true; }

    var bits: u64 = f64_to_bits(approx);
    var inf_bits: u64 = 9218868437227405312;
    if bits >= inf_bits { bits = inf_bits - 1; }
    var one: u64 = 1;
    var frac_mask: u64 = 4503599627370495;
    var hidden: u64 = 4503599627370496;
    for var iter: i64 = 0; iter < 64; iter += 1 {
        var bexp: i64 = cast(i64) (bits >> 52);
        var fr: u64 = bits & frac_mask;
        var m: u64 = fr;
        var q: i64 = -1074;
        if bexp != 0 { m = fr | hidden; q = bexp - 1075; }
        var odd: bool = (m & 1) == 1;
        // upper midpoint: (2m + 1) * 2^(q-1)
        var cu: i64 = cmp_dec_bin(d, e10, 2 * m + 1, q - 1);
        if cu > 0 || (cu == 0 && odd) {
            bits += 1;
            if bits >= inf_bits { bits = inf_bits; break; }
            continue;
        }
        if bits == 0 { break; }
        // lower midpoint: (2m - 1) * 2^(q-1), or (4m - 1) * 2^(q-2) just above a power of two
        var cl: i64 = 0;
        if fr == 0 && bexp > 1 { cl = cmp_dec_bin(d, e10, 4 * m - 1, q - 2); }
        else { cl = cmp_dec_bin(d, e10, 2 * m - 1, q - 1); }
        if cl < 0 || (cl == 0 && odd) {
            bits -= 1;
            continue;
        }
        break;
    }
    fbig_free(d);
    out[0] = f64_from_bits(bits);
    ret true;
}
