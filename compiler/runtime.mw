// ---------------------------------------------------------------------------
// Targets
// ---------------------------------------------------------------------------

// arch: 0 x86_64, 1 aarch64, 2 riscv64.   os: 0 linux, 1 macos, 2 windows.
struct Target {
    arch: i64;
    os: i64;
}

fn target_new(arch: i64, os: i64) -> *Target {
    var t: *Target = cast(*Target) alloc(sizeof(Target));
    t.arch = arch;
    t.os = os;
    ret t;
}

// The target this compiler was built for.
fn target_host() -> *Target { ret target_new(ARCH, OS); }

// Parses `<arch>-<os>`; null when malformed.
fn target_parse(s: *u8) -> *Target {
    var dash: i64 = -1;
    var n: i64 = str_len(s);
    for var i: i64 = 0; i < n; i += 1 {
        if s[i] == 45 { dash = i; break; }
    }
    if dash < 0 { ret null; }
    var a: *u8 = str_dup_n(s, dash);
    var o: *u8 = str_dup(s + dash + 1);
    var arch: i64 = -1;
    var os: i64 = -1;
    if str_is(a, "x86_64") || str_is(a, "amd64") { arch = 0; }
    else if str_is(a, "aarch64") || str_is(a, "arm64") { arch = 1; }
    else if str_is(a, "riscv64") || str_is(a, "rv64") { arch = 2; }
    if str_is(o, "linux") { os = 0; }
    else if str_is(o, "macos") || str_is(o, "darwin") { os = 1; }
    else if str_is(o, "windows") { os = 2; }
    if arch < 0 || os < 0 { ret null; }
    ret target_new(arch, os);
}

fn target_is_host(t: *Target) -> bool { ret t.arch == ARCH && t.os == OS; }

// Name used to select the platform tables, e.g. `linux_x86_64`.
fn target_dir_name(t: *Target) -> *u8 {
    var os: *u8 = "linux";
    if t.os == 1 { os = "macos"; }
    if t.os == 2 { os = "windows"; }
    var arch: *u8 = "x86_64";
    if t.arch == 1 { arch = "aarch64"; }
    if t.arch == 2 { arch = "riscv64"; }
    ret cat3(os, "_", arch);
}

// Value of QBE's `-t` option.
fn target_qbe_target(t: *Target) -> *u8 {
    if t.arch == 0 && t.os == 2 { ret "amd64_win"; }
    if t.arch == 0 && t.os == 1 { ret "amd64_apple"; }
    if t.arch == 0 { ret "amd64_sysv"; }
    if t.arch == 1 && t.os == 1 { ret "arm64_apple"; }
    if t.arch == 1 { ret "arm64"; }
    ret "rv64";
}

fn target_nostdlib_supported(t: *Target) -> bool {
    if t.os == 0 { ret true; }
    if t.os == 1 && (t.arch == 0 || t.arch == 1) { ret true; }
    if t.os == 2 && t.arch == 0 { ret true; }
    ret false;
}

fn target_freestanding_link(t: *Target) -> bool { ret t.os == 0; }


// QBE emits ELF flavoured assembly; COFF assemblers (Windows) reject `.type`, `.size`
// and the GNU-stack note.
fn target_adapt_asm(t: *Target, asm: *u8) -> *String {
    var out: *String = string_new(str_len(asm) + 16);
    if t.os != 2 {
        string_push_str(out, asm);
        ret out;
    }
    var n: i64 = str_len(asm);
    var pos: i64 = 0;
    while pos < n {
        var end: i64 = pos;
        while end < n && asm[end] != 10 { end += 1; }
        var line: *u8 = str_dup_n(asm + pos, end - pos);
        var k: i64 = 0;
        while line[k] == 32 || line[k] == 9 || line[k] == 13 { k += 1; }
        var t0: *u8 = line + k;
        var skip: bool = str_starts_with(t0, ".type ") || str_starts_with(t0, ".size ") || str_starts_with(t0, ".section .note.GNU-stack");
        if !skip {
            string_push_str(out, line);
            string_push_char(out, 10);
        }
        pos = end + 1;
    }
    ret out;
}

fn target_runtime_asm(t: *Target, nostdlib: bool) -> *u8 {
    var entry: *u8 = "";
    var stub: *u8 = "";
    var ctx: *u8 = "";
    if t.os == 0 && t.arch == 0 { entry = X86_64_LINUX; stub = X86_64_LINUX_SYSCALL; ctx = X86_64_CTX; }
    else if t.os == 0 && t.arch == 1 { entry = AARCH64_LINUX; stub = AARCH64_LINUX_SYSCALL; ctx = AARCH64_CTX; }
    else if t.os == 0 { entry = RISCV64_LINUX; stub = RISCV64_LINUX_SYSCALL; ctx = RISCV64_CTX; }
    else if t.os == 1 && t.arch == 0 { stub = X86_64_MACOS; ctx = X86_64_MACOS_CTX; }
    else if t.os == 1 { stub = AARCH64_MACOS; ctx = AARCH64_MACOS_CTX; }
    else { stub = X86_64_WINDOWS; ctx = X86_64_WINDOWS_CTX; }
    var out: *String = string_new(4096);
    if nostdlib { string_push_str(out, entry); }
    string_push_str(out, stub);
    string_push_str(out, ctx);
    ret out.data;
}
