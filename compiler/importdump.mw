// `importdump <file> <target>`: loads a file with its imports and prints the merged
// item order, in the format of `marrow --dump-imports`.

@import("../std/std.mw")
@import("import.mw")

fn file_name(ld: *Loader, id: i64) -> *u8 {
    var sf: *SourceFile = cast(*SourceFile) vec_ptr_get(ld.files, id);
    ret canon_path(sf.name);
}

@export fn main(argc: i32, argv: rawptr) -> i32 {
    env_init(argc, argv);
    if arg_count() < 3 {
        eprintln("usage: importdump <file> <target>");
        ret 2;
    }
    var entry: *u8 = arg_get(1);
    var ld: *Loader = loader_new(arg_get(2), path_dirname(entry));
    var lib: bool = false;
    var ok: bool = load_with_imports(ld, entry, &lib);
    for var i: i64 = 0; i < vec_ptr_len(ld.diags); i += 1 {
        var d: *Diag = cast(*Diag) vec_ptr_get(ld.diags, i);
        print("Error ");
        print(d.code);
        print(" ");
        if d.file < 0 { print("-"); } else { print(file_name(ld, d.file)); }
        print(" ");
        print_i64(d.start);
        print(" ");
        print_i64(d.end);
        print("\n");
    }
    if !ok || vec_ptr_len(ld.diags) > 0 { ret 1; }
    for var i: i64 = 0; i < vec_ptr_len(ld.items); i += 1 {
        var it: *Node = cast(*Node) vec_ptr_get(ld.items, i);
        print("Item ");
        print(file_name(ld, it.file));
        print(" ");
        print_i64(it.start);
        print(" ");
        print_i64(it.end);
        print("\n");
    }
    if lib { print("Library true\n"); } else { print("Library false\n"); }
    ret 0;
}
