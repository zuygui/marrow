// Module loading, written in Marrow. A port of src/import.rs.
//
// `load_with_imports` parses the entry file and, depth first, every file it
// `@import`s, and produces the flat list of items: the items of an imported
// file come before the item that carried the `@import`.

@import("parser.mw")
@import("resolve.mw")

struct SourceFile {
    name: *u8;
    src: *String;
}

// A label of a diagnostic: a span of a file with an optional text.
struct DLabel {
    file: i64;
    start: i64;
    end: i64;
    text: *u8;
    primary: bool;
}

// A `note:` or `help:` line.
struct DNote {
    help: bool;
    text: *u8;
}

// "replace [start, end) of the file by `repl`" (an empty span means insert).
struct DSug {
    msg: *u8;
    file: i64;
    start: i64;
    end: i64;
    repl: *u8;
}

// A diagnostic: code, message and primary span (`file` is -1 when it has none), plus
// everything the renderer needs. `labels` holds every label in the order the Rust
// compiler adds them; the primary one is created with the diagnostic, and
// `diag_primary_text` sets its text.
struct Diag {
    code: *u8;
    msg: *u8;
    file: i64;
    start: i64;
    end: i64;
    labels: *VecPtr;   // *DLabel
    notes: *VecPtr;    // *DNote
    sugs: *VecPtr;     // *DSug
    deny: i64;         // a lint whose level is `deny`: reported as an error
    hidden: i64;       // silenced by `@allow`
}

struct Loader {
    files: *VecPtr;    // *SourceFile, indexed by file id
    visited: *VecPtr;  // canonical paths already loaded
    items: *VecPtr;    // the merged program: *Node (Item)
    diags: *VecPtr;    // *Diag
    target: *u8;       // e.g. linux_x86_64
    entry_dir: *u8;
    marrow_dir: *u8;   // ~/.marrow, or null
    tried: *VecPtr;    // paths looked at by the last `resolve_import`
    mods: *VecPtr;     // *Module: the namespaces (flat ones too)
    fmods: *VecPtr;    // *FileMod, one per loaded file
    jobs: *VecPtr;     // *ResJob, name resolution to run after loading
    pending_root: *u8; // root directory for the next aliased load (packages)
    deps: *VecPtr;     // *DepEntry: packages importable by name (see pkg.mw)
}

@trusted fn loader_new(target: *u8, entry_dir: *u8) -> *Loader {
    var ld: *Loader = cast(*Loader) alloc(sizeof(Loader));
    mem_zero(cast(*u8) ld, sizeof(Loader));
    ld.files = cast(*VecPtr) vec_ptr_new(32);
    ld.visited = cast(*VecPtr) vec_ptr_new(32);
    ld.items = cast(*VecPtr) vec_ptr_new(256);
    ld.diags = cast(*VecPtr) vec_ptr_new(8);
    ld.mods = cast(*VecPtr) vec_ptr_new(32);
    ld.fmods = cast(*VecPtr) vec_ptr_new(32);
    ld.jobs = cast(*VecPtr) vec_ptr_new(32);
    ld.deps = PKG_DEPS;
    ld.target = target;
    ld.entry_dir = entry_dir;
    var home: *u8 = env_get("HOME");
    if home == null { home = env_get("USERPROFILE"); }
    if home != null { ld.marrow_dir = path_join(home, ".marrow"); }
    ret ld;
}

// Sets up the label / note lists of a fresh diagnostic with the primary label (when
// it has a span).
fn diag_init(d: *Diag) {
    d.labels = cast(*VecPtr) vec_ptr_new(2);
    d.notes = cast(*VecPtr) vec_ptr_new(2);
    d.sugs = cast(*VecPtr) vec_ptr_new(1);
    d.deny = 0;
    d.hidden = 0;
    if d.file >= 0 { diag_label(d, d.file, d.start, d.end, "", true); }
}

fn diag_label(d: *Diag, file: i64, start: i64, end: i64, text: *u8, primary: bool) {
    var l: *DLabel = cast(*DLabel) alloc(sizeof(DLabel));
    l.file = file;
    l.start = start;
    l.end = end;
    l.text = text;
    l.primary = primary;
    vec_ptr_push(d.labels, cast(rawptr) l);
}

// The text of the primary label.
fn diag_primary_text(d: *Diag, text: *u8) {
    for var i: i64 = 0; i < vec_ptr_len(d.labels); i += 1 {
        var l: *DLabel = cast(*DLabel) vec_ptr_get(d.labels, i);
        if l.primary { l.text = text; ret; }
    }
}

fn diag_secondary(d: *Diag, file: i64, start: i64, end: i64, text: *u8) {
    diag_label(d, file, start, end, text, false);
}

fn diag_note(d: *Diag, text: *u8) {
    var n: *DNote = cast(*DNote) alloc(sizeof(DNote));
    n.help = false;
    n.text = text;
    vec_ptr_push(d.notes, cast(rawptr) n);
}

fn diag_help(d: *Diag, text: *u8) {
    var n: *DNote = cast(*DNote) alloc(sizeof(DNote));
    n.help = true;
    n.text = text;
    vec_ptr_push(d.notes, cast(rawptr) n);
}

fn diag_suggest(d: *Diag, msg: *u8, file: i64, start: i64, end: i64, repl: *u8) {
    var g: *DSug = cast(*DSug) alloc(sizeof(DSug));
    g.msg = msg;
    g.file = file;
    g.start = start;
    g.end = end;
    g.repl = repl;
    vec_ptr_push(d.sugs, cast(rawptr) g);
}

// Chaining helpers: each returns `d` itself.
fn d_label(d: *Diag, text: *u8) -> *Diag { diag_primary_text(d, text); ret d; }
fn d_help(d: *Diag, text: *u8) -> *Diag { diag_help(d, text); ret d; }
fn d_note(d: *Diag, text: *u8) -> *Diag { diag_note(d, text); ret d; }
fn d_sec(d: *Diag, file: i64, start: i64, end: i64, text: *u8) -> *Diag { diag_secondary(d, file, start, end, text); ret d; }

fn ld_diag(ld: *Loader, code: *u8, msg: *u8, file: i64, start: i64, end: i64) -> *Diag {
    var d: *Diag = cast(*Diag) alloc(sizeof(Diag));
    d.code = code;
    d.msg = msg;
    d.file = file;
    d.start = start;
    d.end = end;
    diag_init(d);
    vec_ptr_push(ld.diags, cast(rawptr) d);
    ret d;
}

fn cannot_open(ld: *Loader, path: *u8, why: *u8, file: i64, start: i64, end: i64) {
    var d: *Diag = ld_diag(ld, "E0004", cat5("couldn't read `", path, "`: ", why, ""), file, start, end);
    if file >= 0 { diag_primary_text(d, "imported here"); }
}

@trusted fn ld_errors(ld: *Loader) -> i64 {
    var n: i64 = 0;
    for var i: i64 = 0; i < vec_ptr_len(ld.diags); i += 1 {
        var d: *Diag = cast(*Diag) vec_ptr_get(ld.diags, i);
        if d.code[0] != 87 { n += 1; }
    }
    ret n;
}

// An absolute, lexically normalized path (symlinks are not resolved).
fn canon_path(path: *u8) -> *u8 {
    if pk_is_abs(path) { ret path_normalize(path); }
    var cwd: *u8 = cwd_get();
    if cwd == null { ret path_normalize(path); }
    ret path_normalize(path_join(cwd, path));
}

// `s` with every `{target}` replaced by `target`.
@trusted fn expand_target(s: *u8, target: *u8) -> *u8 {
    var out: *String = cast(*String) string_new(str_len(s) + 16);
    var i: i64 = 0;
    var n: i64 = str_len(s);
    while i < n {
        if s[i] == 123 && str_starts_with(s + i, "{target}") {
            string_push_str(out, target);
            i += 8;
        } else {
            string_push_char(out, s[i]);
            i += 1;
        }
    }
    ret out.data;
}

fn has_mw_ext(s: *u8) -> bool { ret str_ends_with(s, ".mw") || str_ends_with(s, ".mrw"); }

// The dependency of the package that owns `carrier_dir` named `target` (a bare name such as
// `json`), or null.
@trusted fn find_dep(ld: *Loader, target: *u8, carrier_dir: *u8) -> *DepEntry {
    if ld.deps == null || vec_ptr_len(ld.deps) == 0 { ret null; }
    for var i: i64 = 0; target[i] != 0; i += 1 {
        if target[i] == 47 || target[i] == 92 || target[i] == 46 { ret null; }
    }
    var here: *u8 = canon_path(carrier_dir);
    var best: *DepEntry = null;
    for var i: i64 = 0; i < vec_ptr_len(ld.deps); i += 1 {
        var e: *DepEntry = cast(*DepEntry) vec_ptr_get(ld.deps, i);
        if str_eq(e.name, target) != 1 || !path_under(here, e.owner) { continue; }
        if e.dev && !PKG_DEV { continue; }
        if best == null || str_len(e.owner) > str_len(best.owner) { best = e; }
    }
    ret best;
}

// Looks for `target` in the importing file's directory, then the entry file's
// directory, then `~/.marrow/std`, `~/.marrow` and the `std` shipped next to the compiler. Returns null when not found.
fn resolve_import(ld: *Loader, target: *u8, carrier_dir: *u8) -> *u8 {
    ld.tried = cast(*VecPtr) vec_ptr_new(8);
    ld.pending_root = null;
    var dep: *DepEntry = find_dep(ld, target, carrier_dir);
    if dep != null {
        ld.pending_root = dep.root;
        ret dep.entry;
    }
    var bases: *VecPtr = cast(*VecPtr) vec_ptr_new(4);
    vec_ptr_push(bases, cast(rawptr) carrier_dir);
    if str_cmp(ld.entry_dir, carrier_dir) != 0 { vec_ptr_push(bases, cast(rawptr) ld.entry_dir); }
    if ld.marrow_dir != null {
        var std_dir: *u8 = path_join(ld.marrow_dir, "std");
        if path_is_dir(std_dir) { vec_ptr_push(bases, cast(rawptr) std_dir); }
        if path_is_dir(ld.marrow_dir) { vec_ptr_push(bases, cast(rawptr) ld.marrow_dir); }
    }
    // The `std` folder shipped next to the `marrow` binary (release archives).
    var sd: *u8 = self_dir();
    if sd != null {
        var shipped: *u8 = path_join(sd, "std");
        if path_is_dir(shipped) { vec_ptr_push(bases, cast(rawptr) shipped); vec_ptr_push(bases, cast(rawptr) sd); }
    }
    for var i: i64 = 0; i < vec_ptr_len(bases); i += 1 {
        var base: *u8 = cast(*u8) vec_ptr_get(bases, i);
        var direct: *u8 = path_join(base, target);
        if path_is_file(direct) { ret direct; }
        vec_ptr_push(ld.tried, cast(rawptr) direct);
        if !has_mw_ext(target) {
            var with_mw: *u8 = str_concat(direct, ".mw");
            if path_is_file(with_mw) { ret with_mw; }
            vec_ptr_push(ld.tried, cast(rawptr) with_mw);
            var with_mrw: *u8 = str_concat(direct, ".mrw");
            if path_is_file(with_mrw) { ret with_mrw; }
            vec_ptr_push(ld.tried, cast(rawptr) with_mrw);
        }
        if path_is_dir(direct) {
            var dn: *u8 = path_basename(direct);
            var umbrella_mw: *u8 = path_join(direct, str_concat(dn, ".mw"));
            if path_is_file(umbrella_mw) { ret umbrella_mw; }
            vec_ptr_push(ld.tried, cast(rawptr) umbrella_mw);
            var umbrella_mrw: *u8 = path_join(direct, str_concat(dn, ".mrw"));
            if path_is_file(umbrella_mrw) { ret umbrella_mrw; }
            vec_ptr_push(ld.tried, cast(rawptr) umbrella_mrw);
        }
    }
    ret null;
}

fn is_decorator_named(d: *Node, name: *u8) -> bool {
    ret d.kind == NodeKind::Decorator && str_eq(d.text, name) == 1;
}

fn mod_by_canon(ld: *Loader, canon: *u8) -> *Module {
    for var i: i64 = 0; i < vec_ptr_len(ld.fmods); i += 1 {
        var f: *FileMod = cast(*FileMod) vec_ptr_get(ld.fmods, i);
        if str_eq(f.canon, canon) == 1 { ret f.mod; }
    }
    ret null;
}

// `<alias>__`, or `<alias>_<n>__` when another module already took that prefix.
fn unique_prefix(ld: *Loader, alias: *u8) -> *u8 {
    var k: i64 = 1;
    while true {
        var cand: *u8 = cat2(alias, "__");
        if k > 1 { cand = cat4(alias, "_", i64_str(k), "__"); }
        var used: bool = false;
        for var i: i64 = 0; i < vec_ptr_len(ld.mods); i += 1 {
            var m: *Module = cast(*Module) vec_ptr_get(ld.mods, i);
            if str_eq(m.prefix, cand) == 1 { used = true; }
        }
        if !used { ret cand; }
        k += 1;
    }
}

// The alias of an `@import("path", alias)` decorator (a name or a string), or null.
fn import_alias(ld: *Loader, d: *Node, file_id: i64) -> *u8 {
    if node_nkids(d) < 2 { ret null; }
    var a: *Node = node_kid(d, 1);
    if a.kind != NodeKind::Ident && a.kind != NodeKind::Str {
        var e: *Diag = ld_diag(ld, "E0003", "the alias of an `@import` must be a name", file_id, a.start, a.end);
        diag_primary_text(e, "expected a name");
        diag_help(e, "write it like this: `@import(\"json.mw\", json)`");
        ret null;
    }
    ret a.text;
}

// Messages of the diagnostics produced by the name resolution of one file.
fn flush_res_errors(ld: *Loader, r: *Rs, file_id: i64) {
    for var i: i64 = 0; i < vec_ptr_len(r.errs); i += 1 {
        var e: *ResErr = cast(*ResErr) vec_ptr_get(r.errs, i);
        var d: *Diag = ld_diag(ld, e.code, e.msg, file_id, e.start, e.end);
        diag_primary_text(d, e.label);
        if e.help != null { diag_help(d, e.help); }
    }
}

// Whether `path` lies inside directory `dir` (both canonical).
@trusted fn path_under(path: *u8, dir: *u8) -> bool {
    var n: i64 = str_len(dir);
    if !str_starts_with(path, dir) { ret false; }
    ret n == 0 || path[n] == 47 || path[n] == 92 || dir[n - 1] == 47;
}

// `s` with each module prefix (`json__`) shown as the path the program wrote (`json::`).
@trusted fn demangle(ld: *Loader, s: *u8) -> *u8 {
    var cur: *u8 = s;
    for var i: i64 = 0; i < vec_ptr_len(ld.mods); i += 1 {
        var m: *Module = cast(*Module) vec_ptr_get(ld.mods, i);
        if m.alias == null || m.prefix[0] == 0 { continue; }
        var to: *u8 = cat2(m.alias, "::");
        var out: *String = cast(*String) string_new(str_len(cur) + 8);
        var j: i64 = 0;
        var n: i64 = str_len(cur);
        var pl: i64 = str_len(m.prefix);
        while j < n {
            // only at the start of an identifier
            var boundary: bool = j == 0 || !(res_ident_char(cur[j - 1]));
            if boundary && str_starts_with(cur + j, m.prefix) {
                string_push_str(out, to);
                j += pl;
            } else {
                string_push_char(out, cur[j]);
                j += 1;
            }
        }
        cur = out.data;
    }
    ret cur;
}

fn res_ident_char(c: u8) -> bool {
    ret (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

// Loads `path` and what it imports; returns the file's own items (empty when it
// was already loaded), or null when it could not be loaded. `at` is the
// `@import` decorator that asked for it (null for the entry file).
@trusted fn load_file(ld: *Loader, path: *u8, at: *Node, at_file: i64, alias: *u8, ns_in: *Module) -> *VecPtr {
    var imp_file: i64 = -1;
    var imp_start: i64 = 0;
    var imp_end: i64 = 0;
    if at != null {
        imp_file = at_file;
        imp_start = at.start;
        imp_end = at.end;
    }
    if !path_is_file(path) {
        var why: *u8 = "No such file or directory (os error 2)";
        if path_is_dir(path) { why = "Is a directory (os error 21)"; }
        cannot_open(ld, path, why, imp_file, imp_start, imp_end);
        ret null;
    }
    var canon: *u8 = canon_path(path);
    for var i: i64 = 0; i < vec_ptr_len(ld.visited); i += 1 {
        if str_eq(cast(*u8) vec_ptr_get(ld.visited, i), canon) == 1 { ret cast(*VecPtr) vec_ptr_new(1); }
    }
    vec_ptr_push(ld.visited, cast(rawptr) canon);

    var src: *String = cast(*String) read_to_string(path);
    if src == null {
        cannot_open(ld, path, "Permission denied (os error 13)", imp_file, imp_start, imp_end);
        ret null;
    }
    var file_id: i64 = vec_ptr_len(ld.files);
    var sf: *SourceFile = cast(*SourceFile) alloc(sizeof(SourceFile));
    sf.name = path;
    sf.src = src;
    vec_ptr_push(ld.files, cast(rawptr) sf);

    var lx: *Lexer = lexer_new(src.data, src.len);
    lex_all(lx);
    if lx.failed {
        var ed: *Diag = ld_diag(ld, lx.err_code, lx.err_msg, file_id, lx.err_start, lx.err_end);
        diag_primary_text(ed, lx.err_label);
        if lx.err_help != null { diag_help(ed, lx.err_help); }
        if lx.err_note != null { diag_note(ed, lx.err_note); }
        if lx.sug_msg != null { diag_suggest(ed, lx.sug_msg, file_id, lx.sug_start, lx.sug_end, lx.sug_text); }
        ret null;
    }
    var p: *Parser = parser_new(lx);
    p.file = file_id;
    var prog: *Node = parse_program(p);
    if p.failed {
        var pd: *Diag = ld_diag(ld, p.err_code, p.err_msg, file_id, p.err_start, p.err_end);
        diag_primary_text(pd, p.err_label);
        if p.sec_text != null { diag_secondary(pd, file_id, p.sec_start, p.sec_end, p.sec_text); }
        if p.err_help != null { diag_help(pd, p.err_help); }
        if p.err_note != null { diag_note(pd, p.err_note); }
        ret null;
    }

    var base_dir: *u8 = path_dirname(path);
    var own: *VecPtr = cast(*VecPtr) vec_ptr_new(16);
    var count: i64 = node_nkids(prog);

    var me: *Module = null;
    if alias != null {
        me = cast(*Module) alloc(sizeof(Module));
        mem_zero(cast(*u8) me, sizeof(Module));
        me.prefix = unique_prefix(ld, alias);
        me.alias = alias;
        me.root = ld.pending_root;
        if me.root == null { me.root = canon_path(base_dir); }
        ld.pending_root = null;
        vec_ptr_push(ld.mods, cast(rawptr) me);
    } else if ns_in != null {
        me = ns_in;
    } else {
        me = cast(*Module) alloc(sizeof(Module));
        mem_zero(cast(*u8) me, sizeof(Module));
        me.prefix = "";
        vec_ptr_push(ld.mods, cast(rawptr) me);
    }
    var fm: *FileMod = cast(*FileMod) alloc(sizeof(FileMod));
    fm.canon = canon;
    fm.mod = me;
    vec_ptr_push(ld.fmods, cast(rawptr) fm);
    var all_items: *VecPtr = cast(*VecPtr) vec_ptr_new(count + 1);
    for var k: i64 = 0; k < count; k += 1 { vec_ptr_push(all_items, cast(rawptr) node_kid(prog, k)); }
    res_module_collect(me, all_items);
    var rs: *Rs = cast(*Rs) alloc(sizeof(Rs));
    rs.aliases = cast(*VecPtr) vec_ptr_new(4);
    rs.errs = cast(*VecPtr) vec_ptr_new(2);
    rs.locals = cast(*VecPtr) vec_ptr_new(1);
    rs.own = null;
    if me.prefix[0] != 0 { rs.own = me; }
    for var k: i64 = 0; k < count; k += 1 {
        var item: *Node = node_kid(prog, k);
        var ndec: i64 = node_nkids(item) - 1;

        // First collect the targets (reporting malformed `@import`s), then load them.
        var targets: *VecPtr = cast(*VecPtr) vec_ptr_new(4);
        var decs: *VecPtr = cast(*VecPtr) vec_ptr_new(4);
        var import_aliases: *VecPtr = cast(*VecPtr) vec_ptr_new(4);
        for var j: i64 = 0; j < ndec; j += 1 {
            var d: *Node = node_kid(item, j);
            if !is_decorator_named(d, "import") { continue; }
            if node_nkids(d) != 1 && node_nkids(d) != 2 {
                var cd: *Diag = ld_diag(ld, "E0002", cat3("`@import` takes one or two arguments, but ", i64_str(node_nkids(d)), " were supplied"), file_id, d.start, d.end);
                diag_primary_text(cd, "expected the path of the file or library to import, and optionally an alias");
                diag_help(cd, "write it like this: `@import(\"std\")`");
                continue;
            }
            var arg: *Node = node_kid(d, 0);
            if arg.kind != NodeKind::Str {
                var sd: *Diag = ld_diag(ld, "E0003", "`@import` expects a string literal", file_id, arg.start, arg.end);
                diag_primary_text(sd, "expected a string literal");
                diag_help(sd, "write it like this: `@import(\"std\")`");
                continue;
            }
            vec_ptr_push(targets, cast(rawptr) expand_target(arg.text, ld.target));
            vec_ptr_push(decs, cast(rawptr) d);
            vec_ptr_push(import_aliases, cast(rawptr) import_alias(ld, d, file_id));
        }
        for var j: i64 = 0; j < vec_ptr_len(targets); j += 1 {
            var t: *u8 = cast(*u8) vec_ptr_get(targets, j);
            var d: *Node = cast(*Node) vec_ptr_get(decs, j);
            var resolved: *u8 = resolve_import(ld, t, base_dir);
            var imp_alias: *u8 = cast(*u8) vec_ptr_get(import_aliases, j);
            if resolved != null {
                // A flat import of a file inside an aliased module's directory joins that module.
                var child_ns: *Module = null;
                var rcanon: *u8 = canon_path(resolved);
                if imp_alias == null && me.prefix[0] != 0 && me.root != null && path_under(rcanon, me.root) { child_ns = me; }
                load_file(ld, resolved, d, file_id, imp_alias, child_ns);
                ld.pending_root = null;
                var tm: *Module = mod_by_canon(ld, rcanon);
                if tm != null {
                    if imp_alias != null {
                        if res_find_alias(rs, imp_alias) != null {
                            var dd: *Diag = ld_diag(ld, "E0005", cat3("the alias `", imp_alias, "` is already used in this file"), file_id, d.start, d.end);
                            diag_primary_text(dd, "duplicate alias");
                        } else {
                            var ae: *AliasEnt = cast(*AliasEnt) alloc(sizeof(AliasEnt));
                            ae.alias = imp_alias;
                            ae.mod = tm;
                            ae.s = d.start;
                            ae.e = d.end;
                            ae.used = 0;
                            vec_ptr_push(rs.aliases, cast(rawptr) ae);
                        }
                    } else if tm.prefix[0] != 0 && tm != me {
                        var fd: *Diag = ld_diag(ld, "E0005", cat3("`", t, "` is imported with an alias elsewhere, its items are not global"), file_id, d.start, d.end);
                        diag_primary_text(fd, "imported without an alias here");
                        diag_help(fd, cat5("import it as `@import(\"", t, "\", ", tm.alias, ")` and write `alias::name`"));
                    }
                }
            } else {
                var ud: *Diag = ld_diag(ld, "E0001", cat3("unresolved import `", t, "`"), file_id, d.start, d.end);
                diag_primary_text(ud, "no such file or library");
                var list: *String = cast(*String) string_new(128);
                string_push_str(list, "looked in these locations:");
                for var q: i64 = 0; q < vec_ptr_len(ld.tried); q += 1 {
                    string_push_str(list, "\n  - ");
                    string_push_str(list, cast(*u8) vec_ptr_get(ld.tried, q));
                }
                diag_note(ud, list.data);
                diag_help(ud, "paths are relative to the importing file, to the entry file, or to the `~/.marrow` directory");
            }
        }
        vec_ptr_push(ld.items, cast(rawptr) item);
        vec_ptr_push(own, cast(rawptr) item);
    }
    if rs.own != null || vec_ptr_len(rs.aliases) > 0 {
        var job: *ResJob = cast(*ResJob) alloc(sizeof(ResJob));
        job.items = own;
        job.rs = rs;
        job.file = file_id;
        vec_ptr_push(ld.jobs, cast(rawptr) job);
    }
    ret own;
}

// Loads the entry file and its imports. Returns false when anything failed;
// the diagnostics are in `ld.diags`. `*is_library` is set when the entry file
// has an item decorated `@no_main`.
@trusted fn load_with_imports(ld: *Loader, entry: *u8, is_library: *bool) -> bool {
    var errors_before: i64 = ld_errors(ld);
    var own: *VecPtr = load_file(ld, entry, null, -1, null, null);
    if own == null { ret false; }
    // Every file is loaded: resolve the module-qualified names.
    for var i: i64 = 0; i < vec_ptr_len(ld.jobs); i += 1 {
        var job: *ResJob = cast(*ResJob) vec_ptr_get(ld.jobs, i);
        res_rewrite_items(job.rs, job.items);
        flush_res_errors(ld, job.rs, job.file);
        for var q: i64 = 0; q < vec_ptr_len(job.rs.aliases); q += 1 {
            var ae2: *AliasEnt = cast(*AliasEnt) vec_ptr_get(job.rs.aliases, q);
            if ae2.used != 0 { continue; }
            var ui: *Diag = ld_diag(ld, "W0008", cat3("unused import ", bt(ae2.alias), ""), job.file, ae2.s, ae2.e);
            diag_primary_text(ui, cat3("nothing from ", bt(ae2.alias), " is used in this file"));
            diag_help(ui, "remove the `@import`, or use one of its items as `alias::name`");
        }
    }
    if ld_errors(ld) > errors_before { ret false; }
    *is_library = false;
    for var i: i64 = 0; i < vec_ptr_len(own); i += 1 {
        var item: *Node = cast(*Node) vec_ptr_get(own, i);
        var ndec: i64 = node_nkids(item) - 1;
        for var j: i64 = 0; j < ndec; j += 1 {
            if is_decorator_named(node_kid(item, j), "no_main") { *is_library = true; }
        }
    }
    ret true;
}
