// Test driver for floatfmt.mw: reads one 16-hex-digit f64 bit pattern per line from the
// file given as argument and prints each value the way Rust's `{}` does.

@import("floatfmt.mw")

@export fn main(argc: i32, argv: rawptr) -> i32 {
    env_init(argc, argv);
    var data: *u8 = read_to_string(arg_get(1)).data;
    var p: *u8 = data;
    while *p != 0 {
        var bits: u64 = 0;
        for var i: i64 = 0; i < 16; i += 1 {
            var c: u8 = p[i];
            var v: u64 = 0;
            if c >= 97 { v = cast(u64) (c - 87); } else { v = cast(u64) (c - 48); }
            bits = (bits << 4) | v;
        }
        p = p + 17;
        println(f64_shortest(f64_from_bits(bits)));
    }
    ret 0;
}
