---
// Custom Marrow landing page.
// This intentionally does NOT use Starlight's <Layout>, so it has full control
// over nav / hero / footer. It replicates Starlight's theme storage key
// ("starlight-theme") so the light/dark preference carries over seamlessly
// when a visitor clicks through into the docs.

import bench from "../data/benchmarks.json";

const stdlib = [
  { name: "io", desc: "Printing to stdout and stderr, no libc.", href: "/marrow/standard-library/io/" },
  { name: "mem", desc: "Allocation, copying and arenas.", href: "/marrow/standard-library/mem/" },
  { name: "string", desc: "C-strings and the growable String.", href: "/marrow/standard-library/string/" },
  { name: "vec", desc: "Growable arrays, owned and freed on scope exit.", href: "/marrow/standard-library/vec/" },
  { name: "map", desc: "Hash maps and linear maps.", href: "/marrow/standard-library/map/" },
  { name: "fs", desc: "Opening, reading and writing files.", href: "/marrow/standard-library/fs/" },
  { name: "http", desc: "HTTP and HTTPS, TLS included.", href: "/marrow/standard-library/http/" },
];

const pipeline = [
  { step: "Lexer", desc: "Source text → tokens" },
  { step: "Parser", desc: "Tokens → AST" },
  { step: "Imports", desc: "Flattens the module graph" },
  { step: "Check", desc: "Types, ownership, borrows" },
  { step: "Codegen", desc: "AST → QBE IL" },
  { step: "QBE + cc", desc: "IL → native binary" },
];

// ---- benchmark widget data (src/data/benchmarks.json, produced by benchmarks/run.py)
const verKey: Record<string, string> = { marrow: "marrow", "gcc-O0": "gcc", "gcc-O2": "gcc", "clang-O2": "clang", "rustc-O": "rustc", go: "go" };
const ver = (id: string) => {
  const m = (bench.meta.versions as Record<string, string>)[verKey[id]]?.match(/\d+\.\d+(\.\d+)?/);
  return m ? (id === "marrow" ? "v" + m[0] : m[0]) : "";
};
const metrics = [
  { id: "compile", key: "median_ms", title: "compile time", sub: "time to build an executable" },
  { id: "run", key: "run_median_ms", title: "run time", sub: "time to run the compiled program" },
];
const benchTabs = bench.programs.map((p) => ({ id: p.id, name: p.name }));
const benchPanels = metrics.flatMap((m) =>
  bench.programs.map((p) => {
    const vals = p.toolchains.map((t) => ({ ...t, v: (t as any)[m.key] as number }));
    const rows = [...vals].sort((a, b) => a.v - b.v);
    const top = Math.ceil(Math.max(...rows.map((r) => r.v)) / 50) * 50;
    const ticks = Array.from({ length: top / 50 + 1 }, (_, i) => i * 50);
    return {
      metric: m.id,
      id: p.id,
      label: p.label,
      title: m.title,
      sub: m.sub,
      ticks: ticks.map((t) => ({ t, pos: (t / top) * 100 })),
      rows: rows.map((r, i) => ({
        id: r.id,
        label: r.label,
        ver: ver(r.id),
        ms: r.v,
        value: Math.round(r.v),
        width: (r.v / top) * 100,
        fastest: i === 0,
        marrow: r.id === "marrow",
      })),
    };
  })
);
const benchMeta = bench.meta;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Marrow — a systems language, down to the marrow</title>
    <meta
      name="description"
      content="Marrow is a small, explicit systems programming language that compiles straight to native code through QBE. No garbage collector, no hidden runtime."
    />
    <link rel="icon" href="/banners/banner-dark.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Match Starlight's own storage key so the preference is shared
      // across this page and the generated docs pages.
      const stored = localStorage.getItem("starlight-theme");
      const theme =
        stored || (window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
      document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body>
    <div class="noise" aria-hidden="true"></div>

    <header class="nav" id="nav">
      <div class="nav-inner">
        <a href="/marrow/" class="brand">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 200 200" width="28" height="28">
              <defs>
                <linearGradient id="navcore" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#DDD6FE" />
                  <stop offset="50%" stop-color="#A78BFA" />
                  <stop offset="100%" stop-color="#7C3AED" />
                </linearGradient>
              </defs>
              <path
                d="M 100,20 C 145,20 175,45 175,90 C 175,145 135,180 100,180 C 60,180 25,145 25,90 C 25,45 55,20 100,20 Z"
                fill="none"
                stroke="url(#navcore)"
                stroke-width="6"
                stroke-dasharray="180 10 90 10"
              />
              <path
                d="M 100,45 C 130,45 150,70 150,105 C 150,140 125,155 100,155 C 75,155 50,140 50,105 C 50,70 70,45 100,45 Z"
                fill="url(#navcore)"
              />
              <circle cx="100" cy="95" r="16" fill="#FFFFFF" />
              <circle cx="100" cy="95" r="8" fill="#A78BFA" />
            </svg>
          </span>
          <span class="brand-word">Marrow</span>
        </a>

        <nav class="nav-links" aria-label="Primary">
          <a href="/marrow/getting-started/introduction/">Docs</a>
          <a href="/marrow/language/overview/">Language</a>
          <a href="/marrow/standard-library/overview/">Standard Library</a>
          <a href="/marrow/cli/overview/">CLI</a>
          <a href="/marrow/registry/">Packages</a>
          <a href="https://github.com/zuygui/marrow" target="_blank" rel="noopener">GitHub</a>
        </nav>

        <div class="nav-actions">
          <button class="theme-toggle" id="theme-toggle" aria-label="Toggle color theme">
            <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg>
          </button>
          <a class="btn btn-primary btn-small" href="/marrow/getting-started/introduction/">Get started</a>
          <button class="nav-burger" id="nav-burger" aria-label="Open menu" aria-expanded="false">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
      <div class="nav-mobile" id="nav-mobile">
        <a href="/marrow/getting-started/introduction/">Docs</a>
        <a href="/marrow/language/overview/">Language</a>
        <a href="/marrow/standard-library/overview/">Standard Library</a>
        <a href="/marrow/cli/overview/">CLI</a>
        <a href="/marrow/registry/">Packages</a>
        <a href="https://github.com/zuygui/marrow" target="_blank" rel="noopener">GitHub</a>
      </div>
    </header>

    <main>
      <!-- ============ HERO ============ -->
      <section class="hero">
        <div class="blob blob-a" aria-hidden="true"></div>
        <div class="blob blob-b" aria-hidden="true"></div>
        <div class="hero-inner">
          <div class="hero-copy reveal">
            <span class="eyebrow">v0.5.0 “Differentiation” · QBE-backed · self-hosted</span>
            <h1>Down to<br /><span class="grad-text">the marrow.</span></h1>
            <p class="lede">
              Marrow is a small, explicit systems language that compiles straight to native
              code through <a href="https://c9x.me/compile/" target="_blank" rel="noopener">QBE</a>.
              No garbage collector. No hidden runtime. Memory is owned and checked at
              compile time — if your program allocates, it's because you told it to.
            </p>
            <div class="cta-row">
              <a class="btn btn-primary" href="/marrow/getting-started/your-first-marrow-program/">Get started</a>
              <!-- APRÈS -->
                <a class="btn btn-ghost" href="https://github.com/zuygui/marrow" target="_blank" rel="noopener">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                </svg>
                View source
                </a>
            </div>
          </div>

          <div class="hero-visual reveal reveal-delay">
            <div class="window">
              <div class="window-bar">
                <span class="dot dot-r"></span><span class="dot dot-y"></span><span class="dot dot-g"></span>
                <span class="window-title">hello.mw</span>
              </div>
              <pre class="code"><code><span class="tok-dec">@import</span>(<span class="tok-str">"std/std.mw"</span>)

<span class="tok-dec">@export</span> <span class="tok-kw">fn</span> <span class="tok-fn">main</span>() &#123;
    <span class="tok-fn">println</span>(<span class="tok-str">"Hello from Marrow !"</span>);
&#125;</code></pre>
            </div>
            <div class="window window-term">
              <div class="window-bar">
                <span class="dot dot-r"></span><span class="dot dot-y"></span><span class="dot dot-g"></span>
                <span class="window-title">terminal</span>
              </div>
              <pre class="code term"><code><span class="tok-prompt">$</span> marrow hello.mw
Compilation successful! Executable created at: hello
<span class="tok-prompt">$</span> ./hello
<span class="tok-out">Hello from Marrow !</span></code></pre>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ FEATURES ============ -->
      <section class="section" id="features">
        <div class="section-inner">
          <span class="eyebrow eyebrow-center">Built for control</span>
          <h2 class="section-title">What you write is what runs.</h2>
          <div class="grid-4 reveal">
            <div class="card">
              <div class="card-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 3 8l9 5 9-5-9-5Z"/><path d="M3 16l9 5 9-5M3 12l9 5 9-5"/></svg>
              </div>
              <h3>No hidden runtime</h3>
              <p>No garbage collector, no implicit allocations, no hidden control flow. Every allocation traces back to a function you called.</p>
            </div>
            <div class="card">
              <div class="card-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 4 4 12l4 8M16 4l4 8-4 8"/></svg>
              </div>
              <h3>C-friendly, libc-free</h3>
              <p><code>@extern</code> calls any C function directly, yet the standard library itself needs no libc: it talks to the OS through a small platform layer.</p>
            </div>
            <div class="card">
              <div class="card-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
              </div>
              <h3>QBE-backed codegen</h3>
              <p>A small compiler, written in Marrow, emits textual QBE IL, then shells out to <code>qbe</code> and your system C compiler for real, native binaries.</p>
            </div>
            <div class="card">
              <div class="card-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="2.5" fill="currentColor" stroke="none"/></svg>
              </div>
              <h3>Ownership, no GC</h3>
              <p><code>^T</code> owns, <code>&amp;T</code> and <code>&amp;mut T</code> borrow. Moves, borrows and drops are checked at compile time; <code>unsafe</code> is explicit.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ PIPELINE ============ -->
      <section class="section section-tint" id="pipeline">
        <div class="section-inner">
          <span class="eyebrow eyebrow-center">From source to silicon</span>
          <h2 class="section-title">A short, readable compiler.</h2>
          <p class="section-lede">
            Six plain stages, each its own module — no macro-expansion phase, no hidden
            optimizer. Types, ownership and borrows are checked before a single line of IL is emitted.
          </p>
          <div class="pipeline reveal">
            {pipeline.map((p, i) => (
              <>
                <div class="pipe-node">
                  <span class="pipe-step">{p.step}</span>
                  <span class="pipe-desc">{p.desc}</span>
                </div>
                {i < pipeline.length - 1 && <span class="pipe-arrow" aria-hidden="true">→</span>}
              </>
            ))}
          </div>
          <a class="link-more" href="/marrow/getting-started/introduction/">Read about the pipeline in full →</a>
        </div>
      </section>

      <!-- ============ BENCHMARKS ============ -->
      <section class="section" id="benchmarks">
        <div class="section-inner">
          <span class="eyebrow eyebrow-center">Benchmarks</span>
          <h2 class="section-title">Quick to build. Measured honestly.</h2>
          <p class="section-lede">
            The same six programs written in Marrow, C, Rust and Go: how long each toolchain takes to build them, and how fast the result runs.
            Real numbers from <code>benchmarks/run.py</code> — including the ones where Marrow doesn't win.
          </p>

          <div class="bench reveal" id="bench">
            <div class="bench-metrics" role="tablist" aria-label="Measure">
              {metrics.map((m, i) => (
                <button class={"bench-metric" + (i === 0 ? " active" : "")} role="tab" aria-selected={i === 0 ? "true" : "false"} data-metric={m.id}>{m.id === "compile" ? "Compile time" : "Run time"}</button>
              ))}
            </div>
            <div class="bench-tabs" role="tablist" aria-label="Benchmark program">
              {benchTabs.map((t, i) => (
                <button class={"bench-tab" + (i === 0 ? " active" : "")} role="tab" aria-selected={i === 0 ? "true" : "false"} data-tab={t.id}>{t.name}</button>
              ))}
            </div>

            {benchPanels.map((t, i) => (
              <div class={"bench-panel" + (i === 0 ? " active" : "")} role="tabpanel" data-panel={t.metric + "-" + t.id}>
                <div class="bench-head">
                  <div>
                    <h3 class="bench-title">{t.label}</h3>
                    <p class="bench-sub">{t.title} · milliseconds, median of {t.metric === "compile" ? benchMeta.runs : 7} (lower is better)</p>
                  </div>
                  <button class="bench-replay" type="button" data-replay>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
                    replay in slow motion
                  </button>
                </div>

                <div class="bench-rows">
                  {t.rows.map((r, j) => (
                    <div class={"bench-row" + (r.marrow ? " is-marrow" : "")}>
                      <div class="bench-name">
                        <span class="bench-tool">{r.label}</span>
                        <span class="bench-ver">{r.ver}</span>
                      </div>
                      <div class="bench-track">
                        <div class="bench-bar" style={`--w:${r.width.toFixed(2)}%;--ms:${r.ms}`}>
                          {r.marrow && (
                            <svg class="bench-mark" viewBox="0 0 200 200" width="22" height="22" aria-hidden="true">
                              <path d="M 100,45 C 130,45 150,70 150,105 C 150,140 125,155 100,155 C 75,155 50,140 50,105 C 50,70 70,45 100,45 Z" fill="currentColor" />
                              <circle cx="100" cy="95" r="16" fill="#fff" />
                              <circle cx="100" cy="95" r="8" fill="#A78BFA" />
                            </svg>
                          )}
                        </div>
                      </div>
                      <div class="bench-value">
                        <strong>{r.value}</strong><span>ms</span>
                        {r.fastest && <em class="bench-tag">fastest</em>}
                      </div>
                    </div>
                  ))}
                </div>

                <div class="bench-axis" aria-hidden="true">
                  <div class="bench-axis-spacer"></div>
                  <div class="bench-axis-scale">
                    {t.ticks.map((k) => (<span style={`left:${k.pos.toFixed(2)}%`}>{k.t}</span>))}
                  </div>
                  <div class="bench-axis-spacer bench-axis-end"></div>
                </div>
              </div>
            ))}

            <div class="bench-foot">
              <p>
                {benchMeta.cpu.replace(/\(R\)/g, "").replace("Processor ", "")}, {benchMeta.cores} cores · one compiler invocation producing an executable ·
                Compile: 1 warm-up, median of {benchMeta.runs} runs, unique source each run so nothing is cached.
                Run: median of 7 executions of the compiled program.
              </p>
              <a class="bench-repro" href="https://github.com/zuygui/marrow/tree/main/benchmarks" target="_blank" rel="noopener">reproduce →</a>
            </div>
          </div>

          <p class="bench-note">
            Build: Marrow is about as fast as <code>gcc -O0</code>, quicker than <code>gcc -O2</code> and <code>clang -O2</code>, and about four times quicker than
            <code>rustc</code> and <code>go build</code>; most of its time is <code>qbe</code> and the system assembler and linker.
            Run: the code QBE emits beats <code>gcc -O0</code> and lands in the range of Go, behind optimizing compilers (small functions are inlined, but there are no loop optimizations yet).
            These are small programs on a 2-core VM: read the ratios, not the digits.
          </p>
        </div>
      </section>

      <!-- ============ STDLIB ============ -->
      <section class="section section-tint" id="stdlib">
        <div class="section-inner">
          <span class="eyebrow eyebrow-center">A standard library you can read</span>
          <h2 class="section-title">Batteries included. No libc underneath.</h2>
          <p class="section-lede">
            Every module is written in Marrow itself, on top of a small platform layer
            (Linux, macOS, Windows). From <code>io</code> to JSON and HTTPS, owned values free themselves.
          </p>
          <div class="grid-stdlib reveal">
            {stdlib.map((m) => (
              <a class="stdlib-card" href={m.href}>
                <span class="stdlib-name">{m.name}<span class="stdlib-ext">.mw</span></span>
                <span class="stdlib-desc">{m.desc}</span>
              </a>
            ))}
            <a class="stdlib-card stdlib-card-all" href="/marrow/standard-library/overview/">
              <span class="stdlib-name">Full reference</span>
              <span class="stdlib-desc">Every module, function and example →</span>
            </a>
          </div>
        </div>
      </section>

      <!-- ============ STATUS ============ -->
      <section class="section" id="status">
        <div class="section-inner">
          <span class="eyebrow eyebrow-center">Where things stand</span>
          <h2 class="section-title">Early, and honest about it.</h2>
          <p class="section-lede">
            Marrow compiles itself: the compiler is written in Marrow and bootstraps to a fixed point.
            The original Rust compiler lives on in the <code>v1</code> branch.
          </p>
          <div class="status-grid reveal">
            <div class="status-col">
              <h3 class="status-heading"><span class="status-dot status-dot-done"></span>Working today</h3>
              <ul class="status-list">
                <li>Self-hosted compiler, bootstrapping to a fixed point</li>
                <li>Ownership, moves, borrows and automatic drop</li>
                <li>Hook structs (<code>@drop</code>) as owning values, nested or not</li>
                <li>Methods (<code>impl</code>) and single inheritance</li>
                <li>Libc-free standard library: files, JSON, HTTPS and more</li>
                <li>Packages, tests, formatter, docs generator and language server</li>
                <li>Cross-compilation to Linux, macOS and Windows</li>
              </ul>
            </div>
            <div class="status-col">
              <h3 class="status-heading"><span class="status-dot status-dot-progress"></span>In progress</h3>
              <ul class="status-list">
                <li>Faster generated code (loop optimizations)</li>
                <li>Faster, more incremental builds</li>
                <li>Growing the standard library</li>
                <li>Windows install tooling</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ INSTALL CTA ============ -->
      <section class="section" id="install">
        <div class="section-inner">
          <div class="install-panel reveal">
            <div class="install-copy">
              <h2 class="section-title install-title">One command away.</h2>
              <p>Installs the <code>marrow</code> and <code>qbe</code> binaries, plus the standard library, to <code>~/.marrow</code>.</p>
            </div>
            <div class="install-box">
              <code id="install-cmd">curl -fsSL https://raw.githubusercontent.com/zuygui/marrow/main/install.sh | sh</code>
              <button class="copy-btn" id="copy-btn" aria-label="Copy install command">
                <svg class="icon-copy" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg>
                <svg class="icon-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              </button>
            </div>
            <a class="link-more" href="/marrow/getting-started/installation/">macOS, Windows &amp; building from source →</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-top">
          <a href="/marrow/" class="brand footer-brand">
            <span class="brand-mark" aria-hidden="true">
              <svg viewBox="0 0 200 200" width="26" height="26">
                <defs>
                  <linearGradient id="footcore" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#DDD6FE" />
                    <stop offset="100%" stop-color="#7C3AED" />
                  </linearGradient>
                </defs>
