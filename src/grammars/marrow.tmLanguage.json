{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "marrow",
  "scopeName": "source.marrow",
  "fileTypes": ["mw", "marrow"],
  "aliases": ["mw"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#function-def" },
    { "include": "#struct-def" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.marrow",
          "match": "//.*$"
        },
        {
          "name": "comment.block.marrow",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.marrow",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.marrow",
              "match": "\\\\(n|t|r|0|\\\\|\"|')"
            },
            {
              "name": "invalid.illegal.unknown-escape.marrow",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.marrow",
          "match": "'(\\\\(n|t|r|0|\\\\|'|\")|[^'\\\\])'"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.marrow",
          "begin": "(@)([a-zA-Z_][a-zA-Z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.attribute.marrow" },
            "2": { "name": "entity.name.tag.attribute.marrow" }
          },
          "end": "(?<=\\))|(?=[^(\\s])",
          "patterns": [
            {
              "begin": "\\(",
              "end": "\\)",
              "beginCaptures": { "0": { "name": "punctuation.brackets.round.marrow" } },
              "endCaptures": { "0": { "name": "punctuation.brackets.round.marrow" } },
              "patterns": [
                { "include": "#comments" },
                { "include": "#strings" },
                { "include": "#chars" },
                { "include": "#keywords" },
                { "include": "#builtins" },
                { "include": "#constants" },
                { "include": "#numbers" },
                { "include": "#operators" },
                { "include": "#punctuation" }
              ]
            }
          ]
        }
      ]
    },
    "function-def": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.fn.marrow" },
            "2": { "name": "entity.name.function.marrow" }
          }
        }
      ]
    },
    "struct-def": {
      "patterns": [
        {
          "match": "\\b(struct)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.struct.marrow" },
            "2": { "name": "entity.name.type.struct.marrow" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.marrow",
          "match": "\\b(if|else|while|for|ret)\\b"
        },
        {
          "name": "keyword.other.marrow",
          "match": "\\b(fn|struct|var)\\b"
        },
        {
          "name": "keyword.operator.cast.marrow",
          "match": "\\bcast\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.marrow",
          "match": "\\b(va_start|va_arg|va_end)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.pointer.marrow",
          "match": "\\*"
        },
        {
          "name": "storage.type.marrow",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|rawptr|void)\\b"
        },
        {
          "name": "support.type.marrow",
          "match": "(?<=:\\s*\\*?)\\b[A-Z][a-zA-Z0-9_]*\\b|(?<=->\\s*\\*?)\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.marrow",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.marrow",
          "match": "\\bnull\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.marrow",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.marrow",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.marrow",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.marrow",
          "match": "(::|->|=>|==|!=|<=|>=|&&|\\|\\||\\+=|-=|\\*=|/=|\\.\\.\\.|\\.\\.|[+\\-*/%=<>!&])"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.marrow",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.marrow",
          "match": ","
        },
        {
          "name": "punctuation.accessor.marrow",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.colon.marrow",
          "match": ":"
        },
        {
          "name": "punctuation.brackets.round.marrow",
          "match": "[()]"
        },
        {
          "name": "punctuation.brackets.curly.marrow",
          "match": "[{}]"
        },
        {
          "name": "punctuation.brackets.square.marrow",
          "match": "[\\[\\]]"
        }
      ]
    }
  }
}