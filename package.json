{
  "name": "marrow-vscode",
  "displayName": "Marrow Programming Language",
  "description": "Syntax highlighting, diagnostics and formatting for Marrow (through `marrow lsp`)",
  "publisher": "zuygui",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/zuygui/marrow"
  },
  "author": {
    "name": "Zuygui",
    "email": "zuygui.dev@gmail.com",
    "url": "https://github.com/zuygui"
  },
  "version": "0.1.0",
  "main": "./extension.js",
  "activationEvents": ["onLanguage:marrow"],
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "configuration": {
      "title": "Marrow",
      "properties": {
        "marrow.path": {
          "type": "string",
          "default": "marrow",
          "description": "Path of the marrow binary used for the language server (diagnostics and formatting)."
        }
      }
    },
    "languages": [
      {
        "id": "marrow",
        "aliases": ["Marrow", "marrow"],
        "extensions": [".mw"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "marrow",
        "scopeName": "source.marrow",
        "path": "./syntaxes/marrow.tmLanguage.json"
      }
    ]
  }
}
